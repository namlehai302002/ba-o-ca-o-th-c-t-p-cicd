{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
"ConnectionStrings": {
  "DefaultConnection": "${DefaultConnection}"
},

"GroqApiKey": "",
"GeminiApiKey": "",

"DevResetToken": "${DevResetToken}",

"Auth": {
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "User": "${SmtpUser}",
    "Pass": "${SmtpPassword}",
    "From": "${SmtpUser}",
    "UseSsl": true,
    "DisplayName": "Hệ Thống Captcha WMS"
  },
  "AllowPublicRegistration": false
},
  "Api": {
    "Key": "${ApiKey}"
  },
  "MheIntegration": {
    "Enabled": false
  },
  "OpenTelemetry": {
    "ServiceName": "WMS-Enterprise",
    "OtlpEndpoint": "${OtlpEndpoint}"
  },
  "ReverseProxy": {
    "KnownProxies": []
  },
  "InventoryConsistency": {
    "OutboxIntervalSeconds": 30,
    "OutboxBatchSize": 100,
    "ReconciliationIntervalMinutes": 10,
    "ReconciliationToleranceQty": 0.0001
  },
  "ReplenishmentAutomation": {
    "Enabled": true,
    "AutoCreateTasks": true,
    "IntervalSeconds": 300,
    "BatchSize": 100,
    "MaxTasksPerRun": 50,
    "DemandHorizonDays": 3,
    "ForecastHistoryDays": 30,
    "ForecastHorizonDays": 2,
    "ForecastSafetyFactor": 1.15,
    "MinimumSuggestedQty": 0.0001
  },
  "WarehouseDefaults": {
    "HsdThresholdDays": 30,
    "PickTaskDueHours": 24,
    "DockArrivalWindowHours": 8
  },
  "AnalyticsGovernance": {
    "PredictiveAlertHorizonDays": 7,
    "AuditLookbackDays": 14,
    "AssistantMaxCitations": 5,
    "AssistantAllowMutation": false
  },
  "RoleWorkspace": {
    "EnableRoleHomeCards": true,
    "EnableWorkflowProfiles": true,
    "DefaultViewerReadOnly": true
  },
  "ProductionSre": {
    "TelemetrySamplingPercent": 100,
    "DashboardPeriodMinutes": 15,
    "TelemetryRetentionDays": 30,
    "BusinessHourStart": 6,
    "BusinessHourEnd": 22,
    "LatencyWarningMs": 1500,
    "ErrorRateWarningPercent": 1.0
  },
  "LocalVerification": {
    "Enabled": true,
    "SeedAdmin": true,
    "UserName": "visual.admin",
    "Password": "LocalVisualAdmin@2026!",
    "Email": "visual.admin@local.test",
    "FullName": "Local Verification Admin",
    "BypassMfaForLoopback": true
  }
}