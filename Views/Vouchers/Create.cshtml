@model WMS.ViewModels.VoucherCreateViewModel
@{
    string typeName = Model.VoucherType switch {
        WMS.Models.VoucherTypeEnum.NhapKho => "Nhập kho",
        WMS.Models.VoucherTypeEnum.XuatKho => "Xuất kho",
        WMS.Models.VoucherTypeEnum.TraNCC => "Trả nhà cung cấp",
        WMS.Models.VoucherTypeEnum.KhachTra => "Khách trả",
        WMS.Models.VoucherTypeEnum.DieuChinh => "Điều chỉnh",
        WMS.Models.VoucherTypeEnum.ChuyenKho => "Chuyển kho",
        WMS.Models.VoucherTypeEnum.NhapThanhPham => "Nhập thành phẩm",
        WMS.Models.VoucherTypeEnum.XuatSanXuat => "Xuất sản xuất",
        _ => ""
    };
    ViewData["Title"] = $"Tạo phiếu {typeName}";
    var canSeeFinancial = (bool)(ViewBag.CanSeeFinancial ?? false);
    var isInbound = Model.VoucherType is WMS.Models.VoucherTypeEnum.NhapKho or WMS.Models.VoucherTypeEnum.KhachTra or WMS.Models.VoucherTypeEnum.NhapThanhPham;
    var selectedOwnershipMode = Model.OwnerPartnerId.HasValue || string.Equals(Model.InventoryOwnershipMode, "ThreePl", StringComparison.OrdinalIgnoreCase) ? "ThreePl" : "Internal";
    var hasThreePlOwners = Model.OwnerPartners.Any();
    var itemAllowedSourceUomsJson = (string?)(ViewBag.ItemAllowedSourceUomsJson ?? "{}") ?? "{}";
    var partnerLabel = Model.VoucherType switch
    {
        WMS.Models.VoucherTypeEnum.NhapKho => "Nhà cung cấp / nguồn giao *",
        WMS.Models.VoucherTypeEnum.XuatKho => "Khách hàng / nơi nhận *",
        WMS.Models.VoucherTypeEnum.TraNCC => "Nhà cung cấp nhận trả *",
        WMS.Models.VoucherTypeEnum.KhachTra => "Khách hàng trả hàng *",
        _ => "Đối tác liên quan *"
    };
    var partnerEmptyText = Model.VoucherType switch
    {
        WMS.Models.VoucherTypeEnum.NhapKho => "-- Chọn nhà cung cấp / nguồn giao --",
        WMS.Models.VoucherTypeEnum.XuatKho => "-- Chọn khách hàng / nơi nhận --",
        WMS.Models.VoucherTypeEnum.TraNCC => "-- Chọn nhà cung cấp nhận trả --",
        WMS.Models.VoucherTypeEnum.KhachTra => "-- Chọn khách hàng trả hàng --",
        _ => "-- Chọn đối tác --"
    };
    var partnerRequiredMessage = $"Vui lòng chọn {partnerLabel.Replace(" *", "").ToLowerInvariant()} trước khi lưu phiếu.";
    var warehouseLabel = Model.VoucherType switch
    {
        WMS.Models.VoucherTypeEnum.XuatKho or WMS.Models.VoucherTypeEnum.TraNCC or WMS.Models.VoucherTypeEnum.XuatSanXuat => "Kho xuất *",
        WMS.Models.VoucherTypeEnum.ChuyenKho => "Kho nguồn *",
        WMS.Models.VoucherTypeEnum.DieuChinh => "Kho điều chỉnh *",
        _ => "Kho nhận *"
    };

    string DisplayPartnerName(WMS.Models.Partner partner)
    {
        var threePlPrefix = "3PL ";
        return partner.PartnerName
            .Trim()
            .Replace("Chủ hàng " + threePlPrefix, "", StringComparison.OrdinalIgnoreCase)
            .Replace("Chu " + "hang " + threePlPrefix, "", StringComparison.OrdinalIgnoreCase)
            .Replace("Chu ", "Chủ ", StringComparison.OrdinalIgnoreCase)
            .Replace(" hang", " hàng", StringComparison.OrdinalIgnoreCase);
    }
}

<div class="page-header">
    <div>
        <h1 class="page-title">Tạo phiếu @typeName</h1>
        <p class="page-subtitle">Khai báo đầy đủ thông tin để hệ thống ghi nhận chính xác và dễ đối soát sau này.</p>
    </div>
    <a asp-controller="Vouchers" asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Quay lại danh sách</a>
</div>

<div class="user-guide">
    <div class="user-guide-title"><i class="fas fa-circle-info"></i> Hướng dẫn nhanh trước khi tạo phiếu</div>
    <div class="step-list">
        <span class="step-chip"><i class="fas fa-building"></i> 1) Chọn đúng kho và đối tác liên quan</span>
        <span class="step-chip"><i class="fas fa-box"></i> 2) Chọn vật tư, nhập số lượng và đơn vị phù hợp với vật tư đó</span>
        @if (isInbound)
        {
            <span class="step-chip"><i class="fas fa-truck"></i> 3) Khai báo lịch xe đến và khung giờ nhận hàng nếu có</span>
            <span class="step-chip"><i class="fas fa-save"></i> 4) Chọn "Lưu tạm" để bổ sung sau hoặc "Lưu và gửi duyệt" để gửi quản lý</span>
        }
        else
        {
            <span class="step-chip"><i class="fas fa-save"></i> 3) Kiểm tra lại dữ liệu rồi bấm "Hoàn tất và lưu phiếu"</span>
        }
    </div>
</div>
@if (Model.VoucherType == WMS.Models.VoucherTypeEnum.ChuyenKho)
{
    <div class="user-guide transfer-guide">
        <div class="user-guide-title"><i class="fas fa-lightbulb"></i> Cách hiểu nhanh phiếu chuyển kho</div>
        <div class="transfer-guide-text">
            <b>Số lượng thực chuyển</b> = <b>Số lượng xuất</b> x <b>Quy đổi ra đơn vị tồn kho</b>.
            Ví dụ: xuất 2 Bộ, quy đổi 10 Cái/Bộ thì hệ thống sẽ chuyển tồn 20 Cái.
        </div>
    </div>
}

<form asp-controller="Vouchers" asp-action="Create" method="post" id="voucherForm" novalidate data-no-submit-loading="true">
    @Html.AntiForgeryToken()
    <input type="hidden" name="VoucherType" value="@Model.VoucherType" />
    <input type="hidden" name="ParentVoucherId" value="@Model.ParentVoucherId" />
    <input type="hidden" name="AiOcrLogId" id="AiOcrLogId" value="@Model.AiOcrLogId" />
    <div asp-validation-summary="All" class="alert alert-danger validation-summary-enterprise" id="validationSummary"></div>

    @if (Model.VoucherType == WMS.Models.VoucherTypeEnum.XuatKho)
    {
        <input type="hidden" name="ExportMode" id="ExportMode" value="1" />
    }

    <div class="card mb-3">
        <div class="card-header"><span class="card-title">Thông tin chung</span></div>
        <div class="card-body">
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Ngày Chứng Từ</label>
                    <input type="date" name="VoucherDate" class="form-control"
                           value="@((Model.VoucherDate ?? WMS.Common.VietnamTime.Today).ToString("yyyy-MM-dd"))" />
                </div>
                @if(Model.VoucherType == WMS.Models.VoucherTypeEnum.XuatKho)
                {
                    <div class="form-group">
                        <label class="form-label">Loại xuất</label>
                        <select id="exportModeSelect" class="form-control" data-wms-change-call="setExportMode" data-wms-change-value="true">
                            <option value="1" selected>Xuất nội bộ</option>
                            <option value="2">Xuất bán / ra ngoài</option>
                        </select>
                    </div>
                }
                <div class="form-group">
                    <label class="form-label" for="WarehouseId">@warehouseLabel</label>
                    <select name="WarehouseId" id="WarehouseId" class="form-control" required
                            data-wms-change-call="warehouseChanged"
                            data-wms-clear-validity="true"
                            data-wms-invalid-message="Vui lòng chọn kho.">
                        <option value="">-- Chọn kho --</option>
                        @foreach (var w in Model.Warehouses.Where(x => x.IsActive))
                        {
                            <option value="@w.WarehouseId" selected="@(w.WarehouseId == Model.WarehouseId ? "selected" : null)">
                                [@w.WarehouseCode] @w.WarehouseName
                            </option>
                        }
                    </select>
                </div>
                @if(Model.VoucherType == WMS.Models.VoucherTypeEnum.ChuyenKho)
                {
                    <div class="form-group">
                        <label class="form-label">Kho Đích *</label>
                        <select name="DestWarehouseId" class="form-control" required
                                data-wms-invalid-message="Vui lòng chọn kho đích."
                                data-wms-clear-validity="true">
                            <option value="">-- Chọn kho đích --</option>
                            @foreach (var w in Model.Warehouses.Where(x => x.IsActive))
                            {
                                <option value="@w.WarehouseId" selected="@(w.WarehouseId == Model.DestWarehouseId ? "selected" : null)">
                                    [@w.WarehouseCode] @w.WarehouseName
                                </option>
                            }
                        </select>
                    </div>
                }
                
                @if(Model.VoucherType is WMS.Models.VoucherTypeEnum.NhapKho or WMS.Models.VoucherTypeEnum.XuatKho or WMS.Models.VoucherTypeEnum.TraNCC or WMS.Models.VoucherTypeEnum.KhachTra)
                {
                    <div class="form-group" id="partnerFieldDiv">
                        <label class="form-label" asp-for="PartnerId">@partnerLabel</label>
                        <select name="PartnerId" class="form-control partner-select-validate">
                            <option value="">@partnerEmptyText</option>
                            @foreach(var p in Model.Partners) { 
                                <option value="@p.PartnerId" selected="@(p.PartnerId == Model.PartnerId ? "selected" : null)">
                                    [@p.PartnerCode] @DisplayPartnerName(p)
                                </option> 
                            }
                        </select>
                    </div>
                }
                @if (hasThreePlOwners)
                {
                    <div class="form-group voucher-ownership-mode">
                        <label class="form-label">Loại sở hữu hàng</label>
                        <div class="segmented-control ownership-mode-toggle" data-ownership-toggle>
                            <label class="segmented-option">
                                <input type="radio" name="InventoryOwnershipMode" value="Internal" checked="@(selectedOwnershipMode == "Internal")" />
                                <span><i class="fas fa-warehouse"></i> Nội bộ</span>
                            </label>
                            <label class="segmented-option">
                                <input type="radio" name="InventoryOwnershipMode" value="ThreePl" checked="@(selectedOwnershipMode == "ThreePl")" />
                                <span><i class="fas fa-layer-group"></i> Khách hàng thuê kho</span>
                            </label>
                        </div>
                    </div>
                    <div class="form-group" id="ownerPartnerFieldDiv" data-threepl-owner-field hidden="@(selectedOwnershipMode != "ThreePl")">
                        <label class="form-label">Chủ hàng</label>
                        <select name="OwnerPartnerId" id="OwnerPartnerId" class="form-control" disabled="@(selectedOwnershipMode != "ThreePl")">
                            <option value="">-- Chọn chủ hàng --</option>
                            @foreach (var owner in Model.OwnerPartners)
                            {
                                <option value="@owner.PartnerId" selected="@(owner.PartnerId == Model.OwnerPartnerId ? "selected" : null)">
                                    [@owner.PartnerCode] @DisplayPartnerName(owner)
                                </option>
                            }
                        </select>
                    </div>
                }
                else
                {
                    <input type="hidden" name="InventoryOwnershipMode" value="Internal" />
                }
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Số Chứng Từ Gốc</label>
                    <input type="text" name="ReferenceNo" class="form-control" placeholder="VD: INVOICE-123" value="@Model.ReferenceNo" />
                </div>
                <div class="form-group form-span-2">
                    <label class="form-label">Diễn giải / Ghi chú</label>
                    <input type="text" name="Description" class="form-control" placeholder="Mục đích nhập/xuất" value="@Model.Description" />
                </div>
                @if (Model.VoucherType is WMS.Models.VoucherTypeEnum.XuatKho or WMS.Models.VoucherTypeEnum.TraNCC or WMS.Models.VoucherTypeEnum.ChuyenKho or WMS.Models.VoucherTypeEnum.XuatSanXuat)
                {
                    <div class="form-group">
                        <label class="form-label">Ngày cần hàng theo cam kết</label>
                        <input type="date" name="RequestedDeliveryDate" class="form-control" 
                               value="@(Model.RequestedDeliveryDate?.ToString("yyyy-MM-dd"))" 
                               title="Ngày KH / bộ phận cần nhận hàng — hệ thống sẽ cảnh báo nếu trễ hạn" />
                    </div>
                }
            </div>
            @if (isInbound)
            {
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Giờ xe đến dự kiến *</label>
                        <input type="datetime-local" name="ExpectedArrivalAt" class="form-control"
                               value="@(Model.ExpectedArrivalAt?.ToString("yyyy-MM-ddTHH:mm"))"
                               title="Thời điểm xe hoặc nhà cung cấp dự kiến đến kho" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Giờ bắt đầu khung nhận hàng</label>
                        <input type="datetime-local" name="DockAppointmentStart" class="form-control"
                               value="@(Model.DockAppointmentStart?.ToString("yyyy-MM-ddTHH:mm"))"
                               title="Khung giờ bắt đầu tiếp nhận và bốc dỡ hàng tại cửa kho" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Giờ kết thúc khung nhận hàng</label>
                        <input type="datetime-local" name="DockAppointmentEnd" class="form-control"
                               value="@(Model.DockAppointmentEnd?.ToString("yyyy-MM-ddTHH:mm"))"
                               title="Khung giờ dự kiến hoàn tất bốc dỡ tại cửa kho" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Cửa nhận hàng ưu tiên</label>
                        <input type="text" name="DockDoor" class="form-control" maxlength="20"
                               placeholder="VD: Cửa 1, Cửa A — để trống nếu chưa biết"
                               value="@Model.DockDoor" />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Đơn vị vận chuyển</label>
                        <input type="text" name="CarrierName" class="form-control" maxlength="100"
                               placeholder="VD: Xe nội bộ / NCC / đơn vị vận tải"
                               value="@Model.CarrierName" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Biển số xe</label>
                        <input type="text" name="VehicleNumber" class="form-control" maxlength="30"
                               placeholder="VD: 51D-123.45"
                               value="@Model.VehicleNumber" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Tài xế</label>
                        <input type="text" name="DriverName" class="form-control" maxlength="100"
                               placeholder="Tên người giao hàng / tài xế"
                               value="@Model.DriverName" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">SĐT tài xế</label>
                        <input type="text" name="DriverPhone" class="form-control" maxlength="20"
                               placeholder="Số điện thoại liên hệ nhanh"
                               value="@Model.DriverPhone" />
                    </div>
                </div>
                <div class="form-help inbound-tip">
                    <strong>💡 Mẹo:</strong> Khai báo đủ giờ xe đến và khung nhận hàng ngay từ đầu để trưởng kho duyệt nhanh. Nếu chưa biết cửa nào trống, để trống ô "Cửa nhận hàng ưu tiên" — hệ thống sẽ tự gợi ý.
                </div>
            }
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header line-items-toolbar">
            <div class="line-items-toolbar-left">
                <span class="card-title line-items-title">Danh sách vật tư</span>
                <div class="barcode-input-wrap">
                    <i class="fas fa-barcode barcode-input-icon"></i>
                    <input type="text" id="barcodeInput" class="form-control barcode-input-field" autocomplete="off" 
                           placeholder="Quét mã vạch hoặc nhập mã vật tư rồi nhấn Enter" 
                           />
                    <span id="scannerLed" class="scanner-led"></span>
                </div>
                <span id="scanCount" class="badge scan-count-badge">0 lượt quét</span>
                <button type="button" class="btn btn-sm btn-secondary" data-wms-call="toggleWebcamScanner"><i class="fas fa-camera"></i> Quét bằng camera</button>
            </div>
            <div class="line-items-toolbar-actions">
                @if (isInbound)
                {
                    <button type="button" class="btn btn-sm btn-putaway" data-wms-call="autoPutaway" title="Tự động gợi ý vị trí cất hàng phù hợp dựa trên vật tư, sức chứa và quy tắc vận hành.">
                        <i class="fas fa-robot"></i> Gợi ý vị trí cất hàng
                    </button>
                }
                <label class="btn btn-sm btn-info btn-inline-label" id="uploadDocumentBtn" for="documentFileInput">
                    <span id="uploadDocumentBtnText"><i class="fas fa-magic"></i> Đọc chứng từ bằng AI</span>
                </label>
                <input type="file" id="documentFileInput" accept=".pdf,.jpg,.jpeg,.png,.webp,.docx,.pptx,.xlsx" multiple class="d-none" />
                <label class="btn btn-sm btn-secondary btn-inline-label" id="importExcelBtn" for="excelFileInput">
                    <i class="fas fa-file-import"></i> Tải danh sách từ Excel
                </label>
                <input type="file" id="excelFileInput" accept=".xlsx" class="d-none" />
                <a class="btn btn-sm btn-ghost" asp-controller="Vouchers" asp-action="DownloadImportTemplate" title="Tải file mẫu Excel đúng cấu trúc để nhập dữ liệu nhanh và hạn chế lỗi.">
                    <i class="fas fa-download"></i> Tải file mẫu
                </a>
                <button type="button" class="btn btn-sm btn-primary" data-wms-call="addRow"><i class="fas fa-plus"></i> Thêm dòng vật tư</button>
            </div>
        </div>
        <!-- Scan toast notification -->
        <div id="scanToast" class="scan-toast-enterprise"></div>
        <div class="table-container flat voucher-mobile-line-editor">
            <table id="linesTable" class="voucher-lines-table">
                <thead>
                    <tr>
                        <th class="col-line-no">#</th>
                        <th class="col-item">Vật Tư / Hàng Hóa *</th>
                        <th class="col-uom">@(isInbound ? "Đơn vị nhập" : "Đơn vị xuất")</th>
                        <th class="col-qty">@(isInbound ? "Số lượng nhập *" : "Số lượng xuất *")</th>
                        @if (Model.VoucherType is WMS.Models.VoucherTypeEnum.NhapKho or WMS.Models.VoucherTypeEnum.KhachTra or WMS.Models.VoucherTypeEnum.NhapThanhPham or WMS.Models.VoucherTypeEnum.ChuyenKho)
                        {
                            <th class="col-lot">Số lô</th>
                        }
                        @if (Model.VoucherType == WMS.Models.VoucherTypeEnum.ChuyenKho)
                        {
                            <th class="col-location">Lấy từ vị trí *</th>
                            <th class="col-location">Chuyển đến vị trí *</th>
                        }
                        @if (Model.VoucherType == WMS.Models.VoucherTypeEnum.DieuChinh)
                        {
                            <th class="col-adjust">Điều chỉnh</th>
                        }
                        @* Removed SL lỗi/thiếu column for simpler UX *@
                        @if (!isInbound)
                        {
                            <th class="col-base-uom" title="Đơn vị tồn kho (base unit) được hệ thống tự xác định dựa trên vật tư đã chọn.">Đơn vị tồn kho <i class="fas fa-info-circle info-inline-icon"></i></th>
                            <th class="col-conversion" title="Hệ số quy đổi: SL xuất × hệ số = SL trừ tồn kho. VD: xuất 2 Thùng × 10 Cái/Thùng = trừ 20 Cái.">Quy đổi ra đơn vị tồn <i class="fas fa-info-circle info-inline-icon"></i></th>
                        }
                        @if (isInbound)
                        {
                            <th class="col-putaway">Vị trí cất hàng</th>
                            <th class="col-date">Ngày SX</th>
                            <th class="col-date">Hạn SD</th>
                        }
                        <th class="price-col col-price">Đơn Giá (VNĐ)</th>
                        <th class="col-remove"></th>
                    </tr>
                </thead>
                <tbody id="linesContainer">
                    @{
                        if (Model.Lines == null || !Model.Lines.Any())
                        {
                            Model.Lines = new List<WMS.ViewModels.VoucherDetailLine> { new WMS.ViewModels.VoucherDetailLine { DefectQty = 0, TransactionQty = 0, UnitPrice = 0 } };
                        }
                    }
                    @for (int i = 0; i < Model.Lines.Count; i++)
                    {
                        var line = Model.Lines[i];
                        <tr class="line-row">
                            <td class="line-no text-center text-muted fw-700">@(i + 1)</td>
                            <td>
                                <select name="Lines[@i].ItemId" class="form-control item-select" required data-wms-change-call="itemChanged" data-wms-change-self="true">
                                    <option value="">-- Chọn vật tư --</option>
                                    @foreach(var item in Model.Items) { 
                                        <option value="@item.ItemId" 
                                                data-uom="@item.BaseUomId" 
                                                data-group="@item.BaseUom?.UomGroup"
                                                data-cost="@(canSeeFinancial ? item.UnitCost.ToString(System.Globalization.CultureInfo.InvariantCulture) : 0)" 
                                                data-default-loc="@item.DefaultLocationId"
                                                data-default-wh="@item.DefaultLocation?.Zone?.WarehouseId"
                                                data-item-type="@item.ItemType"
                                                data-track-lot="@(item.TrackLot ? "true" : "false")"
                                                data-track-expiry="@(item.TrackExpiry ? "true" : "false")"
                                                data-track-serial="@(item.TrackSerial ? "true" : "false")"
                                                data-image-url="@(item.ImageUrl ?? "")"
                                                disabled="@(item.BaseUomId <= 0 ? "disabled" : null)"
                                                selected="@(item.ItemId == line.ItemId ? "selected" : null)">
                                            [@item.ItemCode] @item.ItemName
                                        </option> 
                                    }
                                </select>
                            </td>
                            <td>
                                <select name="Lines[@i].TransactionUomId" class="form-control source-uom-select" data-placeholder-text="-- Chọn đơn vị @(isInbound ? "nhập" : "xuất") --" data-wms-change-call="sourceUomChanged" data-wms-change-self="true">
                                    <option value="">-- Chọn đơn vị @(isInbound ? "nhập" : "xuất") --</option>
                                    @foreach(var u in Model.Uoms) { 
                                        <option value="@u.UomId" data-group="@u.UomGroup"
                                                selected="@(u.UomId == line.TransactionUomId ? "selected" : null)">
                                            @u.UomCode - @u.UomName
                                        </option> 
                                    }
                                </select>
                            </td>
                            <td>
                                <input type="text" name="Lines[@i].TransactionQty" class="form-control text-right qty-input" required value="@(line.TransactionQty > 0 ? line.TransactionQty.ToString("N0") : "")" data-wms-input-call="formatAndCalc" data-wms-input-self="true" />
                            </td>
                            @if (Model.VoucherType is WMS.Models.VoucherTypeEnum.NhapKho or WMS.Models.VoucherTypeEnum.KhachTra or WMS.Models.VoucherTypeEnum.NhapThanhPham or WMS.Models.VoucherTypeEnum.ChuyenKho)
                            {
                                <td>
                                    <input type="text" name="Lines[@i].LotNumber" class="form-control lot-input" value="@line.LotNumber" placeholder="Nhập số lô từ NCC" />
                                </td>
                            }
                            @if (Model.VoucherType == WMS.Models.VoucherTypeEnum.ChuyenKho)
                            {
                                <td>
                                    <select name="Lines[@i].LocationId" class="form-control loc-select" required>
                                        <option value="">-- Chọn vị trí lấy hàng --</option>
                                        @foreach (var loc in Model.Locations.Where(l => l.IsActive))
                                        {
                                            <option value="@loc.LocationId" data-warehouse-id="@loc.Zone?.WarehouseId" selected="@(loc.LocationId == line.LocationId ? "selected" : null)">
                                                @loc.LocationCode
                                            </option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <select name="Lines[@i].DestLocationId" class="form-control dest-loc-select" required>
                                        <option value="">-- Chọn vị trí nhận hàng --</option>
                                        @foreach (var loc in Model.Locations.Where(l => l.IsActive))
                                        {
                                            <option value="@loc.LocationId" data-warehouse-id="@loc.Zone?.WarehouseId" selected="@(loc.LocationId == line.DestLocationId ? "selected" : null)">
                                                @loc.LocationCode
                                            </option>
                                        }
                                    </select>
                                </td>
                            }
                            @if (Model.VoucherType == WMS.Models.VoucherTypeEnum.DieuChinh)
                            {
                                <td>
                                    <select name="Lines[@i].AdjustSign" class="form-control select-strong">
                                        <option value="1" selected="@(line.AdjustSign == 1 ? "selected" : null)">Tăng</option>
                                        <option value="-1" selected="@(line.AdjustSign == -1 ? "selected" : null)">Giảm</option>
                                    </select>
                                </td>
                            }
                            @* Removed SL lỗi/thiếu input *@
                            @if (!isInbound)
                            {
                                <td>
                                    <select class="form-control dest-uom-select" disabled>
                                        <option value="">-- Đơn vị tồn kho --</option>
                                        @foreach(var u in Model.Uoms) { 
                                            <option value="@u.UomId">@u.UomCode - @u.UomName</option> 
                                        }
                                    </select>
                                </td>
                                <td>
                                    <input type="text" name="Lines[@i].DestQty" class="form-control text-right dest-qty-input input-strong-accent" readonly title="Hệ số quy đổi được tính tự động theo bảng quy đổi hệ thống." />
                                    @* For non-transfer vouchers, LocationId is handled via hidden field *@
                                    @if (Model.VoucherType != WMS.Models.VoucherTypeEnum.ChuyenKho)
                                    {
                                        <input type="hidden" name="Lines[@i].LocationId" class="loc-input" value="@line.LocationId" />
                                        <input type="hidden" name="Lines[@i].LotNumber" class="source-lot-input" value="@line.LotNumber" />
                                        <input type="hidden" name="Lines[@i].ExpiryDate" class="source-expiry-input" value="@(line.ExpiryDate?.ToString("yyyy-MM-dd"))" />
                                        <input type="hidden" name="Lines[@i].FefoOverrideReason" class="fefo-override-reason-input" value="@line.FefoOverrideReason" />
                                        @if (Model.VoucherType is WMS.Models.VoucherTypeEnum.XuatKho or WMS.Models.VoucherTypeEnum.TraNCC or WMS.Models.VoucherTypeEnum.XuatSanXuat)
                                        {
                                            <button type="button" class="btn btn-xs btn-outline-primary source-location-btn" data-wms-call-self="openLocationSuggestion" title="Chọn lô, HSD và vị trí lấy hàng theo FEFO/FIFO">
                                                <i class="fas fa-map-marker-alt"></i> Chọn lô/vị trí
                                            </button>
                                            <div class="source-fefo-note" aria-live="polite"></div>
                                        }
                                    }
                                </td>
                            }
                            else
                            {
                                @* Inbound: hide conversion, auto-set DestQty=0 (ConversionRate=1) *@
                                <input type="hidden" name="Lines[@i].DestQty" value="0" />
                            }
                            @if (isInbound)
                            {
                                <td>
                                    <select name="Lines[@i].LocationId" class="form-control putaway-loc-select">
                                        <option value="">-- Chờ hệ thống gợi ý vị trí --</option>
                                        @foreach (var loc in Model.Locations.Where(l => l.IsActive))
                                        {
                                            <option value="@loc.LocationId" data-warehouse-id="@loc.Zone?.WarehouseId" selected="@(loc.LocationId == line.LocationId ? "selected" : null)">@loc.LocationCode</option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <input type="date" name="Lines[@i].ManufacturingDate" class="form-control mfg-date-input" value="@(line.ManufacturingDate?.ToString("yyyy-MM-dd"))" />
                                </td>
                                <td>
                                    <input type="date" name="Lines[@i].ExpiryDate" class="form-control exp-date-input" value="@(line.ExpiryDate?.ToString("yyyy-MM-dd"))" />
                                    <div class="text-muted fs-xs expiry-policy-note" aria-live="polite"></div>
                                </td>
                            }
                            <input type="hidden" name="Lines[@i].DefectQty" value="0" />
                            <input type="hidden" name="Lines[@i].OcrDocumentNumber" class="ocr-document-number-input" value="@line.OcrDocumentNumber" />
                            <input type="hidden" name="Lines[@i].OcrSourceLineNumber" class="ocr-source-line-input" value="@line.OcrSourceLineNumber" />
                            <td class="price-col">
                                <input type="text" name="Lines[@i].UnitPrice" class="form-control text-right cost-input" value="@(Model.VoucherType == WMS.Models.VoucherTypeEnum.NhapKho || Model.VoucherType == WMS.Models.VoucherTypeEnum.XuatSanXuat || !canSeeFinancial ? "0" : line.UnitPrice.ToString("N0"))" @(Model.VoucherType == WMS.Models.VoucherTypeEnum.NhapKho || Model.VoucherType == WMS.Models.VoucherTypeEnum.XuatSanXuat || !canSeeFinancial ? "readonly" : "") data-wms-input-call="formatAndPrice" data-wms-input-self="true" />
                            </td>
                            <td class="line-row-actions">
                                <button type="button" class="btn-delete-row" data-wms-call-self="deleteRow" title="Xóa dòng">
                                    <i class="fas fa-times"></i>
                                </button>
                            </td>

                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>

    <div class="action-bar voucher-submit-actions">
        @if (Model.VoucherType is WMS.Models.VoucherTypeEnum.NhapKho or WMS.Models.VoucherTypeEnum.KhachTra or WMS.Models.VoucherTypeEnum.NhapThanhPham)
        {
            <button type="submit" class="btn btn-secondary btn-lg" name="submit" value="false" id="saveDraftBtn"><i class="fas fa-save"></i> Lưu tạm</button>
            <button type="submit" class="btn btn-success btn-lg" name="submit" value="true" id="submitBtn"><i class="fas fa-paper-plane"></i> Lưu và gửi duyệt</button>
        }
        else
        {
            <button type="submit" class="btn btn-success btn-lg" id="submitBtn"><i class="fas fa-check"></i> Hoàn tất và lưu phiếu</button>
        }
    </div>
</form>


@section Scripts {
<link href="~/vendor/select2/css/select2.min.css" rel="stylesheet" asp-append-version="true" />
<script src="~/vendor/select2/js/select2.min.js" asp-append-version="true"></script>
<script>
    const partnerRequiredMessage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(partnerRequiredMessage));
    const ownerRequiredMessage = 'Vui lòng chọn chủ hàng trước khi lưu phiếu.';

    function getSafeItemImageUrl(optionElement) {
        const raw = (optionElement?.dataset?.imageUrl || '').trim();
        if (!raw) return '';

        if (raw.startsWith('/uploads/items/') || raw.startsWith('https://') || raw.startsWith('http://')) {
            return raw;
        }

        return '';
    }

    function createItemThumbNode(imageUrl, altText) {
        if (imageUrl) {
            const img = document.createElement('img');
            img.className = 'item-thumb';
            img.src = imageUrl;
            img.alt = altText || 'Ảnh vật tư';
            img.loading = 'lazy';
            img.decoding = 'async';
            img.onerror = function() {
                this.replaceWith(createItemThumbNode('', altText));
            };
            return img;
        }

        const fallback = document.createElement('span');
        fallback.className = 'item-thumb item-thumb-empty';
        fallback.setAttribute('aria-hidden', 'true');
        const icon = document.createElement('i');
        icon.className = 'fas fa-box';
        fallback.appendChild(icon);
        return fallback;
    }

    function renderItemSelectOption(option) {
        if (!option.id || !option.element) {
            return option.text;
        }

        const imageUrl = getSafeItemImageUrl(option.element);
        const wrapper = document.createElement('div');
        wrapper.className = 'item-select-option';
        wrapper.appendChild(createItemThumbNode(imageUrl, option.text));

        const copy = document.createElement('div');
        copy.className = 'item-select-option-copy';

        const title = document.createElement('span');
        title.className = 'item-select-option-title';
        title.textContent = option.text || '';
        copy.appendChild(title);

        const meta = document.createElement('span');
        meta.className = 'item-select-option-meta';
        meta.textContent = imageUrl ? 'Có ảnh nhận diện' : 'Chưa có ảnh nhận diện';
        copy.appendChild(meta);

        wrapper.appendChild(copy);
        return $(wrapper);
    }

    function getVoucherSelect2Options(extraOptions = {}) {
        return {
            width: '100%',
            dropdownAutoWidth: true,
            dropdownParent: $(document.body),
            ...extraOptions
        };
    }

    function initItemSelect2Element(itemSelect) {
        if (!itemSelect || $(itemSelect).hasClass('select2-hidden-accessible')) return;
        $(itemSelect).select2(getVoucherSelect2Options({
            dropdownCssClass: 'wms-item-select-dropdown',
            templateResult: renderItemSelectOption
        }));
    }

    function initSourceUomSelect2Element(sourceUomSelect) {
        if (!sourceUomSelect || $(sourceUomSelect).hasClass('select2-hidden-accessible')) return;
        $(sourceUomSelect).select2(getVoucherSelect2Options({
            dropdownCssClass: 'wms-source-uom-dropdown'
        }));
    }

    function initPlainVoucherSelect2Element(select) {
        if (!select || $(select).hasClass('select2-hidden-accessible')) return;
        $(select).select2(getVoucherSelect2Options());
    }

    function syncItemSelect2(itemSelect, value) {
        if (!itemSelect) return;
        const normalizedValue = value?.toString() || '';
        itemSelect.value = normalizedValue;
        if ($(itemSelect).hasClass('select2-hidden-accessible')) {
            $(itemSelect).val(normalizedValue).trigger('change.select2');
        }
    }

    function initSelect2() {
        $('.item-select').each(function() {
            initItemSelect2Element(this);
        });

        $('.source-uom-select').each(function() {
            initSourceUomSelect2Element(this);
        });

        $('select[name="PartnerId"]').each(function() {
            initPlainVoucherSelect2Element(this);
        });
        
        // Fix for Select2 search input focus inside modals or elements
        $(document).off('select2:open.wmsVoucherCreate').on('select2:open.wmsVoucherCreate', () => {
            document.querySelector('.select2-search__field').focus();
        });
    }

    function bindVoucherSelect2ChangeBridge() {
        $(document)
            .off('change.wmsVoucherItemSelect2Bridge', '.item-select')
            .on('change.wmsVoucherItemSelect2Bridge', '.item-select', function(event) {
                if (event.originalEvent) return;
                itemChanged(this);
            });

        $(document)
            .off('change.wmsVoucherSourceUomSelect2Bridge', '.source-uom-select')
            .on('change.wmsVoucherSourceUomSelect2Bridge', '.source-uom-select', function(event) {
                if (event.originalEvent) return;
                sourceUomChanged(this);
            });
    }

    $(document).ready(function() {
        initSelect2();
        bindVoucherSelect2ChangeBridge();
    });
    // === COMMA FORMATTING UTILITIES ===
    function parseCommaNumber(str) {
        if (!str) return 0;
        return parseFloat(str.toString().replace(/,/g, '')) || 0;
    }
    function formatWithCommas(num) {
        if (num === '' || num === null || num === undefined) return '';
        var n = parseFloat(num.toString().replace(/,/g, ''));
        if (isNaN(n)) return '';
        // Preserve decimals if present
        var parts = num.toString().replace(/,/g, '').split('.');
        var intPart = parseInt(parts[0]) || 0;
        var formatted = intPart.toLocaleString('en-US');
        if (parts.length > 1) formatted += '.' + parts[1];
        return formatted;
    }
    function formatCommaInput(input) {
        var cursorPos = input.selectionStart;
        var oldLen = input.value.length;
        var raw = input.value.replace(/[^0-9.\-]/g, '');
        input.value = formatWithCommas(raw);
        var newLen = input.value.length;
        input.selectionStart = input.selectionEnd = cursorPos + (newLen - oldLen);
    }
    function formatAndCalc(input) {
        formatCommaInput(input);
        sourceQtyChanged(input);
    }
    function formatAndPrice(input) {
        formatCommaInput(input);
        priceChanged(input);
    }
    // Strip commas before form submission so server gets clean numbers
    document.addEventListener('DOMContentLoaded', function() {
        var form = document.getElementById('voucherForm');
        if (form) {
            // Normalize quantity inputs to avoid culture traps.
            // Quy ước nhập liệu:
            // - Nếu có 3 chữ số sau một dấu phân cách duy nhất thì xem là phân tách hàng nghìn (1,000 => 1000)
            // - Nếu có 1-2 chữ số sau một dấu phân cách duy nhất thì xem là phần thập phân (10.50 => 10.5)
            function normalizeQtyForPost(val) {
                if (!val) return '';
                let s = val.toString().trim();
                if (!s) return '';
                // keep digits, dot, comma, minus
                s = s.replace(/[^0-9.,\-]/g, '');
                if (!s) return '';

                const hasDot = s.indexOf('.') >= 0;
                const hasComma = s.indexOf(',') >= 0;
                let normalized = s;

                if (hasDot && hasComma) {
                    // If both exist, assume the last one is decimal separator
                    const lastDot = s.lastIndexOf('.');
                    const lastComma = s.lastIndexOf(',');
                    const decIsDot = lastDot > lastComma;
                    if (decIsDot) normalized = s.replace(/,/g, '');
                    else normalized = s.replace(/\./g, '').replace(',', '.');
                } else if (hasDot || hasComma) {
                    const sep = hasDot ? '.' : ',';
                    const parts = s.split(sep);
                    if (parts.length > 2) {
                        // multiple separators => thousands
                        normalized = s.replace(/[.,]/g, '');
                    } else {
                        const frac = parts[1] ?? '';
                        if (frac.length === 3) {
                            // 1,000 or 1.000 => thousands
                            normalized = s.replace(/[.,]/g, '');
                        } else if (frac.length === 0) {
                            normalized = parts[0];
                        } else if (frac.length <= 2) {
                            // decimal
                            normalized = parts[0] + '.' + frac;
                        } else {
                            // ambiguous long fraction -> treat as thousands to be safe
                            normalized = s.replace(/[.,]/g, '');
                        }
                    }
                }

                normalized = normalized.replace(/(?!^)-/g, '');
                const n = parseFloat(normalized);
                if (isNaN(n)) return '';
                return n.toString();
            }
            form.addEventListener('submit', function() {
                // Quantities: normalize aggressively
                form.querySelectorAll('.qty-input, .dest-qty-input, .defect-input').forEach(function(inp) {
                    inp.value = normalizeQtyForPost(inp.value);
                });
                // Prices: keep old behavior (commas only) to preserve meaning of "10.000" = 10k if user ever types dots
                form.querySelectorAll('.cost-input').forEach(function(inp) {
                    inp.value = inp.value.replace(/,/g, '');
                });
            });
        }
    });
    // ============================================================
    // HỆ THỐNG QUÉT MÃ VẠCH CẤP DOANH NGHIỆP
    // Hỗ trợ: thiết bị quét USB/Bluetooth, camera điện thoại, nhập tay
    // ============================================================

    let lineIdx = @(Model.Lines?.Count ?? 1);
    let totalScanned = 0;

    // --- WEB AUDIO BEEP (instant, no external dependency) ---
    const AudioCtx = window.AudioContext || window.webkitAudioContext;
    let _audioCtx = null;

    function playBeep(frequency = 1200, duration = 150, type = 'square') {
        try {
            if (!_audioCtx) _audioCtx = new AudioCtx();
            const osc = _audioCtx.createOscillator();
            const gain = _audioCtx.createGain();
            osc.type = type;
            osc.frequency.value = frequency;
            gain.gain.value = 0.3;
            osc.connect(gain);
            gain.connect(_audioCtx.destination);
            osc.start();
            gain.gain.exponentialRampToValueAtTime(0.001, _audioCtx.currentTime + duration / 1000);
            osc.stop(_audioCtx.currentTime + duration / 1000);
        } catch (e) { /* Audio not supported */ }
    }

    function beepSuccess() {
        playBeep(1200, 100, 'square');
        setTimeout(() => playBeep(1600, 100, 'square'), 120);
    }

    function beepError() {
        playBeep(300, 300, 'sawtooth');
    }

    function beepDuplicate() {
        playBeep(800, 80, 'square');
    }

    // --- TOAST NOTIFICATION ---
    function showScanToast(message, type = 'success') {
        const toast = document.getElementById('scanToast');
        if (!toast) return;
        toast.textContent = message;
        toast.classList.remove('scan-toast-success', 'scan-toast-duplicate', 'scan-toast-error');
        toast.classList.add('is-visible', type === 'success' ? 'scan-toast-success' : (type === 'duplicate' ? 'scan-toast-duplicate' : 'scan-toast-error'));
        clearTimeout(toast._hideTimer);
        toast._hideTimer = setTimeout(() => {
            toast.classList.remove('is-visible', 'scan-toast-success', 'scan-toast-duplicate', 'scan-toast-error');
        }, 3000);
    }

    // --- SCAN COUNTER ---
    function updateScanCount() {
        totalScanned++;
        const badge = document.getElementById('scanCount');
        if (badge) {
            badge.textContent = totalScanned + ' đã quét';
            badge.style.display = 'inline-block';
        }
    }

    // --- ROW MANAGEMENT ---
    function refreshLineNumbers() {
        const rows = document.querySelectorAll('#linesContainer .line-row');
        rows.forEach((r, idx) => {
            const cell = r.querySelector('.line-no');
            if (cell) cell.textContent = (idx + 1).toString();
        });
    }

    // Gắn sự kiện cho các dòng có sẵn
    document.querySelectorAll('.line-row').forEach(row => {
        const qtyInput = row.querySelector('.qty-input');
        if (qtyInput) qtyInput.addEventListener('input', function() { formatAndCalc(this); });
    });
    refreshLineNumbers();

    // Override addRow để gắn sự kiện cho dòng mới thêm
    window.addRow = function() {
        // Hủy select2 trước khi clone để tránh lỗi giao diện
        $('.item-select, .source-uom-select, select[name="PartnerId"]').each(function() {
            if ($(this).hasClass("select2-hidden-accessible")) {
                $(this).select2('destroy');
            }
        });

        const tbody = document.getElementById('linesContainer');
        const newRow = document.querySelector('.line-row').cloneNode(true);
        newRow.querySelectorAll('[name]').forEach(el => {
            el.name = el.name.replace(/\[\d+\]/, `[${lineIdx}]`);
            if (el.tagName === 'INPUT') {
                if(el.className.includes('loc-input')
                    || el.className.includes('source-lot-input')
                    || el.className.includes('source-expiry-input')
                    || el.className.includes('fefo-override-reason-input')) el.value = '';
                else if (el.classList.contains('ocr-document-number-input') || el.classList.contains('ocr-source-line-input')) el.value = '';
                else if(el.type === 'hidden') { /* keep hidden defaults */ }
                else el.value = '';
            } else if (el.tagName === 'SELECT') {
                if(el.className.includes('item-select')) el.value = '';
                if(el.className.includes('source-uom-select')) el.value = '';
                if(el.className.includes('loc-select') || el.className.includes('putaway-loc-select') || el.className.includes('dest-loc-select')) el.value = '';
            }
        });
        // Reset dest-uom-select (no name attribute)
        const destUom = newRow.querySelector('.dest-uom-select');
        if (destUom) destUom.value = '';
        const destQty = newRow.querySelector('.dest-qty-input');
        if (destQty) destQty.value = '';
        const sourceNote = newRow.querySelector('.source-fefo-note');
        if (sourceNote) {
            sourceNote.textContent = '';
            sourceNote.classList.remove('is-override');
        }
        
        // Gắn sự kiện cho dòng mới (with comma formatting)
        const sourceUomSelect = newRow.querySelector('.source-uom-select');
        if (sourceUomSelect) {
            resetSourceUomOptions(sourceUomSelect);
        }
        newRow.querySelectorAll('.putaway-loc-select, .loc-select, .dest-loc-select').forEach(syncLocationSelectForWarehouse);

        tbody.appendChild(newRow);
        lineIdx++;

        // Khởi tạo lại select2 cho tất cả
        initSelect2();
        refreshLineNumbers();
    };

    // === DELETE ROW ===
    window.deleteRow = function(btn) {
        const row = btn.closest('tr');
        const tbody = document.getElementById('linesContainer');
        const rows = tbody.querySelectorAll('.line-row');
        if (rows.length <= 1) {
            Swal.fire('Cảnh Báo', 'Phải có ít nhất 1 dòng chi tiết!', 'warning');
            return;
        }
        // Destroy select2 before removing
        $('.item-select, .source-uom-select').each(function() {
            if ($(this).hasClass('select2-hidden-accessible')) {
                $(this).select2('destroy');
            }
        });
        row.remove();
        // Re-index remaining rows
        const remainingRows = tbody.querySelectorAll('.line-row');
        remainingRows.forEach((r, idx) => {
            r.querySelectorAll('[name]').forEach(el => {
                el.name = el.name.replace(/\[\d+\]/, `[${idx}]`);
            });
        });
        lineIdx = remainingRows.length;
        // Reinit select2
        initSelect2();
        refreshLineNumbers();
    };

    const itemAllowedSourceUoms = @Html.Raw(itemAllowedSourceUomsJson);
    const allSourceUomOptions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.Uoms.Select(u => new
        {
            id = u.UomId,
            text = $"{u.UomCode} - {u.UomName}",
            group = u.UomGroup
        }).ToList()
    ));
    const isInboundVoucherJs = @(isInbound ? "true" : "false");
    const isExportVoucherJs = @(Model.VoucherType == WMS.Models.VoucherTypeEnum.XuatKho ? "true" : "false");
    const isSourceStockVoucherJs = @(Model.VoucherType is WMS.Models.VoucherTypeEnum.XuatKho or WMS.Models.VoucherTypeEnum.TraNCC or WMS.Models.VoucherTypeEnum.XuatSanXuat ? "true" : "false");
    const canOverrideFefoJs = @(User.IsInRole("Admin") || User.IsInRole("Manager") ? "true" : "false");
    const voucherConversionRateUrl = '@Url.Action("GetConversionRate", "Vouchers")';
    const itemLocationsUrl = '@Url.Action("GetItemLocations", "Warehouses")';
    const suggestedLocationsUrl = '@Url.Action("GetSuggestedLocations", "Warehouses")';
    const locationConflictUrl = '@Url.Action("CheckLocationConflict", "Warehouses")';
    const itemByBarcodeUrl = '@Url.Action("GetItemByBarcode", "Items")';
    const importLinesExcelUrl = '@Url.Action("ImportLinesExcel", "Vouchers")';
    const analyzeReceiptUrl = '@Url.Action("AnalyzeReceipt", "Vouchers")';
    const analyzeReceiptsUrl = '@Url.Action("AnalyzeReceipts", "Vouchers")';
    const suggestPutawayUrl = '@Url.Action("SuggestPutaway", "Vouchers")';
    const appliedExcelImportFingerprints = new Set();
    let excelImportInProgress = false;

    function getCurrentWarehouseId() {
        const warehouseField = document.querySelector('select[name="WarehouseId"], input[name="WarehouseId"]');
        return parseInt(warehouseField?.value || '0');
    }

    function buildWarehouseQuery() {
        const warehouseId = getCurrentWarehouseId();
        return warehouseId > 0 ? `&warehouseId=${warehouseId}` : '';
    }

    function locationOptionBelongsToCurrentWarehouse(option) {
        if (!option || !option.value) return true;
        const currentWarehouseId = getCurrentWarehouseId();
        const optionWarehouseId = parseInt(option.dataset.warehouseId || '0');
        return currentWarehouseId <= 0 || optionWarehouseId <= 0 || optionWarehouseId === currentWarehouseId;
    }

    function getLocationOptionByValue(select, value) {
        if (!select || value === null || value === undefined || value === '') return null;
        const normalizedValue = value.toString();
        return Array.from(select.options).find(option => option.value === normalizedValue) || null;
    }

    function getValidLocationValueForWarehouse(select, value) {
        const option = getLocationOptionByValue(select, value);
        return locationOptionBelongsToCurrentWarehouse(option) ? option?.value || '' : '';
    }

    function syncLocationSelectForWarehouse(select) {
        if (!select) return;
        const selectedValue = select.value;
        Array.from(select.options).forEach(option => {
            if (!option.value) {
                option.style.display = '';
                option.disabled = false;
                return;
            }

            const belongsToWarehouse = locationOptionBelongsToCurrentWarehouse(option);
            option.style.display = belongsToWarehouse ? '' : 'none';
            option.disabled = !belongsToWarehouse;
        });

        if (selectedValue && !getValidLocationValueForWarehouse(select, selectedValue)) {
            select.value = '';
        }
    }

    function syncAllLocationSelectsForWarehouse() {
        document.querySelectorAll('.putaway-loc-select, .loc-select, .dest-loc-select').forEach(syncLocationSelectForWarehouse);
    }

    function warehouseChanged() {
        syncAllLocationSelectsForWarehouse();
        document.querySelectorAll('#linesContainer .line-row .item-select').forEach(select => {
            if (select.value) {
                itemChanged(select);
            }
        });
    }

    async function fetchJsonOrThrow(url, defaultMessage) {
        const response = await fetch(url);
        const raw = await response.text();
        let data = null;

        if (raw) {
            try {
                data = JSON.parse(raw);
            } catch {
                if (response.ok) {
                    throw new Error(defaultMessage || 'Máy chủ trả về dữ liệu không hợp lệ.');
                }
            }
        }

        if (!response.ok) {
            const message = (data && (data.message || data.error)) || raw || defaultMessage || 'Không thể tải dữ liệu.';
            throw new Error(message);
        }

        if (data === null) {
            throw new Error(defaultMessage || 'Máy chủ không trả về JSON hợp lệ.');
        }

        return data;
    }

    function getSourceUomPlaceholder(sourceUomSelect) {
        return sourceUomSelect?.dataset?.placeholderText || '-- Chọn đơn vị --';
    }

    function normalizeSourceUomIds(uomIds) {
        const knownUomIds = new Set(allSourceUomOptions.map(uom => uom.id.toString()));
        return Array.from(new Set((uomIds || [])
            .map(x => (x ?? '').toString())
            .filter(x => x && knownUomIds.has(x))));
    }

    function syncSourceUomSelect2(sourceUomSelect, value) {
        if (!sourceUomSelect) return;
        const normalizedValue = value?.toString() || '';
        sourceUomSelect.value = normalizedValue;
        if ($(sourceUomSelect).hasClass('select2-hidden-accessible')) {
            $(sourceUomSelect).val(normalizedValue).trigger('change.select2');
        }
        sourceUomSelect.dispatchEvent(new Event('change', { bubbles: true }));
    }

    function rebuildSourceUomOptions(sourceUomSelect, allowedUomIds, selectedValue) {
        if (!sourceUomSelect) return '';

        const normalizedAllowedUomIds = normalizeSourceUomIds(allowedUomIds);
        const allowedSet = new Set(normalizedAllowedUomIds);
        const nextValue = selectedValue?.toString() || '';
        const hadSelect2 = $(sourceUomSelect).hasClass('select2-hidden-accessible');
        const resolvedValue = allowedSet.has(nextValue) ? nextValue : (normalizedAllowedUomIds[0] || '');

        if (hadSelect2) {
            $(sourceUomSelect).select2('destroy');
        }

        sourceUomSelect.innerHTML = '';
        sourceUomSelect.appendChild(new Option(getSourceUomPlaceholder(sourceUomSelect), ''));

        allSourceUomOptions
            .filter(uom => allowedSet.has(uom.id.toString()))
            .forEach(uom => {
                const option = new Option(uom.text, uom.id);
                option.dataset.group = uom.group || '';
                sourceUomSelect.appendChild(option);
            });

        sourceUomSelect.disabled = normalizedAllowedUomIds.length === 0;
        sourceUomSelect.classList.toggle('uom-select-locked', normalizedAllowedUomIds.length === 0);
        sourceUomSelect.value = resolvedValue;

        if (hadSelect2) {
            initSourceUomSelect2Element(sourceUomSelect);
        }
        syncSourceUomSelect2(sourceUomSelect, resolvedValue);

        return resolvedValue;
    }

    function resetSourceUomOptions(sourceUomSelect) {
        return rebuildSourceUomOptions(sourceUomSelect, [], '');
    }

    function filterSourceUomOptions(sourceUomSelect, itemId, baseUomId) {
        if (!sourceUomSelect) return '';

        const normalizedItemId = itemId?.toString() || '';
        const normalizedBaseUomId = baseUomId?.toString() || '';
        const mapUomIds = normalizedItemId ? (itemAllowedSourceUoms[normalizedItemId] || itemAllowedSourceUoms[itemId] || []) : [];
        const allowedUomIds = normalizeSourceUomIds([
            ...mapUomIds,
            ...(normalizedBaseUomId ? [normalizedBaseUomId] : [])
        ]);

        const selectedValue = allowedUomIds.includes(sourceUomSelect.value)
            ? sourceUomSelect.value
            : (allowedUomIds.includes(normalizedBaseUomId) ? normalizedBaseUomId : (allowedUomIds[0] || ''));

        return rebuildSourceUomOptions(sourceUomSelect, allowedUomIds, selectedValue);
    }

    function syncExpiryPolicyForRow(row) {
        if (!row || !isInboundVoucherJs) return;

        const itemSelect = row.querySelector('.item-select');
        const selectedItem = itemSelect?.selectedOptions?.[0];
        const expiryInput = row.querySelector('.exp-date-input');
        const expiryNote = row.querySelector('.expiry-policy-note');
        if (!expiryInput) return;

        const hasSelectedItem = !!selectedItem?.value;
        const tracksExpiry = selectedItem?.dataset?.trackExpiry === 'true';

        expiryInput.required = false;
        expiryInput.disabled = false;
        expiryInput.title = '';

        if (!hasSelectedItem) {
            if (expiryNote) {
                expiryNote.textContent = '';
                expiryNote.classList.remove('text-danger', 'fw-700');
                expiryNote.classList.add('text-muted');
            }
            return;
        }

        if (tracksExpiry) {
            expiryInput.required = true;
            expiryInput.title = 'Vật tư này quản lý hạn sử dụng; bắt buộc nhập HSD khi nhập kho.';
            if (expiryNote) {
                expiryNote.textContent = 'Bắt buộc HSD';
                expiryNote.classList.remove('text-muted');
                expiryNote.classList.add('text-danger', 'fw-700');
            }
            return;
        }

        expiryInput.value = '';
        expiryInput.disabled = true;
        expiryInput.title = 'Không áp dụng: vật tư này không quản lý hạn sử dụng.';
        if (expiryNote) {
            expiryNote.textContent = 'Không áp dụng';
            expiryNote.classList.remove('text-danger', 'fw-700');
            expiryNote.classList.add('text-muted');
        }
    }

    function itemChanged(select) {
        const opt = select.selectedOptions[0];
        const row = select.closest('tr');
        syncExpiryPolicyForRow(row);
        const locSelect = row.querySelector('.loc-select');
        const putawaySelect = row.querySelector('.putaway-loc-select');
        if (opt.value) {
            // Set ĐV Đích = item's base UoM (auto-select, disabled)
            const destUomSelect = row.querySelector('.dest-uom-select');
            if (destUomSelect) {
                destUomSelect.value = opt.dataset.uom || '';
            }
            
            // Default source UoM cũng là base UoM
            const sourceUomSelect = row.querySelector('.source-uom-select');
            if (sourceUomSelect) {
                const selectedUom = filterSourceUomOptions(sourceUomSelect, opt.value, opt.dataset.uom || '');
                if (selectedUom) {
                    syncSourceUomSelect2(sourceUomSelect, selectedUom);
                } else if (typeof enterpriseNotify === 'function') {
                    enterpriseNotify({
                        title: 'Thiếu đơn vị nhập',
                        text: 'Vật tư này chưa có đơn vị cơ sở hoặc bảng quy đổi hợp lệ. Vui lòng kiểm tra danh mục vật tư trước khi lưu phiếu.',
                        icon: 'warning'
                    });
                }
            }

            // Chỉ chọn vị trí cất hàng sau khi API đã xác nhận vị trí an toàn cho vật tư hiện tại.
            if (putawaySelect) {
                syncLocationSelectForWarehouse(putawaySelect);
                putawaySelect.value = '';
                putawaySelect.classList.remove('putaway-highlight');
            }
            const validDefaultPutawayLocation = getValidLocationValueForWarehouse(putawaySelect, opt.dataset.defaultLoc);
            
            // Lưu base cost vào row
            let baseCost = parseFloat(opt.dataset.cost || 0);
            row.dataset.baseCost = baseCost;
            
            // Set initial unit price
            let initialPrice = baseCost;
            if (@((int)Model.VoucherType) == 2) { // XuatKho
                const exportMode = document.getElementById('ExportMode')?.value || 1;
                if (exportMode == 2) initialPrice = baseCost * 1.2;
                else initialPrice = 0;
            } else if (@((int)Model.VoucherType) == 1 || @((int)Model.VoucherType) == 8) { // NhapKho || XuatSanXuat
                initialPrice = 0;
            }
            row.querySelector('.cost-input').value = formatWithCommas(initialPrice.toFixed(0));
            
            // Tính SL Đích
            calculateDestQty(row);
            
            const defaultLoc = opt.dataset.defaultLoc;
            const locInput = row.querySelector('.loc-input');
            if (locInput) {
                clearSourceSelectionForRow(row);
                if (!isSourceStockVoucherJs && defaultLoc && defaultLoc !== "" && defaultLoc !== "0") {
                    locInput.value = defaultLoc;
                }
            }

            if (locSelect) {
                if (isExportVoucherJs) {
                    filterExportLocations(locSelect, opt.value);
                }
            }
            if (isInboundVoucherJs && putawaySelect) {
                limitImportLocations(putawaySelect, opt.value, validDefaultPutawayLocation || defaultLoc);
            }
        } else {
            const sourceUomSelect = row.querySelector('.source-uom-select');
            if (sourceUomSelect) {
                resetSourceUomOptions(sourceUomSelect);
            }
            [locSelect, putawaySelect].filter(Boolean).forEach(selectEl => {
                selectEl.dataset.putawayRequestId = '';
                selectEl.value = '';
                Array.from(selectEl.options).forEach(optEl => {
                    optEl.style.display = '';
                    optEl.disabled = false;
                });
                syncLocationSelectForWarehouse(selectEl);
            });
        }
    }
    
    // Khi user thay đổi ĐV Nguồn → tính lại SL Đích
    function sourceUomChanged(select) {
        const row = select.closest('tr');
        calculateDestQty(row);
    }
    
    // Khi user thay đổi SL Nguồn → tính lại SL Đích
    function sourceQtyChanged(input) {
        const row = input.closest('tr');
        calculateDestQty(row);
    }
    
    // Hệ số quy đổi được lấy từ bảng UnitConversion (item-specific ưu tiên hơn global).
    async function calculateDestQty(row) {
        const destQtyInput = row?.querySelector('.dest-qty-input');
        if (!destQtyInput) return;
        const itemSelect = row.querySelector('.item-select');
        const sourceUomSelect = row.querySelector('.source-uom-select');
        const selectedItem = itemSelect?.selectedOptions?.[0];
        const itemId = selectedItem?.value;
        const baseUomId = selectedItem?.dataset?.uom;
        const fromUomId = sourceUomSelect?.value || baseUomId;
        const toUomId = baseUomId;

        if (!itemId || !fromUomId || !toUomId) {
            destQtyInput.value = '';
            return;
        }

        if (fromUomId === toUomId) {
            destQtyInput.value = formatWithCommas('1');
            return;
        }

        try {
            const data = await fetchJsonOrThrow(`${voucherConversionRateUrl}?fromUomId=${encodeURIComponent(fromUomId)}&toUomId=${encodeURIComponent(toUomId)}&itemId=${encodeURIComponent(itemId)}`, 'Không tải được hệ số quy đổi.');
            if (!data?.found) {
                destQtyInput.value = '';
                return;
            }
            const rate = Number(data.rate || 0);
            destQtyInput.value = rate > 0 ? formatWithCommas(rate.toString()) : '';
        } catch {
            destQtyInput.value = '';
        }
    }

    function priceChanged(input) {
        const row = input.closest('tr');
        calculateRowPrice(row);
    }
    
    function calculateRowPrice(row) {
        const itemSelect = row.querySelector('.item-select');
        const itemOpt = itemSelect?.selectedOptions[0];
        if (!itemOpt || !itemOpt.value) return;
        
        if (@((int)Model.VoucherType) == 8) { // XuatSanXuat
            row.querySelector('.cost-input').value = '0';
        } else if (@((int)Model.VoucherType) == 2) { // XuatKho
            const exportMode = document.getElementById('ExportMode')?.value || 1;
            if (exportMode != 2) {
                row.querySelector('.cost-input').value = '0';
            }
        }
    }

    const canSeeFinancialJs = @(canSeeFinancial ? "true" : "false");

    function syncInventoryOwnershipMode() {
        const selectedMode = document.querySelector('input[name="InventoryOwnershipMode"]:checked')?.value || 'Internal';
        const ownerField = document.getElementById('ownerPartnerFieldDiv');
        const ownerSelect = document.getElementById('OwnerPartnerId');
        const isThreePl = selectedMode === 'ThreePl';

        if (ownerField) {
            ownerField.hidden = !isThreePl;
            ownerField.style.display = isThreePl ? '' : 'none';
        }

        if (ownerSelect) {
            ownerSelect.disabled = !isThreePl;
            if (!isThreePl) {
                ownerSelect.value = '';
            }
        }
    }
    
    function setExportMode(mode) {
        if (!document.getElementById('ExportMode')) return;
        document.getElementById('ExportMode').value = mode;

        // Sync combobox value
        const exportSelect = document.getElementById('exportModeSelect');
        if (exportSelect) exportSelect.value = mode;

        const showPrice = mode === 2 && canSeeFinancialJs;
        document.querySelectorAll('.price-col').forEach(el => el.style.display = showPrice ? 'table-cell' : 'none');

        // Recalculate prices for existing rows
        document.querySelectorAll('.line-row').forEach(row => {
            const costInput = row.querySelector('.cost-input');
            if (!costInput) return;
            if (showPrice) {
                costInput.removeAttribute('readonly');
                // Auto-fill from item UnitCost × 1.2 for external sales
                const itemSelect = row.querySelector('.item-select');
                const selectedOpt = itemSelect?.selectedOptions[0];
                if (selectedOpt && selectedOpt.value) {
                    const baseCost = parseFloat(selectedOpt.dataset.cost || 0);
                    if (!parseCommaNumber(costInput.value)) {
                        costInput.value = formatWithCommas((baseCost * 1.2).toFixed(0));
                    }
                }
            } else {
                costInput.setAttribute('readonly', 'readonly');
                costInput.value = '0';
            }
        });
        // Hiện/ẩn đối tác theo loại xuất
        const partnerDiv = document.getElementById('partnerFieldDiv');
        if (partnerDiv) partnerDiv.style.display = mode === 2 ? 'block' : 'none';
    }

    function initializeExportTabs() {
        if (@((int)Model.VoucherType) == 2) { // XuatKho
            const currentMode = parseInt(document.getElementById('ExportMode')?.value || '1');
            setExportMode(currentMode);
        } else if (@((int)Model.VoucherType) == 1 || @((int)Model.VoucherType) == 8) { // NhapKho || XuatSanXuat
             // Nhập kho (1) và Xuất SX (8): ẩn đơn giá
             document.querySelectorAll('.price-col').forEach(el => el.style.display = 'none');
        } else {
             document.querySelectorAll('.price-col').forEach(el => el.style.display = canSeeFinancialJs ? 'table-cell' : 'none');
        }
    }

    // --- LỌC VỊ TRÍ XUẤT KHO ---
    async function filterExportLocations(locSelect, itemId) {
        if (!locSelect || !itemId) return;
        // Reset trước
        Array.from(locSelect.options).forEach(opt => { opt.style.display = ''; opt.disabled = false; });
        try {
            const data = await fetchJsonOrThrow(`${itemLocationsUrl}?itemId=${encodeURIComponent(itemId)}${buildWarehouseQuery()}`, 'Không tải được danh sách vị trí xuất.');
            const occupiedIds = Array.isArray(data) ? data.map(d => d.locationId.toString()) : [];
            Array.from(locSelect.options).forEach(opt => {
                if (!opt.value) return;
                if (occupiedIds.includes(opt.value)) {
                    opt.style.display = '';
                    opt.disabled = false;
                } else {
                    opt.style.display = 'none';
                    opt.disabled = true;
                }
            });
            if (occupiedIds.length === 1) {
                locSelect.value = occupiedIds[0];
            } else if (locSelect.value && !occupiedIds.includes(locSelect.value)) {
                locSelect.value = '';
            }
        } catch {
            return;
        }
    }

    // --- LỌC VỊ TRÍ NHẬP KHO (TỐI ĐA 2 VỊ TRÍ) ---
    async function limitImportLocations(locSelect, itemId, defaultLocId) {
        if (!locSelect || !itemId) return;
        const requestSequence = (parseInt(locSelect.dataset.putawayRequestSequence || '0') || 0) + 1;
        const putawayRequestId = `${itemId}:${requestSequence}`;
        locSelect.dataset.putawayRequestSequence = requestSequence.toString();
        locSelect.dataset.putawayRequestId = putawayRequestId;
        syncLocationSelectForWarehouse(locSelect);
        locSelect.value = '';
        // Ẩn tất cả option (trừ option mặc định rỗng)
        Array.from(locSelect.options).forEach(opt => { 
            if (opt.value !== "") {
                opt.style.display = 'none';
                opt.disabled = true;
            }
        });

        try {
            const data = await fetchJsonOrThrow(`${suggestedLocationsUrl}?itemId=${encodeURIComponent(itemId)}&qty=1${buildWarehouseQuery()}`, 'Không tải được vị trí nhập gợi ý.');
            if (locSelect.dataset.putawayRequestId !== putawayRequestId) return;

            const selectedItemId = locSelect.closest('.line-row')?.querySelector('.item-select')?.value;
            if (selectedItemId !== itemId.toString()) return;

            const suggestions = Array.isArray(data) ? data : [];
            const safeSuggestionIds = suggestions
                .filter(suggestion => !suggestion.hasOtherItem)
                .map(suggestion => getValidLocationValueForWarehouse(locSelect, suggestion.locationId))
                .filter(Boolean);
            const validDefaultLocId = getValidLocationValueForWarehouse(locSelect, defaultLocId);
            const hasSafeDefaultLocation = validDefaultLocId
                && validDefaultLocId !== "0"
                && safeSuggestionIds.includes(validDefaultLocId);
            let allowedIds = hasSafeDefaultLocation ? [validDefaultLocId] : [];

            for (let i = 0; i < suggestions.length; i++) {
                if (allowedIds.length >= 2) break;
                let locStr = suggestions[i].locationId?.toString();
                if (locStr && safeSuggestionIds.includes(locStr) && !allowedIds.includes(locStr)) {
                    allowedIds.push(locStr);
                }
            }

            Array.from(locSelect.options).forEach(opt => {
                if (opt.value && allowedIds.includes(opt.value) && locationOptionBelongsToCurrentWarehouse(opt)) {
                    opt.style.display = '';
                    opt.disabled = false;
                }
            });

            if (validDefaultLocId && allowedIds.includes(validDefaultLocId)) {
                locSelect.value = validDefaultLocId;
            } else if (allowedIds.length > 0) {
                locSelect.value = allowedIds[0];
            } else {
                locSelect.value = '';
            }

            if (locSelect.value) {
                locSelect.classList.add('putaway-highlight');
                setTimeout(() => locSelect.classList.remove('putaway-highlight'), 2000);
            }
        } catch {
            if (locSelect.dataset.putawayRequestId !== putawayRequestId) return;
            locSelect.value = '';
            syncLocationSelectForWarehouse(locSelect);
        }
    }

    // --- LOCATION SUGGESTION (REAL DB) ---
    function openLocationSuggestion(btn) {
        const row = btn.closest('.line-row');
        const locSelect = row.querySelector('.loc-select, .putaway-loc-select, .loc-input');
        const itemSelect = row.querySelector('.item-select');
        if (!locSelect) {
            Swal.fire('Thiếu cấu hình dòng hàng', 'Dòng này chưa có trường vị trí hợp lệ để chọn lô/vị trí.', 'error');
            return;
        }
        const currentLocId = locSelect.value;
        const qtyRaw = parseCommaNumber(row.querySelector('input[name$=".TransactionQty"]').value);
        const itemId = itemSelect.value;
        
        const packOpt = row.querySelector('.packaging-select')?.selectedOptions[0];
        const giatri = parseFloat(packOpt?.dataset.giatri || 1);
        const qty = qtyRaw * giatri;
        
        // Get item name
        const selectedItemOption = itemSelect.options[itemSelect.selectedIndex];
        const itemName = selectedItemOption.text;
        
        if (!itemId || itemId === '') {
            if (typeof Swal !== 'undefined') {
                Swal.fire('Thiếu thông tin', 'Vui lòng chọn vật tư trước khi gợi ý vị trí.', 'warning');
            } else {
                enterpriseNotify({ title: 'Thiếu thông tin', text: 'Vui lòng chọn vật tư trước khi gợi ý vị trí.', icon: 'warning' });
            }
            return;
        }
        
        // Create modal
        let modal = document.getElementById('locationSuggestionModal');
        if (!modal) {
            modal = document.createElement('div');
            modal.id = 'locationSuggestionModal';
            modal.className = 'loc-suggest-backdrop';
            document.body.appendChild(modal);
        }
        
        modal.classList.add('is-open');
        if (modal.dataset.backdropBound !== 'true') {
            modal.addEventListener('click', (e) => {
                if (e.target === modal) modal.classList.remove('is-open');
            });
            modal.dataset.backdropBound = 'true';
        }
        modal.innerHTML = `
            <div class="loc-suggest-modal">
                <div class="loc-suggest-header">
                    <div>
                        <h5 class="loc-suggest-title">🔍 Gợi Ý Vị Trí</h5>
                        <p class="loc-suggest-sub">${escapeDocumentText(itemName)} — SL: ${formatVnNumber(qty)}</p>
                    </div>
                    <button type="button" class="loc-suggest-close" data-wms-close-modal="locationSuggestionModal">&times;</button>
                </div>
                <div class="loc-suggest-body loc-suggest-loading">
                    <i class="fas fa-spinner fa-spin loc-suggest-loading-icon"></i>
                    <p class="loc-suggest-loading-text">Đang tải dữ liệu...</p>
                </div>
            </div>
        `;
        
        // Lấy dữ liệu thật từ bộ xử lý nội bộ: xuất kho dùng danh sách vị trí đang có hàng, nhập kho dùng gợi ý vị trí cất.
        const isExport = @(Model.VoucherType == WMS.Models.VoucherTypeEnum.XuatKho ? "true" : "false");
        const apiUrl = isExport
            ? `${itemLocationsUrl}?itemId=${encodeURIComponent(itemId)}&requiredQty=${encodeURIComponent(qty)}${buildWarehouseQuery()}`
            : `${suggestedLocationsUrl}?itemId=${encodeURIComponent(itemId)}&qty=${encodeURIComponent(qty)}${buildWarehouseQuery()}`;
        fetchJsonOrThrow(apiUrl, 'Không tải được dữ liệu gợi ý vị trí.')
            .then(data => {
                data = Array.isArray(data) ? data : [];
                let tableRows = '';

                if (isExport) {
                    // XUẤT KHO: chỉ hiện ô đang chứa vật tư
                    if (data && data.length > 0) {
                        data.forEach(loc => {
                            const locId = safeLocationId(loc.locationId);
                            const locCodeText = escapeDocumentText(loc.locationCode);
                            const zoneText = escapeDocumentText(loc.zoneName);
                            const availableQty = Number(loc.availableQty ?? loc.quantity ?? 0);
                            const quantityText = formatVnNumber(availableQty);
                            const isRecommended = !!loc.isFefoRecommended;
                            const isEnough = loc.isEnough !== false;
                            const isSelected = String(loc.locationId ?? '') === currentLocId;
                            // FEFO indicators
                            let expiryText = 'Chưa có';
                            let expiryBadge = '';
                            if (loc.expiryDate) {
                                const dt = new Date(loc.expiryDate);
                                if (!isNaN(dt)) {
                                    const dd = String(dt.getDate()).padStart(2, '0');
                                    const mm = String(dt.getMonth() + 1).padStart(2, '0');
                                    const yyyy = dt.getFullYear();
                                    expiryText = `${dd}/${mm}/${yyyy}`;
                                    const today = new Date();
                                    const daysLeft = Math.ceil((dt - new Date(today.getFullYear(), today.getMonth(), today.getDate())) / (1000 * 60 * 60 * 24));
                                    if (daysLeft <= 0) {
                                        expiryBadge = `<span class="chip chip-danger loc-suggest-chip-offset">Hết hạn</span>`;
                                    } else if (daysLeft <= 30) {
                                        expiryBadge = `<span class="chip chip-warning loc-suggest-chip-offset">${daysLeft} ngày</span>`;
                                    }
                                }
                            }
                            const lotText = loc.lotNumber ? ` <span class="chip chip-info loc-suggest-lot-chip" title="Số lô">Lô: ${escapeDocumentText(loc.lotNumber)}</span>` : '';
                            const fefoBadge = isRecommended
                                ? '<span class="chip chip-success loc-suggest-chip-offset">Đề xuất FEFO</span>'
                                : '<span class="chip chip-muted loc-suggest-chip-offset">Cần lý do nếu chọn</span>';
                            const enoughBadge = isEnough
                                ? ''
                                : '<span class="chip chip-danger loc-suggest-chip-offset">Không đủ SL</span>';
                            const selectArgs = jsonArgsAttribute([
                                locId,
                                loc.locationCode || '',
                                loc.lotNumber || '',
                                normalizeInputDate(loc.expiryDate),
                                isRecommended,
                                availableQty,
                                isEnough
                            ]);
                            tableRows += `<tr class="loc-suggest-row ${isSelected ? 'is-selected' : ''}">
                                <td>${locCodeText}</td>
                                <td>${zoneText}</td>
                                <td class="loc-suggest-kpi">${quantityText}</td>
                                <td class="loc-suggest-nowrap">${expiryText}${expiryBadge}${lotText}${fefoBadge}${enoughBadge}</td>
                                <td class="loc-suggest-center">
                                    <button type="button" class="btn btn-sm btn-outline-primary" data-wms-call="selectSuggestedLocation" data-wms-json-args='${selectArgs}' ${isEnough ? '' : 'disabled'}>
                                        <i class="fas fa-check"></i> Chọn
                                    </button>
                                </td>
                            </tr>`;
                        });
                    }
                    if (!tableRows) {
                        tableRows = '<tr><td colspan="5" class="loc-suggest-empty"><i class="fas fa-box-open loc-suggest-empty-icon"></i>Vật tư này chưa có trong ô/vị trí nào!</td></tr>';
                    }
                    const contentHtml = `
                        <div class="loc-suggest-modal">
                            <div class="loc-suggest-header">
                                <div>
                                    <h5 class="loc-suggest-title">📦 Vị Trí Chứa Vật Tư</h5>
                                    <p class="loc-suggest-sub">${escapeDocumentText(itemName)}</p>
                                </div>
                                <button type="button" class="loc-suggest-close" data-wms-close-modal="locationSuggestionModal">&times;</button>
                            </div>
                            <div class="loc-suggest-body">
                                <table class="loc-suggest-table">
                                    <thead><tr>
                                        <th>Ô vị trí</th>
                                        <th>Khu</th>
                                        <th>Tồn khả dụng</th>
                                        <th>Lô/HSD/FEFO</th>
                                        <th class="loc-suggest-center">Chọn</th>
                                    </tr></thead>
                                    <tbody>${tableRows}</tbody>
                                </table>
                            </div>
                            <div class="loc-suggest-footer">
                                <button type="button" class="btn btn-sm btn-secondary" data-wms-close-modal="locationSuggestionModal">Đóng</button>
                            </div>
                        </div>
                    `;
                    modal.innerHTML = contentHtml;
                    window.enhanceDataWidths?.();
                } else {
                    // NHẬP KHO: hiện ô còn trống / sức chứa
                    if (data && data.length > 0) {
                        data.forEach(loc => {
                            if (loc.hasOtherItem) return;
                            const locId = safeLocationId(loc.locationId);
                            const locCodeText = escapeDocumentText(loc.locationCode);
                            const locCodeArg = suggestionArg(loc.locationCode);
                            const zoneText = escapeDocumentText(loc.zoneName);
                            const availableText = formatVnNumber(loc.available);
                            const fillPercent = safePercent(loc.fillPercent);
                            const isSelected = String(loc.locationId ?? '') === currentLocId;
                            const fillClass = fillPercent <= 70 ? 'loc-suggest-fill-ok' : fillPercent <= 90 ? 'loc-suggest-fill-warn' : 'loc-suggest-fill-danger';
                            const starIcon = loc.hasSameItem ? '<span title="Đã chứa cùng vật tư" class="loc-suggest-same-item">⭐</span> ' : '';
                            tableRows += `<tr class="loc-suggest-row ${isSelected ? 'is-selected' : ''}">
                                <td>${starIcon}${locCodeText}</td>
                                <td>${zoneText}</td>
                                <td>${availableText}</td>
                                <td><div class="loc-suggest-fill"><div class="loc-suggest-fill-track"><div class="loc-suggest-fill-bar ${fillClass}" data-progress-width="${fillPercent}%"></div></div><span class="loc-suggest-fill-text">${fillPercent}%</span></div></td>
                                <td class="loc-suggest-center"><button type="button" class="btn btn-sm btn-outline-primary" data-wms-call="selectSuggestedLocation" data-wms-arg="${locId}" data-wms-arg2="${locCodeText}"><i class="fas fa-check"></i> Chọn</button></td>
                            </tr>`;
                        });
                    }
                    if (!tableRows) { tableRows = '<tr><td colspan="5" class="loc-suggest-empty">Không tìm thấy vị trí phù hợp</td></tr>'; }
                    const bestLoc = data.length > 0 ? data[0] : null;
                    const contentHtml = `
                        <div class="loc-suggest-modal">
                            <div class="loc-suggest-header">
                                <div>
                                    <h5 class="loc-suggest-title">🔍 Gợi Ý Vị Trí</h5>
                                    <p class="loc-suggest-sub">${escapeDocumentText(itemName)} — SL: ${formatVnNumber(qty)}</p>
                                </div>
                                <button type="button" class="loc-suggest-close" data-wms-close-modal="locationSuggestionModal">&times;</button>
                            </div>
                            <div class="loc-suggest-body">
                                <div class="loc-suggest-hint"><span class="loc-suggest-same-item">⭐</span> = Ô đã chứa cùng vật tư (ưu tiên cao)</div>
                                <table class="loc-suggest-table">
                                    <thead><tr>
                                        <th>Ô</th>
                                        <th>Khu</th>
                                        <th>Còn trống</th>
                                        <th>% đầy</th>
                                        <th class="loc-suggest-center">Chọn</th>
                                    </tr></thead>
                                    <tbody>${tableRows}</tbody>
                                </table>
                            </div>
                            <div class="loc-suggest-footer">
                                ${bestLoc ? `<button type="button" class="btn btn-sm btn-success" data-wms-call="selectSuggestedLocation" data-wms-arg="${safeLocationId(bestLoc.locationId)}" data-wms-arg2="${escapeDocumentText(bestLoc.locationCode)}">📦 Tự động phân bổ</button>` : ''}
                                <button type="button" class="btn btn-sm btn-secondary" data-wms-close-modal="locationSuggestionModal">Đóng</button>
                            </div>
                        </div>
                    `;
                    modal.innerHTML = contentHtml;
                    window.enhanceDataWidths?.();
                }

                // Store reference to location select
                modal.dataset.locSelectName = locSelect.getAttribute('name') || '';
            })
            .catch(err => {
                modal.innerHTML = `
                    <div class="loc-suggest-modal loc-suggest-error">
                        <i class="fas fa-circle-exclamation loc-suggest-error-icon"></i>
                        <div class="fw-700 loc-suggest-error-message">${escapeDocumentText(err?.message || 'Lỗi tải dữ liệu gợi ý')}</div>
                        <button type="button" class="btn btn-sm btn-secondary" data-wms-close-modal="locationSuggestionModal">Đóng</button>
                    </div>
                `;
            });
        
        // Store which loc select we're modifying
        window._currentLocSelect = locSelect;
        window._currentLocationRow = row;
        
    }
    
    async function selectSuggestedLocation(locationId, locationCode, lotNumber, expiryDate, isFefoRecommended = true, availableQty = 0, isEnough = true) {
        if (window._currentLocSelect) {
            const target = window._currentLocSelect;
            const row = window._currentLocationRow || target.closest('tr');
            if (isEnough === false) {
                Swal.fire('Không đủ tồn khả dụng', `Vị trí ${locationCode || locationId} chỉ còn ${formatVnNumber(availableQty)} theo lô đã chọn. Vui lòng chọn dòng khác hoặc giảm số lượng xuất.`, 'warning');
                return;
            }

            let overrideReason = '';
            if (isSourceStockVoucherJs && target.classList.contains('loc-input') && !isFefoRecommended) {
                if (!canOverrideFefoJs) {
                    Swal.fire('Không đúng quyền', 'Chỉ quản lý kho hoặc quản trị viên được chọn khác lô/vị trí FEFO.', 'warning');
                    return;
                }

                const promptResult = await Swal.fire({
                    title: 'Nhập lý do đổi lô/vị trí',
                    input: 'textarea',
                    inputLabel: 'Dòng bạn chọn khác đề xuất FEFO. Vui lòng ghi rõ lý do để lưu audit.',
                    inputPlaceholder: 'Ví dụ: lô FEFO đang khóa kiểm phẩm thực tế, cần xuất lô kế tiếp...',
                    inputAttributes: { maxlength: 300 },
                    showCancelButton: true,
                    confirmButtonText: 'Xác nhận chọn',
                    cancelButtonText: 'Hủy',
                    inputValidator: value => !value || !value.trim() ? 'Vui lòng nhập lý do đổi lô/vị trí.' : undefined
                });
                if (!promptResult.isConfirmed) return;
                overrideReason = (promptResult.value || '').trim();
            }

            target.value = locationId;
            if (target.classList.contains('loc-input')) {
                const lotInput = row?.querySelector('.source-lot-input');
                const expiryInput = row?.querySelector('.source-expiry-input');
                const reasonInput = row?.querySelector('.fefo-override-reason-input');
                if (lotInput) lotInput.value = lotNumber || '';
                if (expiryInput) expiryInput.value = normalizeInputDate(expiryDate);
                if (reasonInput) reasonInput.value = overrideReason;
                renderSourceSelectionNote(row, locationCode, lotNumber, expiryDate, isFefoRecommended, overrideReason);
            } else {
                validateLocation(target);
            }
        }
        document.getElementById('locationSuggestionModal')?.classList.remove('is-open');
    }

    async function validateLocation(locSelect) {
        const row = locSelect.closest('tr');
        const locId = locSelect.value;
        const itemSelect = row.querySelector('.item-select');
        const itemId = itemSelect.value;
        const itemText = itemSelect.selectedOptions[0]?.text.trim() || "Vật tư";

        if (!locId || !itemId) return;

        // 1. Check same-form conflicts
        let conflictInForm = false;
        let conflictItemName = "";
        document.querySelectorAll('.line-row').forEach(otherRow => {
            if (otherRow === row) return;
            const otherLocSelect = otherRow.querySelector('.loc-select');
            const otherItemSelect = otherRow.querySelector('.item-select');
            
            if (otherLocSelect && otherLocSelect.value === locId) {
                if (otherItemSelect.value && otherItemSelect.value !== itemId) {
                    conflictInForm = true;
                    // Get name
                    conflictItemName = otherItemSelect.selectedOptions[0]?.text.trim();
                }
            }
        });

        if (conflictInForm) {
            if (typeof Swal !== 'undefined') {
                Swal.fire('Xung đột vị trí', `Vị trí ${locSelect.selectedOptions[0].text} đang được dùng để xếp [${conflictItemName}] ở dòng khác trong phiếu này. Tránh xếp chung 2 vật tư vào 1 ô/bồn.`, 'warning');
            } else {
                enterpriseNotify({ title: 'Xung đột vị trí', text: `Vị trí ${locSelect.selectedOptions[0].text} đang được dùng để xếp [${conflictItemName}] ở dòng khác trong phiếu này.`, icon: 'warning' });
            }
            locSelect.value = ''; // Reset
            return;
        }

        // 2. Check DB conflicts
        try {
            const res = await fetchJsonOrThrow(`${locationConflictUrl}?locationId=${encodeURIComponent(locId)}&itemId=${encodeURIComponent(itemId)}`, 'Không kiểm tra được xung đột vị trí.');
            if (res.conflict) {
                if (typeof Swal !== 'undefined') {
                    Swal.fire('Vị trí đã có hàng', `Vị trí ${locSelect.selectedOptions[0].text} đang chứa ${res.conflictItemName}. Không thể xếp [${itemText}] chung vào đây.`, 'error');
                } else {
                    enterpriseNotify({ title: 'Vị trí đã có hàng', text: `Vị trí ${locSelect.selectedOptions[0].text} đang chứa ${res.conflictItemName}.`, icon: 'error' });
                }
                locSelect.value = '';
            }
        } catch (err) {
            if (typeof Swal !== 'undefined') {
                Swal.fire('Không kiểm tra được vị trí', err?.message || 'Có lỗi xảy ra khi kiểm tra xung đột vị trí.', 'error');
            } else {
                enterpriseNotify({ title: 'Không kiểm tra được vị trí', text: err?.message || 'Có lỗi xảy ra khi kiểm tra xung đột vị trí.', icon: 'error' });
            }
        }
    }

    function clearVoucherFieldValidation(element) {
        if (!element || !element.name || !element.form) return;
        if (typeof element.setCustomValidity === 'function') {
            element.setCustomValidity('');
        }
        element.removeAttribute('aria-invalid');
        element.classList.remove('input-validation-error');

        if (typeof $ !== 'undefined') {
            const validator = $(element.form).data('validator');
            if (validator) {
                if (validator.invalid) {
                    delete validator.invalid[element.name];
                }
                if (typeof validator.showErrors === 'function') {
                    const cleared = {};
                    cleared[element.name] = null;
                    validator.showErrors(cleared);
                }
            }
        }
    }

    const voucherForm = document.getElementById('voucherForm');
    voucherForm.addEventListener('input', function(e) {
        if (e.target instanceof HTMLElement) {
            clearVoucherFieldValidation(e.target);
        }
    });
    voucherForm.addEventListener('change', function(e) {
        if (e.target instanceof HTMLElement) {
            clearVoucherFieldValidation(e.target);
        }
    });

    // --- FORM SUBMIT ---
    voucherForm.addEventListener('submit', function(e) {
        if (this.dataset.submitting === 'true') {
            e.preventDefault();
            return;
        }

        // Tự động dọn dẹp các dòng trống (nếu có) trước khi kiểm tra lỗi
        const tbody = document.getElementById('linesContainer');
        const rows = tbody.querySelectorAll('.line-row');
        if (rows.length > 1) {
            let removedAny = false;
            for (let i = rows.length - 1; i >= 0; i--) {
                const r = rows[i];
                const itemSelect = r.querySelector('.item-select');
                const qtyInput = r.querySelector('.qty-input');
                if (itemSelect && qtyInput && !itemSelect.value && (!qtyInput.value || qtyInput.value === "0")) {
                    // Nếu dòng hoàn toàn trống và không phải dòng duy nhất
                    if (tbody.querySelectorAll('.line-row').length > 1) {
                        $(r).find('.item-select, .source-uom-select').each(function() {
                            if ($(this).hasClass('select2-hidden-accessible')) {
                                $(this).select2('destroy');
                            }
                        });
                        r.remove();
                        removedAny = true;
                    }
                }
            }
            if (removedAny) {
                // Đánh lại số thứ tự index để MVC Binding không bị lỗi
                const remainingRows = tbody.querySelectorAll('.line-row');
                remainingRows.forEach((r, idx) => {
                    r.querySelectorAll('[name]').forEach(el => {
                        el.name = el.name.replace(/\[\d+\]/, `[${idx}]`);
                    });
                });
                lineIdx = remainingRows.length;
            }
        }

        let isValid = true;
        
        // Thêm fallback an toàn trong trường hợp jQuery validation chưa load kịch bản 
        if (typeof $ !== 'undefined' && $.fn && $.fn.valid) {
            const validator = $(this).data('validator');
            if (validator && typeof validator.resetForm === 'function') {
                validator.resetForm();
                $(this).find('.input-validation-error').removeClass('input-validation-error');
            }
            isValid = $(this).valid();
        }

        // Custom validation: PartnerId required only when partner field is visible
        const requiredPartner = this.querySelector('select[name="PartnerId"].partner-select-validate');
        const partnerDiv = document.getElementById('partnerFieldDiv');
        const partnerVisible = partnerDiv && partnerDiv.style.display !== 'none';
        if (requiredPartner && partnerVisible && (!requiredPartner.value || requiredPartner.value === "")) {
            e.preventDefault();
            if (typeof Swal !== 'undefined') {
                Swal.fire('Thiếu thông tin', partnerRequiredMessage, 'warning');
            } else {
                enterpriseNotify({ title: 'Thiếu thông tin', text: partnerRequiredMessage, icon: 'warning' });
            }
            requiredPartner.focus();
            return;
        }

        const ownershipMode = this.querySelector('input[name="InventoryOwnershipMode"]:checked')?.value || 'Internal';
        const ownerSelect = this.querySelector('select[name="OwnerPartnerId"]');
        if (ownershipMode === 'ThreePl' && ownerSelect && (!ownerSelect.value || ownerSelect.value === "")) {
            e.preventDefault();
            if (typeof Swal !== 'undefined') {
                Swal.fire('Thiếu thông tin', ownerRequiredMessage, 'warning');
            } else {
                enterpriseNotify({ title: 'Thiếu thông tin', text: ownerRequiredMessage, icon: 'warning' });
            }
            ownerSelect.focus();
            return;
        }

        if (isValid && !e.defaultPrevented) {
            const submitter = e.submitter instanceof HTMLButtonElement
                ? e.submitter
                : document.getElementById('submitBtn');
            if (submitter) {
                if (submitter.name) {
                    this.querySelectorAll('input[data-submit-intent="true"]').forEach(input => input.remove());
                    const submitIntent = document.createElement('input');
                    submitIntent.type = 'hidden';
                    submitIntent.name = submitter.name;
                    submitIntent.value = submitter.value;
                    submitIntent.dataset.submitIntent = 'true';
                    this.appendChild(submitIntent);
                }
                submitter.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Đang xử lý...';
            }
            this.dataset.submitting = 'true';
            this.querySelectorAll('button[type="submit"]').forEach(button => { button.disabled = true; });
        } else {
            document.getElementById('validationSummary').style.display = 'block';
            e.preventDefault();
        }
    });

    // ============================================================
    // TÍCH HỢP THIẾT BỊ QUÉT MÃ VẠCH
    // Thiết bị quét USB/Bluetooth hoạt động giống bàn phím:
    //   1. Thiết bị nhập nhanh chuỗi mã vạch
    //   2. Sau đó gửi phím Enter
    //   3. Ô nhập cần được lấy tiêu điểm để nhận mã
    // ============================================================
    document.querySelectorAll('input[name="InventoryOwnershipMode"]').forEach(radio => {
        radio.addEventListener('change', syncInventoryOwnershipMode);
    });
    syncInventoryOwnershipMode();
    initializeExportTabs();
    syncAllLocationSelectsForWarehouse();
    document.querySelectorAll('.line-row .item-select').forEach(select => {
        if (select.value) {
            itemChanged(select);
        } else {
            const sourceUomSelect = select.closest('.line-row')?.querySelector('.source-uom-select');
            if (sourceUomSelect) {
                resetSourceUomOptions(sourceUomSelect);
            }
        }
    });
    const bInput = document.getElementById('barcodeInput');

    // Tự lấy tiêu điểm khi tải trang
    if (bInput) {
        bInput.focus({ preventScroll: true });

        // Lấy lại tiêu điểm khi bấm vào vùng trống trên trang
        document.addEventListener('click', function(e) {
            // Bỏ qua khi bấm vào ô tìm kiếm select2 hoặc thành phần select2
            if (e.target.closest('.select2-container')) return;

            if (e.target.tagName !== 'INPUT' && e.target.tagName !== 'SELECT' && e.target.tagName !== 'TEXTAREA' && e.target.tagName !== 'BUTTON') {
                bInput.focus({ preventScroll: true });
            }
        });

        // Xử lý mã vạch khi người dùng nhấn Enter từ thiết bị quét hoặc nhập tay
        bInput.addEventListener('keypress', async function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                const barcode = this.value.trim();
                this.value = '';
                if (barcode) {
                    // Nháy đèn trạng thái
                    const led = document.getElementById('scannerLed');
                    if (led) {
                        led.style.background = '#fbbf24';
                        led.style.boxShadow = '0 0 8px #fbbf24';
                    }
                    
                    await processBarcode(barcode);
                    
                    // Đưa đèn trạng thái về bình thường
                    if (led) {
                        setTimeout(() => {
                            led.style.background = '#10b981';
                            led.style.boxShadow = '0 0 6px #10b981';
                        }, 500);
                    }
                }
                // Luôn lấy lại tiêu điểm cho lần quét tiếp theo
                this.focus();
            }
        });
    }

    // --- XỬ LÝ MÃ VẠCH CHÍNH ---
    async function processBarcode(barcode) {
        if (!barcode) return false;
        const busy = window.wmsLoading?.begin(
            document.querySelector('.barcode-input-wrap') || document.getElementById('barcodeInput'),
            { text: 'Đang tra mã vạch...', delay: 700, disable: false }
        );

        try {
            const res = await fetch(`${itemByBarcodeUrl}?barcode=${encodeURIComponent(barcode)}`);
            const raw = await res.text();
            let payload = null;
            if (raw) {
                try {
                    payload = JSON.parse(raw);
                } catch {
                    if (res.ok) throw new Error('Máy chủ trả về dữ liệu mã vạch không hợp lệ.');
                }
            }

            if (res.ok && payload) {
                const item = payload;
                // Check if already in list → increment quantity
                let foundRow = null;
                document.querySelectorAll('.line-row').forEach(row => {
                    const select = row.querySelector('.item-select');
                    if (select.value == item.itemId) foundRow = row;
                });

                if (foundRow) {
                    // DUPLICATE SCAN → increment qty
                    const qtyInput = foundRow.querySelector('input[name$=".TransactionQty"]');
                    const newQty = parseCommaNumber(qtyInput.value) + 1;
                    qtyInput.value = formatWithCommas(newQty.toString());
                    
                    foundRow.classList.remove('scan-row-highlight');
                    void foundRow.offsetWidth; // Force reflow
                    foundRow.classList.add('scan-row-highlight');

                    beepDuplicate();
                    updateScanCount();
                    showScanToast(`✓ ${item.itemCode} — SL tăng lên ${newQty}`, 'duplicate');
                    return true;
                }

                // NEW ITEM → add to table
                const tbody = document.getElementById('linesContainer');
                let firstRow = tbody.querySelector('.line-row');
                let isFirstBlank = firstRow && firstRow.querySelector('.item-select').value === "";
                
                let targetRow = isFirstBlank ? firstRow : null;
                if (!targetRow) {
                    addRow();
                    const rows = document.querySelectorAll('.line-row');
                    targetRow = rows[rows.length - 1];
                }

                const select = targetRow.querySelector('.item-select');
                syncItemSelect2(select, item.itemId);
                itemChanged(select); 
                
                targetRow.querySelector('input[name$=".TransactionQty"]').value = 1;
                calculateRowPrice(targetRow);

                // Highlight the new row
                targetRow.classList.add('scan-row-highlight');

                beepSuccess();
                updateScanCount();
                showScanToast(`✓ Đã thêm: [${item.itemCode}] ${item.itemName}`, 'success');
                return true;

            } else {
                // NOT FOUND
                beepError();
                showScanToast(`✗ ${payload?.message || `Không tìm thấy vật tư với mã: ${barcode}`}`, 'error');
                return false;
            }
        } catch (err) {
            beepError();
            showScanToast(`✗ ${err?.message || 'Lỗi kết nối — thử lại'}`, 'error');
            return false;
        } finally {
            window.wmsLoading?.end(busy);
        }
    }

    // --- WEBCAM SCANNER (camera on mobile) ---
    function toggleWebcamScanner() {
        openScannerModal(async (decodedText) => {
            const success = await processBarcode(decodedText);
            const statusEl = document.getElementById('scanStatus');
            if (statusEl) {
                if (success) {
                    statusEl.textContent = '✓ Đã thêm: ' + decodedText + ' — Tiếp tục quét...';
                    statusEl.style.color = 'var(--accent, #10b981)';
                } else {
                    statusEl.textContent = '✗ Không tìm thấy: ' + decodedText;
                    statusEl.style.color = 'var(--danger, #e53e3e)';
                }
                statusEl.style.display = 'block';
            }
        });
    }


    function normalizeInputDate(value) {
        if (!value) return '';
        const text = String(value).trim();
        if (!text) return '';
        if (/^\d{4}-\d{2}-\d{2}/.test(text)) return text.substring(0, 10);
        const parsed = new Date(text);
        if (Number.isNaN(parsed.getTime())) return '';
        return new Intl.DateTimeFormat('en-CA', {
            timeZone: 'Asia/Ho_Chi_Minh',
            year: 'numeric',
            month: '2-digit',
            day: '2-digit'
        }).format(parsed);
    }

    function escapeDocumentText(value) {
        return String(value ?? '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    function suggestionArg(value) {
        return escapeDocumentText(JSON.stringify(String(value ?? '')));
    }

    function safeLocationId(value) {
        const id = Number.parseInt(value, 10);
        return Number.isFinite(id) && id > 0 ? id : 0;
    }

    function safePercent(value) {
        const percent = Number(value);
        if (!Number.isFinite(percent)) return 0;
        return Math.max(0, Math.min(100, Math.round(percent)));
    }

    function formatVnNumber(value) {
        const number = Number(value);
        return Number.isFinite(number) ? number.toLocaleString('vi-VN') : '0';
    }

    function formatSuggestionDate(value) {
        const normalized = normalizeInputDate(value);
        if (!normalized) return '';
        const parts = normalized.split('-');
        return parts.length === 3 ? `${parts[2]}/${parts[1]}/${parts[0]}` : normalized;
    }

    function jsonArgsAttribute(args) {
        return escapeDocumentText(JSON.stringify(args));
    }

    function clearSourceSelectionForRow(row) {
        if (!row) return;
        const locInput = row.querySelector('.loc-input');
        const lotInput = row.querySelector('.source-lot-input');
        const expiryInput = row.querySelector('.source-expiry-input');
        const reasonInput = row.querySelector('.fefo-override-reason-input');
        const note = row.querySelector('.source-fefo-note');
        if (locInput) locInput.value = '';
        if (lotInput) lotInput.value = '';
        if (expiryInput) expiryInput.value = '';
        if (reasonInput) reasonInput.value = '';
        if (note) note.textContent = '';
    }

    function renderSourceSelectionNote(row, locationCode, lotNumber, expiryDate, isFefoRecommended, overrideReason) {
        const note = row?.querySelector('.source-fefo-note');
        if (!note) return;
        const parts = [];
        if (locationCode) parts.push(`Vị trí ${locationCode}`);
        if (lotNumber) parts.push(`lô ${lotNumber}`);
        if (expiryDate) parts.push(`HSD ${formatSuggestionDate(expiryDate)}`);
        const status = isFefoRecommended ? 'Đề xuất FEFO' : `Đổi FEFO${overrideReason ? ': ' + overrideReason : ''}`;
        note.textContent = parts.length ? `${status} · ${parts.join(' · ')}` : status;
        note.classList.toggle('is-override', !isFefoRecommended);
    }

    function isReadyDocumentLine(item) {
        const matched = item.IsMatched ?? item.isMatched ?? !!(item.ItemId ?? item.itemId);
        const review = item.RequiresReview ?? item.requiresReview ?? false;
        return matched && !review && !!(item.ItemId ?? item.itemId);
    }

    function getDocumentValue(source, ...names) {
        if (!source) return null;
        for (const name of names) {
            if (Object.prototype.hasOwnProperty.call(source, name) && source[name] !== undefined && source[name] !== null) {
                return source[name];
            }
        }
        return null;
    }

    function getDocumentHeader(document) {
        return getDocumentValue(document, 'Header', 'header') || {};
    }

    function getDocumentLines(document) {
        const lines = getDocumentValue(document, 'Lines', 'lines');
        return Array.isArray(lines) ? lines : [];
    }

    function getDocumentReference(document) {
        const header = getDocumentHeader(document);
        return getDocumentValue(document, 'ReferenceNo', 'referenceNo')
            || getDocumentValue(header, 'ReferenceNo', 'referenceNo')
            || 'Chưa có số chứng từ';
    }

    function canSelectDocument(document) {
        const header = getDocumentHeader(document);
        const referenceNo = getDocumentValue(document, 'ReferenceNo', 'referenceNo')
            || getDocumentValue(header, 'ReferenceNo', 'referenceNo');
        return !!String(referenceNo || '').trim()
            || getDocumentLines(document).some(isReadyDocumentLine);
    }

    function getDocumentVoucherDate(document) {
        const header = getDocumentHeader(document);
        return normalizeInputDate(
            getDocumentValue(document, 'VoucherDate', 'voucherDate')
            || getDocumentValue(header, 'VoucherDate', 'voucherDate')
        );
    }

    function getDocumentSourceFiles(document) {
        const files = getDocumentValue(document, 'SourceFiles', 'sourceFiles');
        return Array.isArray(files) ? files : [];
    }

    function getDocumentDuplicateFiles(document) {
        const files = getDocumentValue(document, 'DuplicateDocumentFiles', 'duplicateDocumentFiles');
        return Array.isArray(files) ? files : [];
    }

    function getDocumentWarnings(document) {
        const warnings = getDocumentValue(document, 'Warnings', 'warnings');
        return Array.isArray(warnings) ? warnings : [];
    }

    function normalizeDocumentKeyPart(value) {
        return String(value ?? '').trim().toUpperCase().replace(/\s+/g, ' ');
    }

    function buildDocumentLineKey(item) {
        const documentNumber = getDocumentValue(item, 'DocumentNumber', 'documentNumber', 'OcrDocumentNumber', 'ocrDocumentNumber') || '';
        const itemPart = getDocumentValue(item, 'ItemId', 'itemId', 'ItemCode', 'itemCode', 'SuggestedItemCode', 'suggestedItemCode') || '';
        const uomPart = getDocumentValue(item, 'TransactionUomId', 'transactionUomId', 'UnitName', 'unitName') || '';
        const lotPart = getDocumentValue(item, 'LotNumber', 'lotNumber') || '';
        const mfgPart = normalizeInputDate(getDocumentValue(item, 'ManufacturingDate', 'manufacturingDate'));
        const expPart = normalizeInputDate(getDocumentValue(item, 'ExpiryDate', 'expiryDate'));
        const qtyPart = getDocumentValue(item, 'Quantity', 'quantity') || '';
        return [
            documentNumber,
            itemPart,
            uomPart,
            lotPart,
            mfgPart,
            expPart,
            qtyPart
        ].map(normalizeDocumentKeyPart).join('__');
    }

    function mergeReadyDocumentLines(items) {
        const map = new Map();
        for (const item of items) {
            const key = buildDocumentLineKey(item);
            if (!map.has(key)) map.set(key, { ...item });
        }
        return Array.from(map.values());
    }

    function buildDocumentHeaderChips(header, document) {
        const fields = [];
        const add = (label, value) => {
            if (value !== null && value !== undefined && String(value).trim() !== '') {
                fields.push(`<span class="doc-preview-chip">${escapeDocumentText(label)}: ${escapeDocumentText(value)}</span>`);
            }
        };
        add('Số chứng từ', getDocumentValue(document, 'ReferenceNo', 'referenceNo') || getDocumentValue(header, 'ReferenceNo', 'referenceNo'));
        add('Ngày chứng từ', getDocumentVoucherDate(document));
        add(isInboundVoucherJs ? 'Nhà cung cấp' : 'Khách hàng/nơi nhận', getDocumentValue(header, 'PartnerName', 'partnerName', 'PartnerCode', 'partnerCode'));
        add(isInboundVoucherJs ? 'Kho nhận' : 'Kho xuất', getDocumentValue(header, 'WarehouseName', 'warehouseName', 'WarehouseCode', 'warehouseCode'));
        add('Chủ hàng', getDocumentValue(header, 'OwnerPartnerName', 'ownerPartnerName', 'OwnerPartnerCode', 'ownerPartnerCode'));
        add(isInboundVoucherJs ? 'Người giao/tài xế' : 'Người nhận/tài xế', getDocumentValue(header, 'DriverName', 'driverName'));
        add('Phương tiện', getDocumentValue(header, 'VehicleNumber', 'vehicleNumber'));
        add('Ghi chú', getDocumentValue(header, 'Description', 'description'));
        return fields.join('');
    }

    function buildDocumentLineRows(lines) {
        return lines.slice(0, 8).map(line => {
            const ready = isReadyDocumentLine(line);
            const code = getDocumentValue(line, 'ItemCode', 'itemCode', 'SuggestedItemCode', 'suggestedItemCode') || '';
            const name = getDocumentValue(line, 'ItemName', 'itemName', 'SuggestedItemName', 'suggestedItemName') || '';
            const quantity = getDocumentValue(line, 'Quantity', 'quantity') || '';
            const unit = getDocumentValue(line, 'UnitName', 'unitName') || '';
            const lot = getDocumentValue(line, 'LotNumber', 'lotNumber') || '';
            const status = ready ? 'Đã khớp' : 'Cần chọn vật tư';
            const badgeClass = ready ? 'ready' : 'review';
            const lineWarnings = getDocumentValue(line, 'Warnings', 'warnings') || [];
            return `
                <tr>
                    <td>${escapeDocumentText(code)}</td>
                    <td>${escapeDocumentText(name)}</td>
                    <td>${escapeDocumentText(quantity)}</td>
                    <td>${escapeDocumentText(unit)}</td>
                    <td>${escapeDocumentText(lot)}</td>
                    <td><span class="doc-status-badge ${badgeClass}">${status}</span>${lineWarnings.length ? `<div class="doc-preview-line-warning">${escapeDocumentText(lineWarnings[0])}</div>` : ''}</td>
                </tr>`;
        }).join('');
    }

    function buildDocumentBatchPreviewHtml(batch) {
        const documents = Array.isArray(batch?.documents) ? batch.documents : [];
        const batchWarnings = Array.isArray(batch?.warnings) ? batch.warnings : [];
        const totalReady = documents.reduce((sum, doc) => sum + getDocumentLines(doc).filter(isReadyDocumentLine).length, 0);
        const duplicateFileCount = Number(batch?.duplicateFileCount || 0);
        const duplicateDocumentCount = Number(batch?.duplicateDocumentCount || 0);
        const documentCards = documents.map((document, index) => {
            const header = getDocumentHeader(document);
            const lines = getDocumentLines(document);
            const readyLines = lines.filter(isReadyDocumentLine);
            const reviewLines = lines.filter(line => !isReadyDocumentLine(line));
            const referenceNo = getDocumentReference(document);
            const sourceFiles = getDocumentSourceFiles(document);
            const duplicateFiles = getDocumentDuplicateFiles(document);
            const warnings = getDocumentWarnings(document);
            const selectable = canSelectDocument(document);
            const checked = documents.length === 1 && selectable ? 'checked' : '';
            const disabled = selectable ? '' : 'disabled';
            const sourceFilesHtml = sourceFiles.length
                ? `<div class="doc-source-files">File: ${sourceFiles.map(escapeDocumentText).join(', ')}</div>`
                : '';
            const duplicateHtml = duplicateFiles.length
                ? `<div class="doc-preview-warning compact">Chứng từ trùng đã bỏ qua: ${duplicateFiles.map(escapeDocumentText).join(', ')}</div>`
                : '';
            const warningHtml = warnings.length
                ? `<div class="doc-preview-warning compact">${warnings.slice(0, 3).map(w => `<div>• ${escapeDocumentText(w)}</div>`).join('')}</div>`
                : '';
            return `
                <label class="doc-document-card ${checked ? 'selected' : ''} ${selectable ? '' : 'disabled'}" data-doc-card aria-disabled="${selectable ? 'false' : 'true'}">
                    <input type="radio" name="wmsOcrDocumentChoice" value="${index}" ${checked} ${disabled} />
                    <div class="doc-document-main">
                        <div class="doc-document-title-row">
                            <strong>${escapeDocumentText(referenceNo)}</strong>
                            <span class="doc-preview-chip doc-preview-chip-ready">${readyLines.length} dòng áp dụng</span>
                            <span class="doc-preview-chip doc-preview-chip-review">${reviewLines.length} dòng cần kiểm tra</span>
                        </div>
                        ${selectable ? '' : '<div class="doc-preview-warning compact">Không thể áp dụng: chứng từ chưa có số và chưa có dòng vật tư đủ điều kiện.</div>'}
                        ${sourceFilesHtml}
                        <div class="doc-preview-chip-row">${buildDocumentHeaderChips(header, document)}</div>
                        ${duplicateHtml}
                        ${warningHtml}
                        <div class="doc-preview-table-wrap">
                            <table class="doc-preview-table">
                                <thead>
                                    <tr>
                                        <th>Mã</th>
                                        <th>Tên vật tư</th>
                                        <th>SL gốc</th>
                                        <th>ĐVT</th>
                                        <th>Số lô</th>
                                        <th>Kết quả</th>
                                    </tr>
                                </thead>
                                <tbody>${buildDocumentLineRows(lines) || '<tr><td colspan="6" class="doc-preview-empty">Chưa có dòng nào đủ rõ để đề xuất.</td></tr>'}</tbody>
                            </table>
                        </div>
                        ${lines.length > 8 ? `<div class="doc-preview-more">Đang hiển thị 8/${lines.length} dòng đầu tiên của chứng từ này.</div>` : ''}
                    </div>
                </label>`;
        }).join('');

        const warningHtml = batchWarnings.length
            ? `<div class="doc-preview-warning">
                    ${batchWarnings.slice(0, 6).map(w => `<div>• ${escapeDocumentText(w)}</div>`).join('')}
                    ${batchWarnings.length > 6 ? `<div>• Còn ${batchWarnings.length - 6} cảnh báo khác...</div>` : ''}
               </div>`
            : '';

        return `
            <div class="doc-preview-body doc-preview-batch-body">
                <div class="doc-preview-chip-row">
                    <span class="doc-preview-chip doc-preview-chip-status">Chứng từ hợp lệ: ${documents.length}</span>
                    <span class="doc-preview-chip doc-preview-chip-ready">Dòng có thể áp dụng: ${totalReady}</span>
                    <span class="doc-preview-chip doc-preview-chip-review">File trùng: ${duplicateFileCount}</span>
                    <span class="doc-preview-chip doc-preview-chip-confidence">Chứng từ trùng: ${duplicateDocumentCount}</span>
                </div>
                ${documents.length > 1 ? '<div class="doc-preview-note doc-selection-note">Có nhiều số chứng từ khác nhau. Vui lòng chọn đúng một chứng từ để áp dụng vào phiếu hiện tại.</div>' : ''}
                <div class="doc-document-list">${documentCards || '<div class="doc-preview-empty">Không có chứng từ hợp lệ để áp dụng.</div>'}</div>
                ${warningHtml}
                <div class="doc-preview-note">Hệ thống chỉ áp dụng header vào trường còn trống hoặc khi bạn xác nhận dùng dữ liệu OCR. Dòng trùng hoặc chứng từ trùng không được cộng dồn số lượng.</div>
            </div>`;
    }

    function buildDocumentPreviewHtml(lines, warnings, confidence, parseStatus) {
        const readyLines = lines.filter(isReadyDocumentLine);
        const reviewLines = lines.filter(line => !isReadyDocumentLine(line));
        const visibleLines = lines.slice(0, 12);
        const headers = getPendingDocumentHeaders();
        const headerRows = headers.map(entry => {
            const fields = [];
            const header = entry.header || {};
            const add = (label, value) => {
                if (value !== null && value !== undefined && String(value).trim() !== '') {
                    fields.push(`<span class="doc-preview-chip">${escapeDocumentText(label)}: ${escapeDocumentText(value)}</span>`);
                }
            };
            add('Số chứng từ', header.ReferenceNo ?? header.referenceNo);
            add('Ngày chứng từ', normalizeInputDate(header.VoucherDate ?? header.voucherDate));
            add(isInboundVoucherJs ? 'Nhà cung cấp' : 'Khách hàng/nơi nhận', header.PartnerName ?? header.partnerName ?? header.PartnerCode ?? header.partnerCode);
            add(isInboundVoucherJs ? 'Kho nhận' : 'Kho xuất', header.WarehouseName ?? header.warehouseName ?? header.WarehouseCode ?? header.warehouseCode);
            add('Chủ hàng', header.OwnerPartnerName ?? header.ownerPartnerName ?? header.OwnerPartnerCode ?? header.ownerPartnerCode);
            add(isInboundVoucherJs ? 'Người giao/tài xế' : 'Người nhận/tài xế', header.DriverName ?? header.driverName);
            add('Phương tiện', header.VehicleNumber ?? header.vehicleNumber);
            add('Ghi chú', header.Description ?? header.description);
            const skipped = entry.skipCount > 0 ? `<div class="doc-preview-header-note">Có ${entry.skipCount} trường header không áp dụng tự động vì form đã có dữ liệu hoặc chưa khớp danh mục.</div>` : '';
            return fields.length
                ? `<div class="doc-preview-header-block"><div class="doc-preview-header-title">${escapeDocumentText(entry.fileName || 'Header chứng từ')}</div><div class="doc-preview-chip-row">${fields.join('')}</div>${skipped}</div>`
                : '';
        }).join('');
        const lineRows = visibleLines.map(line => {
            const ready = isReadyDocumentLine(line);
            const code = line.ItemCode ?? line.itemCode ?? line.SuggestedItemCode ?? line.suggestedItemCode ?? '';
            const name = line.ItemName ?? line.itemName ?? line.SuggestedItemName ?? line.suggestedItemName ?? '';
            const quantity = line.Quantity ?? line.quantity ?? '';
            const unit = line.UnitName ?? line.unitName ?? '';
            const lot = line.LotNumber ?? line.lotNumber ?? '';
            const status = ready ? 'Đã khớp' : 'Cần chọn vật tư';
            const badgeClass = ready ? 'ready' : 'review';
            const lineWarnings = line.Warnings ?? line.warnings ?? [];
            return `
                <tr>
                    <td>${escapeDocumentText(code)}</td>
                    <td>${escapeDocumentText(name)}</td>
                    <td>${escapeDocumentText(quantity)}</td>
                    <td>${escapeDocumentText(unit)}</td>
                    <td>${escapeDocumentText(lot)}</td>
                    <td><span class="doc-status-badge ${badgeClass}">${status}</span>${lineWarnings.length ? `<div class="doc-preview-line-warning">${escapeDocumentText(lineWarnings[0])}</div>` : ''}</td>
                </tr>`;
        }).join('');

        const warningHtml = warnings.length
            ? `<div class="doc-preview-warning">
                    ${warnings.slice(0, 6).map(w => `<div>• ${escapeDocumentText(w)}</div>`).join('')}
                    ${warnings.length > 6 ? `<div>• Còn ${warnings.length - 6} cảnh báo khác...</div>` : ''}
               </div>`
            : '';

        return `
            <div class="doc-preview-body">
                ${headerRows}
                <div class="doc-preview-chip-row">
                    <span class="doc-preview-chip doc-preview-chip-status">Trạng thái: ${escapeDocumentText(parseStatus || 'Partial')}</span>
                    <span class="doc-preview-chip doc-preview-chip-ready">Đã khớp: ${readyLines.length}</span>
                    <span class="doc-preview-chip doc-preview-chip-review">Cần kiểm tra: ${reviewLines.length}</span>
                    <span class="doc-preview-chip doc-preview-chip-confidence">Độ tin cậy: ${Math.round((confidence || 0) * 100)}%</span>
                </div>
                <div class="doc-preview-table-wrap">
                    <table class="doc-preview-table">
                        <thead>
                            <tr>
                                <th>Mã</th>
                                <th>Tên vật tư</th>
                                <th>SL</th>
                                <th>ĐVT</th>
                                <th>Số lô</th>
                                <th>Kết quả</th>
                            </tr>
                        </thead>
                        <tbody>${lineRows || '<tr><td colspan="6" class="doc-preview-empty">Chưa có dòng nào đủ rõ để đề xuất.</td></tr>'}</tbody>
                    </table>
                </div>
                ${lines.length > visibleLines.length ? `<div class="doc-preview-more">Đang hiển thị ${visibleLines.length}/${lines.length} dòng đầu tiên.</div>` : ''}
                ${warningHtml}
                <div class="doc-preview-note">Hệ thống chỉ áp dụng header vào trường còn trống và các dòng đã khớp chắc chắn. Dòng còn cảnh báo cần chọn vật tư thủ công trên phiếu.</div>
            </div>`;
    }

    function buildDocumentReadErrorMessage(res, raw, status, fileName) {
        const baseMessage = res?.error || res?.title || raw || (`HTTP ${status}`);
        const guidance = res?.guidance || 'Bạn vẫn có thể nhập bằng Excel, quét mã vạch hoặc chọn vật tư thủ công trên phiếu. Nếu cần đọc tự động, vui lòng kiểm tra trạng thái dịch vụ đọc chứng từ và cấu hình provider dự phòng.';
        const prefix = fileName ? `${fileName}: ` : '';
        return `${prefix}${baseMessage}\n\n${guidance}`;
    }

    async function replaceAppliedOcrRowsIfNeeded() {
        const tbody = document.getElementById('linesContainer');
        const ocrRows = Array.from(tbody?.querySelectorAll('.line-row') || []).filter(row => {
            const documentNumber = row.querySelector('.ocr-document-number-input')?.value?.trim();
            const sourceLine = row.querySelector('.ocr-source-line-input')?.value?.trim();
            return !!documentNumber || !!sourceLine;
        });
        if (!ocrRows.length) return true;

        const decision = await Swal.fire({
            title: 'Thay chứng từ AI đang áp dụng?',
            html: '<div class="text-start">Phiếu đang có dòng lấy từ một chứng từ AI khác. Hệ thống sẽ <b>chỉ thay các dòng AI cũ</b> và vẫn giữ nguyên mọi dòng bạn nhập thủ công.</div>',
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Thay dòng AI cũ',
            cancelButtonText: 'Giữ phiếu hiện tại',
            confirmButtonColor: '#d94835',
            cancelButtonColor: '#64748b'
        });
        if (!decision.isConfirmed) return false;

        const allRows = Array.from(tbody.querySelectorAll('.line-row'));
        if (allRows.length === ocrRows.length) {
            addRow();
        }

        ocrRows.forEach(row => {
            if (typeof $ !== 'undefined') {
                $(row).find('.item-select, .source-uom-select').each(function() {
                    if ($(this).hasClass('select2-hidden-accessible')) {
                        $(this).select2('destroy');
                    }
                });
            }
            row.remove();
        });

        const remainingRows = tbody.querySelectorAll('.line-row');
        remainingRows.forEach((row, index) => {
            row.querySelectorAll('[name]').forEach(element => {
                element.name = element.name.replace(/\[\d+\]/, `[${index}]`);
            });
        });
        lineIdx = remainingRows.length;
        const ocrLogInput = document.getElementById('AiOcrLogId');
        if (ocrLogInput) ocrLogInput.value = '';
        if (typeof initSelect2 === 'function') initSelect2();
        refreshLineNumbers();
        return true;
    }

    function getPendingDocumentHeaders() {
        return window.wmsPendingDocumentHeaders || [];
    }

    function setPendingDocumentHeaders(headers) {
        window.wmsPendingDocumentHeaders = Array.isArray(headers) ? headers : [];
    }

    function isBlankValue(value) {
        return value === null || value === undefined || String(value).trim() === '';
    }

    function getInitialFieldValue(element) {
        if (!element) return '';
        if (element.dataset.wmsOcrInitialValue === undefined) {
            element.dataset.wmsOcrInitialValue = element.defaultValue ?? element.getAttribute('value') ?? '';
        }
        return element.dataset.wmsOcrInitialValue || '';
    }

    function canApplyDocumentValue(element) {
        if (!element) return false;
        const currentValue = element.value ?? '';
        if (isBlankValue(currentValue)) return true;
        return currentValue === getInitialFieldValue(element);
    }

    function setInputIfBlank(selector, value, overwrite = false) {
        const input = document.querySelector(selector);
        if (!input || isBlankValue(value) || (!overwrite && !canApplyDocumentValue(input))) return false;
        input.value = value;
        input.dispatchEvent(new Event('input', { bubbles: true }));
        input.dispatchEvent(new Event('change', { bubbles: true }));
        return true;
    }

    function setSelectIfBlank(selector, value, overwrite = false) {
        const select = document.querySelector(selector);
        if (!select || isBlankValue(value) || (!overwrite && !canApplyDocumentValue(select))) return false;
        const normalizedValue = String(value);
        const hasOption = Array.from(select.options).some(option => option.value === normalizedValue);
        if (!hasOption) return false;
        select.value = normalizedValue;
        if (typeof $ !== 'undefined' && $(select).hasClass('select2-hidden-accessible')) {
            $(select).val(normalizedValue).trigger('change.select2');
        }
        select.dispatchEvent(new Event('change', { bubbles: true }));
        return true;
    }

    function setOwnershipModeIfBlank(mode, ownerPartnerId, overwrite = false) {
        if (isBlankValue(mode) && isBlankValue(ownerPartnerId)) return false;
        const ownerSelect = document.querySelector('select[name="OwnerPartnerId"]');
        const currentMode = document.querySelector('input[name="InventoryOwnershipMode"]:checked')?.value || 'Internal';
        if (!overwrite && ((currentMode !== 'Internal' && currentMode !== '') || (ownerSelect && !isBlankValue(ownerSelect.value)))) return false;

        const normalizedMode = (String(mode || '').toLowerCase() === 'threepl' || !isBlankValue(ownerPartnerId)) ? 'ThreePl' : 'Internal';
        const radio = document.querySelector(`input[name="InventoryOwnershipMode"][value="${normalizedMode}"]`);
        if (!radio) return false;
        radio.checked = true;
        syncInventoryOwnershipMode();
        if (normalizedMode === 'ThreePl' && ownerPartnerId) {
            return setSelectIfBlank('select[name="OwnerPartnerId"]', ownerPartnerId, overwrite);
        }
        return true;
    }

    function analyzeHeaderApplyPlan(header) {
        if (!header) return { applyCount: 0, skipCount: 0 };
        const candidates = [
            { selector: 'input[name="ReferenceNo"]', value: header.ReferenceNo ?? header.referenceNo, type: 'input' },
            { selector: 'input[name="VoucherDate"]', value: normalizeInputDate(header.VoucherDate ?? header.voucherDate), type: 'input' },
            { selector: 'select[name="PartnerId"]', value: header.PartnerId ?? header.partnerId, type: 'select' },
            { selector: 'select[name="WarehouseId"], input[name="WarehouseId"]', value: header.WarehouseId ?? header.warehouseId, type: 'warehouse' },
            { selector: 'input[name="CarrierName"]', value: header.CarrierName ?? header.carrierName, type: 'input' },
            { selector: 'input[name="VehicleNumber"]', value: header.VehicleNumber ?? header.vehicleNumber, type: 'input' },
            { selector: 'input[name="DriverName"]', value: header.DriverName ?? header.driverName, type: 'input' },
            { selector: 'input[name="DriverPhone"]', value: header.DriverPhone ?? header.driverPhone, type: 'input' },
            { selector: 'input[name="DockDoor"]', value: header.DockDoor ?? header.dockDoor, type: 'input' },
            { selector: 'input[name="Description"]', value: header.Description ?? header.description, type: 'input' }
        ];
        let applyCount = 0;
        let skipCount = 0;
        for (const candidate of candidates) {
            if (isBlankValue(candidate.value)) continue;
            const element = document.querySelector(candidate.selector);
            if (!element) continue;
            if (candidate.type === 'select') {
                const hasOption = Array.from(element.options).some(option => option.value === String(candidate.value));
                if (canApplyDocumentValue(element) && hasOption) applyCount++;
                else skipCount++;
            } else if (candidate.type === 'warehouse') {
                if (element.tagName === 'SELECT') {
                    const hasOption = Array.from(element.options).some(option => option.value === String(candidate.value));
                    if (canApplyDocumentValue(element) && hasOption) applyCount++;
                    else skipCount++;
                } else if (isBlankValue(element.value) || String(element.value) === '0') {
                    applyCount++;
                } else {
                    skipCount++;
                }
            } else if (candidate.type === 'input-id') {
                if (isBlankValue(element.value) || String(element.value) === '0') applyCount++;
                else skipCount++;
            } else if (canApplyDocumentValue(element)) {
                applyCount++;
            } else {
                skipCount++;
            }
        }

        const ownerId = header.OwnerPartnerId ?? header.ownerPartnerId;
        const mode = header.InventoryOwnershipMode ?? header.inventoryOwnershipMode;
        if (!isBlankValue(mode) || !isBlankValue(ownerId)) {
            const ownerSelect = document.querySelector('select[name="OwnerPartnerId"]');
            const currentMode = document.querySelector('input[name="InventoryOwnershipMode"]:checked')?.value || 'Internal';
            const canApplyOwner = currentMode === 'Internal'
                && (!ownerSelect || isBlankValue(ownerSelect.value))
                && (isBlankValue(ownerId) || (ownerSelect && Array.from(ownerSelect.options).some(option => option.value === String(ownerId))));
            if (canApplyOwner) applyCount++;
            else skipCount++;
        }

        return { applyCount, skipCount };
    }

    function getElementDisplayValue(element) {
        if (!element) return '';
        if (element.tagName === 'SELECT') {
            const selected = element.options[element.selectedIndex];
            return selected?.textContent?.trim() || element.value || '';
        }
        return element.value || '';
    }

    function findDocumentHeaderConflicts(header) {
        if (!header) return [];
        const candidates = [
            { label: 'Số chứng từ gốc', selector: 'input[name="ReferenceNo"]', value: header.ReferenceNo ?? header.referenceNo },
            { label: 'Ngày chứng từ', selector: 'input[name="VoucherDate"]', value: normalizeInputDate(header.VoucherDate ?? header.voucherDate) },
            { label: isInboundVoucherJs ? 'Nhà cung cấp / nguồn giao' : 'Khách hàng / nơi nhận', selector: 'select[name="PartnerId"]', value: header.PartnerId ?? header.partnerId, isSelect: true },
            { label: isInboundVoucherJs ? 'Kho nhận' : 'Kho xuất', selector: 'select[name="WarehouseId"], input[name="WarehouseId"]', value: header.WarehouseId ?? header.warehouseId, isSelect: true },
            { label: 'Đơn vị vận chuyển', selector: 'input[name="CarrierName"]', value: header.CarrierName ?? header.carrierName },
            { label: 'Biển số xe', selector: 'input[name="VehicleNumber"]', value: header.VehicleNumber ?? header.vehicleNumber },
            { label: 'Tài xế', selector: 'input[name="DriverName"]', value: header.DriverName ?? header.driverName },
            { label: 'SĐT tài xế', selector: 'input[name="DriverPhone"]', value: header.DriverPhone ?? header.driverPhone },
            { label: 'Cửa nhận hàng ưu tiên', selector: 'input[name="DockDoor"]', value: header.DockDoor ?? header.dockDoor },
            { label: 'Diễn giải / ghi chú', selector: 'input[name="Description"]', value: header.Description ?? header.description }
        ];

        return candidates
            .map(candidate => {
                const element = document.querySelector(candidate.selector);
                if (!element || isBlankValue(candidate.value) || isBlankValue(element.value)) return null;
                if (String(element.value) === String(candidate.value)) return null;
                if (candidate.isSelect && element.tagName === 'SELECT'
                    && !Array.from(element.options).some(option => option.value === String(candidate.value))) return null;
                return {
                    label: candidate.label,
                    current: getElementDisplayValue(element),
                    ocr: candidate.value
                };
            })
            .filter(Boolean);
    }

    async function confirmDocumentHeaderConflictMode(header) {
        const conflicts = findDocumentHeaderConflicts(header);
        if (!conflicts.length) return false;
        const rows = conflicts.slice(0, 8).map(conflict => `
            <tr>
                <td>${escapeDocumentText(conflict.label)}</td>
                <td>${escapeDocumentText(conflict.current)}</td>
                <td>${escapeDocumentText(conflict.ocr)}</td>
            </tr>`).join('');
        const decision = await Swal.fire({
            title: 'Header OCR khác dữ liệu hiện tại',
            html: `
                <div class="doc-preview-body">
                    <div class="doc-preview-note">Form đang có dữ liệu khác với chứng từ vừa đọc. Chọn cách xử lý để tránh ghi đè ngoài ý muốn.</div>
                    <div class="doc-preview-table-wrap">
                        <table class="doc-preview-table">
                            <thead><tr><th>Trường</th><th>Hiện tại</th><th>OCR</th></tr></thead>
                            <tbody>${rows}</tbody>
                        </table>
                    </div>
                </div>`,
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Dùng dữ liệu OCR',
            cancelButtonText: 'Giữ dữ liệu hiện tại',
            confirmButtonColor: '#10b981',
            cancelButtonColor: '#64748b',
            width: 820
        });
        return decision.isConfirmed;
    }

    function applyDocumentHeaderToForm(header, options = {}) {
        if (!header) return { appliedCount: 0, skippedCount: 0 };
        const plan = analyzeHeaderApplyPlan(header);
        let appliedCount = 0;
        const overwrite = !!options.overwriteConflicts;
        if (setInputIfBlank('input[name="ReferenceNo"]', header.ReferenceNo ?? header.referenceNo, overwrite)) appliedCount++;
        if (setInputIfBlank('input[name="VoucherDate"]', normalizeInputDate(header.VoucherDate ?? header.voucherDate), overwrite)) appliedCount++;
        if (setSelectIfBlank('select[name="PartnerId"]', header.PartnerId ?? header.partnerId, overwrite)) appliedCount++;

        const warehouseId = header.WarehouseId ?? header.warehouseId;
        const warehouseField = document.querySelector('select[name="WarehouseId"], input[name="WarehouseId"]');
        if (warehouseField && !isBlankValue(warehouseId) && (overwrite || isBlankValue(warehouseField.value) || String(warehouseField.value) === '0')) {
            const normalizedWarehouseId = String(warehouseId);
            const hasWarehouseOption = warehouseField.tagName !== 'SELECT'
                || Array.from(warehouseField.options).some(option => option.value === normalizedWarehouseId);
            if (hasWarehouseOption) {
                warehouseField.value = normalizedWarehouseId;
                warehouseField.dispatchEvent(new Event('change', { bubbles: true }));
                appliedCount++;
            }
        }

        if (setOwnershipModeIfBlank(header.InventoryOwnershipMode ?? header.inventoryOwnershipMode, header.OwnerPartnerId ?? header.ownerPartnerId, overwrite)) appliedCount++;
        if (setInputIfBlank('input[name="CarrierName"]', header.CarrierName ?? header.carrierName, overwrite)) appliedCount++;
        if (setInputIfBlank('input[name="VehicleNumber"]', header.VehicleNumber ?? header.vehicleNumber, overwrite)) appliedCount++;
        if (setInputIfBlank('input[name="DriverName"]', header.DriverName ?? header.driverName, overwrite)) appliedCount++;
        if (setInputIfBlank('input[name="DriverPhone"]', header.DriverPhone ?? header.driverPhone, overwrite)) appliedCount++;
        if (setInputIfBlank('input[name="DockDoor"]', header.DockDoor ?? header.dockDoor, overwrite)) appliedCount++;
        if (setInputIfBlank('input[name="Description"]', header.Description ?? header.description, overwrite)) appliedCount++;
        return { appliedCount, skippedCount: Math.max(0, plan.applyCount + plan.skipCount - appliedCount) };
    }

    async function applyMappedItemsToLines(items) {
        if (!items || items.length === 0) return { newItemNames: [], matchedCount: 0 };

        // Destroy Select2 BEFORE processing to avoid DOM conflicts
        if (typeof $ !== 'undefined') {
            $('.item-select, .source-uom-select').each(function() {
                if ($(this).hasClass('select2-hidden-accessible')) {
                    $(this).select2('destroy');
                }
            });
        }

        const tbody = document.getElementById('linesContainer');
        let firstRow = tbody.querySelector('.line-row');
        let isFirstBlank = firstRow && firstRow.querySelector('.item-select').value === "";
        let newItemNames = [];
        let matchedCount = 0;

        items.forEach((item, index) => {
            let targetRow = null;
            if (index === 0 && isFirstBlank) {
                targetRow = firstRow;
            } else {
                const newRow = document.querySelector('.line-row').cloneNode(true);
                newRow.querySelectorAll('[name]').forEach(el => {
                    el.name = el.name.replace(/\[\d+\]/, `[${lineIdx}]`);
                    if (el.tagName === 'INPUT') {
                        if (el.className.includes('loc-input')
                            || el.className.includes('source-lot-input')
                            || el.className.includes('source-expiry-input')
                            || el.className.includes('fefo-override-reason-input')) el.value = '';
                        else if (el.className.includes('ocr-document-number-input') || el.className.includes('ocr-source-line-input')) el.value = '';
                        else if (el.type === 'hidden') { /* keep */ }
                        else el.value = '';
                    } else if (el.tagName === 'SELECT') {
                        if (el.className.includes('item-select')) el.value = '';
                        if (el.className.includes('source-uom-select')) el.value = '';
                        if (el.className.includes('loc-select') || el.className.includes('putaway-loc-select') || el.className.includes('dest-loc-select')) el.value = '';
                    }
                });
                const destUom = newRow.querySelector('.dest-uom-select');
                if (destUom) destUom.value = '';
                const destQty = newRow.querySelector('.dest-qty-input');
                if (destQty) destQty.value = '';
                const sourceNote = newRow.querySelector('.source-fefo-note');
                if (sourceNote) {
                    sourceNote.textContent = '';
                    sourceNote.classList.remove('is-override');
                }
                const sourceUomSelect = newRow.querySelector('.source-uom-select');
                if (sourceUomSelect) {
                    resetSourceUomOptions(sourceUomSelect);
                }
                newRow.querySelectorAll('.putaway-loc-select, .loc-select, .dest-loc-select').forEach(syncLocationSelectForWarehouse);
                tbody.appendChild(newRow);
                lineIdx++;
                targetRow = newRow;
            }

            const select = targetRow.querySelector('.item-select');
            const itemId = item.ItemId ?? item.itemId;
            const itemCode = item.ItemCode ?? item.itemCode ?? '';
            const itemName = item.ItemName ?? item.itemName ?? '';
            const baseUomId = item.BaseUomId ?? item.baseUomId ?? '';
            let matched = Array.from(select.options).find(o => o.value == itemId);
            if (!matched) {
                const newText = `[${itemCode}] ${itemName}`;
                document.querySelectorAll('.item-select').forEach(sel => {
                    const opt = new Option(newText, itemId);
                    opt.dataset.uom = baseUomId || '';
                    opt.dataset.cost = canSeeFinancialJs ? (item.UnitPrice ?? item.unitPrice ?? 0) : 0;
                    opt.dataset.trackLot = (item.TrackLot ?? item.trackLot) ? 'true' : 'false';
                    opt.dataset.trackExpiry = (item.TrackExpiry ?? item.trackExpiry) ? 'true' : 'false';
                    opt.dataset.trackSerial = (item.TrackSerial ?? item.trackSerial) ? 'true' : 'false';
                    sel.add(opt);
                });
            }

            syncItemSelect2(select, itemId);
            itemChanged(select);
            const transactionUomId = item.TransactionUomId ?? item.transactionUomId;
            if (transactionUomId) {
                const sourceUomSelect = targetRow.querySelector('.source-uom-select');
                if (sourceUomSelect && Array.from(sourceUomSelect.options).some(option => option.value == transactionUomId)) {
                    syncSourceUomSelect2(sourceUomSelect, transactionUomId);
                }
            }

            if (item.IsNew) newItemNames.push(`[${itemCode}] ${itemName}`);
            else matchedCount++;

            const qtyVal = (item.Quantity ?? item.quantity ?? 1);
            targetRow.querySelector('input[name$=".TransactionQty"]').value = formatWithCommas(qtyVal.toString());

            const unitPriceVal = canSeeFinancialJs ? (item.UnitPrice ?? item.unitPrice ?? 0) : 0;
            if (unitPriceVal) targetRow.querySelector('.cost-input').value = formatWithCommas(unitPriceVal.toString());

            if (item.LocationId) {
                const locSel = targetRow.querySelector('.loc-select, .putaway-loc-select, .loc-input');
                const validLocationId = locSel?.tagName === 'INPUT'
                    ? item.LocationId.toString()
                    : getValidLocationValueForWarehouse(locSel, item.LocationId);
                if (locSel && validLocationId) {
                    locSel.value = validLocationId;
                    locSel.dispatchEvent(new Event('change', { bubbles: true }));
                }
            }
            if (item.DefectQty != null) {
                const defectInput = targetRow.querySelector('input[name$=".DefectQty"]');
                if (defectInput) defectInput.value = formatWithCommas((item.DefectQty || 0).toString());
            }

            if (item.LotNumber != null || item.lotNumber != null) {
                const lotVal = (item.LotNumber ?? item.lotNumber ?? '').toString();
                const lotInput = targetRow.querySelector('input[name$=".LotNumber"]');
                if (lotInput) lotInput.value = lotVal;
            }

            const manufacturingDate = normalizeInputDate(item.ManufacturingDate ?? item.manufacturingDate);
            if (manufacturingDate) {
                const mfgInput = targetRow.querySelector('.mfg-date-input');
                if (mfgInput) mfgInput.value = manufacturingDate;
            }

            const expiryDate = normalizeInputDate(item.ExpiryDate ?? item.expiryDate);
            if (expiryDate) {
                const expInput = targetRow.querySelector('.exp-date-input, .source-expiry-input');
                if (expInput) expInput.value = expiryDate;
            }
            syncExpiryPolicyForRow(targetRow);

            const ocrDocumentNumber = getDocumentValue(item, 'OcrDocumentNumber', 'ocrDocumentNumber', 'DocumentNumber', 'documentNumber') || '';
            const ocrDocumentInput = targetRow.querySelector('.ocr-document-number-input');
            if (ocrDocumentInput) ocrDocumentInput.value = ocrDocumentNumber;
            const ocrSourceLine = getDocumentValue(item, 'OcrSourceLineNumber', 'ocrSourceLineNumber', 'LineNumber', 'lineNumber');
            const ocrSourceLineInput = targetRow.querySelector('.ocr-source-line-input');
            if (ocrSourceLineInput) ocrSourceLineInput.value = ocrSourceLine || '';
        });

        if (typeof initSelect2 === 'function') initSelect2();
        refreshLineNumbers();
        return { newItemNames, matchedCount };
    }

    function escapeExcelImportHtml(value) {
        return String(value ?? '')
            .replaceAll('&', '&amp;')
            .replaceAll('<', '&lt;')
            .replaceAll('>', '&gt;')
            .replaceAll('"', '&quot;')
            .replaceAll("'", '&#039;');
    }

    function readExcelImportProperty(source, camelName, pascalName) {
        return source?.[camelName] ?? source?.[pascalName];
    }

    function buildExcelImportErrorHtml(errors) {
        const visibleErrors = (errors || []).slice(0, 12);
        const rows = visibleErrors.map(error => {
            const row = readExcelImportProperty(error, 'row', 'Row');
            const column = readExcelImportProperty(error, 'column', 'Column');
            const message = readExcelImportProperty(error, 'message', 'Message');
            const remediation = readExcelImportProperty(error, 'remediation', 'Remediation');
            const position = row > 0 ? `Dòng ${row}, cột ${column}` : column;
            return `<tr>
                <td>${escapeExcelImportHtml(position)}</td>
                <td>${escapeExcelImportHtml(message)}</td>
                <td>${escapeExcelImportHtml(remediation)}</td>
            </tr>`;
        }).join('');
        const remaining = (errors?.length || 0) - visibleErrors.length;
        return `<div class="table-responsive">
            <table class="table table-sm">
                <thead><tr><th>Vị trí</th><th>Lỗi</th><th>Cách xử lý</th></tr></thead>
                <tbody>${rows}</tbody>
            </table>
            ${remaining > 0 ? `<div>Còn ${remaining} lỗi khác trong file.</div>` : ''}
        </div>`;
    }

    async function confirmExcelImportPreview(items, response) {
        const previewRows = items.slice(0, 8).map(item => {
            const code = readExcelImportProperty(item, 'itemCode', 'ItemCode');
            const name = readExcelImportProperty(item, 'itemName', 'ItemName');
            const quantity = readExcelImportProperty(item, 'quantity', 'Quantity');
            const lot = readExcelImportProperty(item, 'lotNumber', 'LotNumber') || '';
            const locationId = readExcelImportProperty(item, 'locationId', 'LocationId') || '';
            return `<tr>
                <td>${escapeExcelImportHtml(code)}</td>
                <td>${escapeExcelImportHtml(name)}</td>
                <td>${escapeExcelImportHtml(quantity)}</td>
                <td>${escapeExcelImportHtml(lot)}</td>
                <td>${escapeExcelImportHtml(locationId)}</td>
            </tr>`;
        }).join('');
        const warnings = readExcelImportProperty(response, 'warnings', 'Warnings') || [];
        const warningHtml = warnings.length
            ? `<div class="alert alert-warning text-start">${warnings.map(warning => escapeExcelImportHtml(warning)).join('<br>')}</div>`
            : '';
        const remaining = items.length - Math.min(items.length, 8);
        const html = `
            <div class="text-start">
                <p>Đã kiểm tra ${items.length} dòng. Dữ liệu chỉ được đưa vào phiếu sau khi bạn xác nhận.</p>
                ${warningHtml}
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead><tr><th>Mã</th><th>Tên vật tư</th><th>Số lượng</th><th>Lô</th><th>Vị trí</th></tr></thead>
                        <tbody>${previewRows}</tbody>
                    </table>
                </div>
                ${remaining > 0 ? `<div>Còn ${remaining} dòng không hiển thị trong bản xem nhanh.</div>` : ''}
            </div>`;

        if (typeof window.enterpriseConfirm === 'function') {
            return window.enterpriseConfirm({
                title: 'Kiểm tra dữ liệu Excel',
                html,
                text: `File có ${items.length} dòng hợp lệ. Áp dụng vào phiếu hiện tại?`,
                icon: 'question',
                confirmButtonText: `Áp dụng ${items.length} dòng`,
                cancelButtonText: 'Chưa áp dụng',
                confirmButtonColor: '#10b981',
                focusCancel: true
            });
        }

        const decision = await Swal.fire({
            title: 'Kiểm tra dữ liệu Excel',
            html,
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: `Áp dụng ${items.length} dòng`,
            cancelButtonText: 'Chưa áp dụng',
            confirmButtonColor: '#10b981',
            width: 980
        });
        return decision.isConfirmed;
    }

    document.getElementById('excelFileInput')?.addEventListener('change', async function() {
        const file = this.files?.[0];
        if (!file || excelImportInProgress) return;

        const warehouseId = getCurrentWarehouseId();
        if (!Number.isInteger(warehouseId) || warehouseId <= 0) {
            Swal.fire('Chưa chọn kho', 'Vui lòng chọn kho trước khi tải file Excel.', 'warning');
            this.value = '';
            return;
        }

        excelImportInProgress = true;
        const btn = document.getElementById('importExcelBtn');
        const busy = window.wmsLoading?.begin(btn, { text: 'Đang kiểm tra Excel...', delay: 700 });
        const formData = new FormData();
        formData.append('file', file);
        formData.append('warehouseId', warehouseId.toString());

        const ownerPartnerId = parseInt(document.querySelector('select[name="OwnerPartnerId"]')?.value || '0');
        if (ownerPartnerId > 0)
            formData.append('ownerPartnerId', ownerPartnerId.toString());

        const voucherType = document.querySelector('input[name="VoucherType"]')?.value;
        if (voucherType)
            formData.append('voucherType', voucherType);

        try {
            const token = document.querySelector('#voucherForm input[name="__RequestVerificationToken"]')?.value;
            const response = await fetch(importLinesExcelUrl, {
                method: 'POST',
                headers: token ? { 'RequestVerificationToken': token } : {},
                body: formData
            });

            const raw = await response.text();
            let result = null;
            try { result = raw ? JSON.parse(raw) : null; } catch (e) { result = null; }

            if (!response.ok) {
                const errors = readExcelImportProperty(result, 'errors', 'Errors');
                if (Array.isArray(errors) && errors.length > 0 && typeof Swal !== 'undefined') {
                    await Swal.fire({
                        title: 'File Excel chưa hợp lệ',
                        html: buildExcelImportErrorHtml(errors),
                        icon: 'error',
                        confirmButtonText: 'Đã hiểu',
                        width: 980
                    });
                } else {
                    Swal.fire(
                        'Lỗi nhập Excel',
                        readExcelImportProperty(result, 'error', 'Error') || readExcelImportProperty(result, 'title', 'Title') || raw || ('HTTP ' + response.status),
                        'error');
                }
                return;
            }

            if (!result) {
                Swal.fire('Lỗi nhập Excel', 'Máy chủ không trả về dữ liệu hợp lệ.', 'error');
                return;
            }

            let items = [];
            try { items = JSON.parse(readExcelImportProperty(result, 'data', 'Data')); } catch (e) { items = []; }
            if (!Array.isArray(items) || items.length === 0) {
                Swal.fire('Không có dữ liệu', 'File Excel không có dòng hợp lệ.', 'warning');
                return;
            }

            const fileHash = readExcelImportProperty(result, 'fileHashSha256', 'FileHashSha256')
                || `${file.name}:${file.size}:${file.lastModified}`;
            const fingerprint = `${fileHash}|${warehouseId}|${ownerPartnerId || 0}|${voucherType || ''}`;
            if (appliedExcelImportFingerprints.has(fingerprint)) {
                Swal.fire('File đã được áp dụng', 'Dữ liệu từ file này đã có trong phiếu hiện tại nên hệ thống không chèn lặp.', 'warning');
                return;
            }

            if (!await confirmExcelImportPreview(items, result))
                return;

            const summary = await applyMappedItemsToLines(items);
            appliedExcelImportFingerprints.add(fingerprint);
            const warnings = readExcelImportProperty(result, 'warnings', 'Warnings') || [];
            const warningText = warnings.length ? `<br><br>${warnings.map(warning => escapeExcelImportHtml(warning)).join('<br>')}` : '';
            await Swal.fire({
                title: 'Đã áp dụng dữ liệu Excel',
                html: `Đã đưa ${items.length} dòng vào phiếu để bạn kiểm tra trước khi lưu.<br>Khớp vật tư: ${summary.matchedCount}${warningText}`,
                icon: 'success',
                confirmButtonColor: '#10b981'
            });
        } catch (error) {
            Swal.fire('Lỗi nhập dữ liệu', 'Không thể kiểm tra file Excel lúc này. Vui lòng thử lại.', 'error');
        } finally {
            excelImportInProgress = false;
            window.wmsLoading?.end(busy);
            this.value = '';
        }
    });

    document.getElementById('documentFileInput')?.addEventListener('change', async function() {
        const files = Array.from(this.files || []);
        if (!files.length) return;

        const btn = document.getElementById('uploadDocumentBtn');
        const busy = window.wmsLoading?.begin(btn, { text: `Đang đọc ${files.length} chứng từ...`, delay: 700 });

        const token = document.querySelector('#voucherForm input[name="__RequestVerificationToken"]')?.value;
        setPendingDocumentHeaders([]);

        try {
            Swal.fire({
                title: 'Đang đọc chứng từ...',
                html: `Đang gửi ${files.length} file để hệ thống kiểm tra trùng và đọc dữ liệu...`,
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading()
            });

            const formData = new FormData();
            files.forEach(file => formData.append('files', file));
            const response = await fetch(analyzeReceiptsUrl, {
                method: 'POST',
                headers: token ? { 'RequestVerificationToken': token } : {},
                body: formData
            });
            const raw = await response.text();
            let res = null;
            try { res = raw ? JSON.parse(raw) : null; } catch (e) { res = null; }
            if (!response.ok) throw new Error(buildDocumentReadErrorMessage(res, raw, response.status));
            if (!res) throw new Error('Máy chủ không trả về dữ liệu đọc chứng từ hợp lệ.');

            Swal.close();

            const documents = Array.isArray(res.documents) ? res.documents : [];
            if (documents.length === 0) {
                const allWarnings = Array.isArray(res.warnings) ? res.warnings : [];
                const warningText = allWarnings.length ? `<br><br>${allWarnings.slice(0, 5).map(escapeDocumentText).join('<br>')}` : '';
                Swal.fire('Chưa có dòng đề xuất', `Không nhận diện được dòng vật tư đủ rõ từ chứng từ.${warningText}`, 'warning');
                return;
            }

            const selectableDocumentCount = documents.filter(canSelectDocument).length;
            const preview = await Swal.fire({
                title: 'Kết quả đọc chứng từ',
                html: buildDocumentBatchPreviewHtml(res),
                icon: documents.some(doc => getDocumentLines(doc).some(isReadyDocumentLine)) ? ((res.warnings || []).length ? 'warning' : 'info') : 'warning',
                width: 1080,
                customClass: { popup: 'doc-batch-swal-popup' },
                showCancelButton: documents.length > 0,
                showConfirmButton: selectableDocumentCount > 0,
                confirmButtonText: documents.length > 1 ? 'Áp dụng chứng từ đã chọn' : 'Áp dụng chứng từ',
                cancelButtonText: 'Kiểm tra lại',
                confirmButtonColor: '#10b981',
                cancelButtonColor: '#64748b',
                didOpen: () => {
                    document.querySelectorAll('[data-doc-card] input[type="radio"]').forEach(radio => {
                        radio.addEventListener('change', () => {
                            document.querySelectorAll('[data-doc-card]').forEach(card => card.classList.remove('selected'));
                            radio.closest('[data-doc-card]')?.classList.add('selected');
                        });
                    });
                },
                preConfirm: () => {
                    const selected = document.querySelector('input[name="wmsOcrDocumentChoice"]:checked');
                    if (!selected) {
                        Swal.showValidationMessage('Vui lòng chọn một chứng từ để áp dụng vào phiếu hiện tại.');
                        return false;
                    }
                    return Number(selected.value);
                }
            });

            if (!preview.isConfirmed) return;

            const selectedDocument = documents[Number(preview.value || 0)];
            if (!selectedDocument) return;
            const selectedHeader = getDocumentHeader(selectedDocument);
            const selectedReferenceNo = getDocumentReference(selectedDocument);
            const selectedSourceLogId = getDocumentValue(selectedDocument, 'SourceLogId', 'sourceLogId') || '';
            const readyItems = getDocumentLines(selectedDocument)
                .filter(isReadyDocumentLine)
                .map(item => ({
                    ...item,
                    OcrDocumentNumber: selectedReferenceNo,
                    DocumentNumber: selectedReferenceNo,
                    OcrSourceLineNumber: getDocumentValue(item, 'LineNumber', 'lineNumber')
                }));
            const mergedReadyItems = mergeReadyDocumentLines(readyItems);
            if (!mergedReadyItems.length) {
                Swal.fire('Chưa có dòng đủ điều kiện', 'Chứng từ đã chọn chưa có dòng vật tư khớp chắc chắn để áp dụng.', 'warning');
                return;
            }

            if (!await replaceAppliedOcrRowsIfNeeded()) return;

            const overwriteConflicts = await confirmDocumentHeaderConflictMode(selectedHeader);
            const headerPlan = analyzeHeaderApplyPlan(selectedHeader);
            setPendingDocumentHeaders([{
                fileName: selectedReferenceNo,
                header: selectedHeader,
                applyCount: headerPlan.applyCount,
                skipCount: headerPlan.skipCount
            }]);
            const headerResult = applyDocumentHeaderToForm(selectedHeader, { overwriteConflicts });
            const ocrLogInput = document.getElementById('AiOcrLogId');
            if (ocrLogInput) ocrLogInput.value = selectedSourceLogId;
            const summary = await applyMappedItemsToLines(mergedReadyItems);
            const selectedWarnings = getDocumentWarnings(selectedDocument);
            const msg = `Đã đọc ${files.length} file chứng từ.\nChứng từ đã áp dụng: ${selectedReferenceNo}\nHeader đã áp dụng: ${headerResult.appliedCount}\nHeader giữ nguyên/không khớp: ${headerResult.skippedCount}\nDòng gốc của chứng từ: ${getDocumentLines(selectedDocument).length}\nDòng đã áp dụng: ${mergedReadyItems.length}\nCần kiểm tra thủ công: ${getDocumentLines(selectedDocument).length - readyItems.length}\nKhớp vật tư: ${summary.matchedCount}${selectedWarnings.length ? `\nCảnh báo: ${selectedWarnings.length}` : ''}`;
            Swal.fire({
                title: 'Đã áp dụng dòng chứng từ',
                html: `<div class="swal-preline-body">${escapeDocumentText(msg)}</div>`,
                icon: 'success',
                confirmButtonColor: '#10b981'
            });
        } catch (e) {
            Swal.close();
            const message = e?.message || ('' + e);
            Swal.fire({
                title: 'Lỗi đọc chứng từ',
                html: `<div class="swal-preline-body">${escapeDocumentText(message)}</div>`,
                icon: 'error',
                confirmButtonText: 'Đã hiểu'
            });
        } finally {
            window.wmsLoading?.end(busy);
            this.value = '';
        }
    });

    // ================================================================
    // DIRECTED PUTAWAY — Frontend Integration
    // Gọi bộ gợi ý vị trí cất hàng và tự động điền vị trí phù hợp.
    // ================================================================
    function putawayStrategyLabel(value) {
        const key = String(value || '').trim().toLowerCase();
        const labels = {
            'item not found': 'Không tìm thấy vật tư',
            'no eligible location': 'Chưa có vị trí phù hợp',
            'available bin': 'Vị trí còn khả dụng',
            'consolidate same lot / expiry': 'Gom cùng lô hoặc hạn dùng',
            'consolidate same item': 'Gom cùng vật tư',
            'vị trí mặc định': 'Vị trí mặc định',
            'empty bin in default zone': 'Vị trí trống trong khu mặc định',
            'empty eligible bin': 'Vị trí trống phù hợp'
        };
        return labels[key] || value || 'Đề xuất cất hàng';
    }

    async function autoPutaway() {
        const rows = document.querySelectorAll('#linesContainer .line-row');
        const items = [];
        const warehouseId = getCurrentWarehouseId();
        const ownershipMode = document.querySelector('input[name="InventoryOwnershipMode"]:checked')?.value || 'Internal';
        const ownerPartnerId = ownershipMode === 'ThreePl'
            ? (parseInt(document.getElementById('OwnerPartnerId')?.value || '0', 10) || null)
            : null;
        const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        rows.forEach((row, idx) => {
            const itemSelect = row.querySelector('.item-select');
            const qtyInput = row.querySelector('input[name$=".TransactionQty"]');
            const lotInput = row.querySelector('input[name$=".LotNumber"]');
            const expiryInput = row.querySelector('input[name$=".ExpiryDate"]');
            if (itemSelect && itemSelect.value) {
                items.push({
                    itemId: parseInt(itemSelect.value),
                    rowIndex: idx,
                    warehouseId: warehouseId > 0 ? warehouseId : null,
                    ownerPartnerId: ownerPartnerId,
                    quantity: parseFloat(qtyInput?.value || '0') || null,
                    lotNumber: lotInput?.value?.trim() || null,
                    expiryDate: expiryInput?.value || null
                });
            }
        });

        if (items.length === 0) {
            Swal.fire('Chưa có vật tư', 'Vui lòng chọn ít nhất 1 vật tư trước khi chạy gợi ý vị trí cất hàng.', 'warning');
            return;
        }

        const busy = window.wmsLoading?.begin(
            document.getElementById('linesContainer') || document.getElementById('voucherForm'),
            { text: 'Đang gợi ý vị trí cất hàng...', delay: 700, disable: false }
        );

        try {
            const resp = await fetch(suggestPutawayUrl, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': antiForgeryToken
                },
                body: JSON.stringify(items)
            });
            const raw = await resp.text();
            let data = null;
            try {
                data = raw ? JSON.parse(raw) : null;
            } catch {
                data = null;
            }
            if (!resp.ok) {
                const serverMessage = data?.error || data?.title || raw || `HTTP ${resp.status}`;
                Swal.fire('Lỗi gợi ý vị trí', serverMessage, 'error');
                return;
            }
            if (!data) {
                Swal.fire('Lỗi xử lý', 'Máy chủ không trả về dữ liệu hợp lệ cho chức năng gợi ý vị trí cất hàng.', 'error');
                return;
            }

            if (!data.success) {
                Swal.fire('Lỗi gợi ý vị trí', data.error || 'Không thể phân bổ vị trí.', 'error');
                return;
            }

            // Apply suggestions to form with animation
            let assignedCount = 0;
            let strategies = [];
            let skippedSuggestions = [];
            const allRows = document.querySelectorAll('#linesContainer .line-row');

            for (const s of data.suggestions) {
                if (s.locationId && s.rowIndex < allRows.length) {
                    const row = allRows[s.rowIndex];
                    const locSelect = row.querySelector('.putaway-loc-select');
                    if (locSelect) {
                        const suggestedLocationId = getValidLocationValueForWarehouse(locSelect, s.locationId);
                        if (!suggestedLocationId) {
                            const itemText = row.querySelector('.item-select option:checked')?.textContent?.trim() || `Dòng ${s.rowIndex + 1}`;
                            const locationText = s.locationCode || s.locationId;
                            skippedSuggestions.push(`${escapeDocumentText(itemText)}: vị trí ${escapeDocumentText(locationText)} không thuộc kho đang chọn hoặc không còn hợp lệ trong danh sách.`);
                            continue;
                        }
                        // Destroy Select2 if active
                        if ($(locSelect).hasClass('select2-hidden-accessible')) {
                            $(locSelect).select2('destroy');
                        }
                        syncLocationSelectForWarehouse(locSelect);
                        locSelect.value = suggestedLocationId;
                        
                        // Visual feedback: highlight the cell
                        locSelect.style.transition = 'all 0.5s';
                        locSelect.style.background = 'rgba(99, 102, 241, 0.15)';
                        locSelect.style.borderColor = '#6366f1';
                        locSelect.style.fontWeight = '700';
                        setTimeout(() => {
                            locSelect.style.background = '';
                            locSelect.style.borderColor = '';
                        }, 3000);

                        assignedCount++;
                        const strategyLocation = escapeDocumentText(s.locationCode);
                        const strategyName = escapeDocumentText(putawayStrategyLabel(s.strategy));
                        const strategyReason = escapeDocumentText(s.reason || '');
                        strategies.push(
                            `<b>${strategyLocation}</b> <span class="putaway-strategy">← ${strategyName}</span>`
                            + `${strategyReason ? `<div class="putaway-reason">${strategyReason}</div>` : ''}`
                        );
                    }
                }
            }

            // Show result
            const emptyResultNote = assignedCount === 0
                ? '<div class="putaway-empty-note">Chưa tìm được vị trí phù hợp trong kho đang chọn. Vui lòng kiểm tra kho nhận, sức chứa hoặc vị trí mặc định của vật tư.</div>'
                : '';
            const skippedNote = skippedSuggestions.length
                ? `<div class="putaway-empty-note">${skippedSuggestions.map(x => `<div>${x}</div>`).join('')}</div>`
                : '';
            Swal.fire({
                title: assignedCount > 0
                    ? '<i class="fas fa-check-circle swal-title-success-icon"></i> Đã gợi ý vị trí cất hàng'
                    : '<i class="fas fa-exclamation-circle swal-title-warning-icon"></i> Chưa có vị trí phù hợp',
                html: `<div class="putaway-result-body">
                    <div class="putaway-summary">
                        <i class="fas fa-box-open"></i> Đã phân bổ ${assignedCount}/${items.length} vật tư vào vị trí tối ưu
                    </div>
                    ${strategies.map((s, i) => `<div class="putaway-line">${i+1}. ${s}</div>`).join('')}
                    ${skippedNote}
                    ${emptyResultNote}
                    <div class="putaway-algo-note">
                        <i class="fas fa-info-circle"></i> Thuật toán xếp hạng: cùng lô/cùng vật tư → vị trí mặc định còn sức chứa → ô trống cùng khu vực → ô trống khả dụng
                    </div>
                </div>`,
                icon: assignedCount > 0 ? null : 'warning',
                confirmButtonColor: '#6366f1',
                confirmButtonText: assignedCount > 0 ? 'Tuyệt vời!' : 'Đã hiểu'
            });

            if (typeof beepSuccess === 'function') beepSuccess();

        } catch (err) {
            Swal.fire('Lỗi kết nối', 'Không thể kết nối đến server: ' + err.message, 'error');
        } finally {
            window.wmsLoading?.end(busy);
        }
    }


</script>
