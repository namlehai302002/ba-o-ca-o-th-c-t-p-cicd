@model IReadOnlyList<WMS.ViewModels.SupplierInboundScorecardRow>
@{
    ViewData["Title"] = "Hiệu suất nhà cung cấp";
    var warehouses = (List<WMS.Models.Warehouse>)ViewBag.Warehouses;
    var days = (int)ViewBag.Days;
    var timelyCount = Model.Sum(row => row.OnTimeCount);
    var timelySamples = Model.Sum(row => row.OnTimeSampleCount);
    var qualityPassedCount = Model.Sum(row => row.QualityPassedCount);
    var qualitySamples = Model.Sum(row => row.QualitySampleCount);
}

@functions {
    private static string FormatPercent(decimal? value) =>
        value.HasValue ? $"{value.Value:N1}%" : "Chưa đủ dữ liệu";

    private static string FormatHours(decimal? value) =>
        value.HasValue ? $"{value.Value:N1} giờ" : "Chưa đủ dữ liệu";

    private static string DataQualityLabel(string code) => code switch
    {
        "DAMAGE_REASON_TAXONOMY_MISSING" => "Chưa có phân loại nguyên nhân hư hỏng",
        "APPOINTMENT_TIMESTAMP_MISSING" => "Thiếu mốc lịch nhận hàng",
        "QC_SAMPLE_MISSING" => "Chưa có mẫu kiểm phẩm",
        "DOCK_TO_STOCK_MILESTONE_MISSING" => "Thiếu mốc thời gian nhập kho",
        _ => "Cần kiểm tra nguồn dữ liệu"
    };

    private static string DataQualityBadge(string code) => code switch
    {
        "DAMAGE_REASON_TAXONOMY_MISSING" => "status-badge-warning",
        "APPOINTMENT_TIMESTAMP_MISSING" => "status-badge-warning",
        "QC_SAMPLE_MISSING" => "status-badge-secondary",
        "DOCK_TO_STOCK_MILESTONE_MISSING" => "status-badge-secondary",
        _ => "status-badge-secondary"
    };
}

<div class="page-header">
    <div>
        <h1 class="page-title">Hiệu suất nhà cung cấp</h1>
        <p class="page-subtitle">Đối chiếu đúng hẹn, giao đủ, kiểm phẩm, hồ sơ lô/HSD và thời gian nhập kho trong phạm vi dữ liệu người dùng được phép xem.</p>
    </div>
    <div class="page-actions">
        <a asp-controller="Reports" asp-action="Analytics" class="btn btn-secondary"><i class="fas fa-chart-line"></i> Phân tích vận hành</a>
        <a asp-controller="Reports" asp-action="DockToStock" class="btn btn-secondary"><i class="fas fa-stopwatch"></i> Thời gian nhập kho</a>
    </div>
</div>

<div class="user-guide">
    <div class="user-guide-title"><i class="fas fa-circle-info"></i> Phạm vi chỉ số</div>
    <p class="mb-2">Các chỉ số đúng hẹn, giao đủ, đạt kiểm phẩm và độ chính xác hồ sơ/lô/HSD chỉ tính trên phiếu có đủ mốc tương ứng. Giá trị trống được giữ là “Chưa đủ dữ liệu”, không quy đổi thành 0%.</p>
    <p class="mb-0"><strong>Không suy diễn hư hỏng:</strong> hệ thống hiện chỉ tổng hợp số lượng lỗi/thiếu đã ghi nhận. Tỷ lệ hư hỏng theo nguyên nhân chưa được chấm cho đến khi có danh mục nguyên nhân chuẩn.</p>
</div>

<form method="get" class="filter-bar">
    <div class="form-group">
        <label class="form-label">Kho</label>
        <select class="form-control" name="warehouseId">
            <option value="">Tất cả kho được phân quyền</option>
            @foreach (var warehouse in warehouses)
            {
                <option value="@warehouse.WarehouseId" selected="@(ViewBag.WarehouseId != null && (int)ViewBag.WarehouseId == warehouse.WarehouseId)">@warehouse.WarehouseCode - @warehouse.WarehouseName</option>
            }
        </select>
    </div>
    <div class="form-group">
        <label class="form-label">Khoảng thời gian</label>
        <select class="form-control" name="days">
            <option value="7" selected="@(days == 7)">7 ngày</option>
            <option value="30" selected="@(days == 30)">30 ngày</option>
            <option value="90" selected="@(days == 90)">90 ngày</option>
            <option value="180" selected="@(days == 180)">180 ngày</option>
            <option value="365" selected="@(days == 365)">365 ngày</option>
        </select>
    </div>
    <div class="form-group">
        <label class="form-label">&nbsp;</label>
        <button class="btn btn-primary" type="submit"><i class="fas fa-filter"></i> Cập nhật</button>
    </div>
</form>

<div class="stats-grid">
    <div class="stat-card info"><div class="stat-value">@ViewBag.SupplierCount</div><div class="stat-label">Nhà cung cấp</div></div>
    <div class="stat-card accent"><div class="stat-value">@ViewBag.VoucherCount</div><div class="stat-label">Phiếu nhập trong kỳ</div></div>
    <div class="stat-card success"><div class="stat-value">@FormatPercent(timelySamples > 0 ? timelyCount * 100m / timelySamples : null)</div><div class="stat-label">Đúng hẹn (@timelySamples mẫu)</div></div>
    <div class="stat-card purple"><div class="stat-value">@FormatPercent(qualitySamples > 0 ? qualityPassedCount * 100m / qualitySamples : null)</div><div class="stat-label">Đạt kiểm phẩm (@qualitySamples mẫu)</div></div>
</div>

@if (Model.Count == 0)
{
    <div class="table-container mt-3">
        <div class="empty-state">
            <div class="empty-icon"><i class="fas fa-truck-ramp-box"></i></div>
            <div class="empty-text">Chưa có dữ liệu nhà cung cấp</div>
            <div class="empty-sub">Không có phiếu nhập từ nhà cung cấp phù hợp với kho và khoảng thời gian đã chọn.</div>
        </div>
    </div>
}
else
{
    <div class="mobile-table-card-list">
        @foreach (var row in Model)
        {
            <article class="mobile-table-card">
                <div class="mobile-table-card-title">
                    <span>@row.PartnerName</span>
                    <span class="status-badge status-badge-info">@row.InboundVoucherCount phiếu</span>
                </div>
                <div class="mobile-table-card-row"><span class="mobile-table-card-label">Mã nhà cung cấp</span><span class="mobile-table-card-value td-code">@row.PartnerCode</span></div>
                <div class="mobile-table-card-row"><span class="mobile-table-card-label">Đúng hẹn</span><span class="mobile-table-card-value">@FormatPercent(row.OnTimePercent) (@row.OnTimeCount/@row.OnTimeSampleCount)</span></div>
                <div class="mobile-table-card-row"><span class="mobile-table-card-label">Giao đủ</span><span class="mobile-table-card-value">@FormatPercent(row.InFullPercent) (@row.InFullCount/@row.InFullSampleCount)</span></div>
                <div class="mobile-table-card-row"><span class="mobile-table-card-label">Đạt kiểm phẩm</span><span class="mobile-table-card-value">@FormatPercent(row.QualityPassPercent) (@row.QualityPassedCount/@row.QualitySampleCount)</span></div>
                <div class="mobile-table-card-row"><span class="mobile-table-card-label">Đúng hồ sơ/lô/HSD</span><span class="mobile-table-card-value">@FormatPercent(row.DocumentAccuracyPercent) (@row.DocumentAccurateCount/@row.DocumentSampleCount)</span></div>
                <div class="mobile-table-card-row"><span class="mobile-table-card-label">Thời gian nhập kho trung vị</span><span class="mobile-table-card-value">@FormatHours(row.MedianDockToStockHours) (@row.DockToStockSampleCount mẫu)</span></div>
                <div class="mobile-table-card-row"><span class="mobile-table-card-label">Điều chỉnh liên quan</span><span class="mobile-table-card-value">@row.AdjustmentTransactionCount giao dịch / @row.AdjustmentAbsoluteBaseQty.ToString("N2") ĐVT gốc</span></div>
                <div class="mobile-table-card-row"><span class="mobile-table-card-label">Dữ liệu cần bổ sung</span><span class="mobile-table-card-value">@string.Join("; ", row.DataQualityCodes.Select(DataQualityLabel))</span></div>
            </article>
        }
    </div>

    <div class="table-container mt-3 mobile-table-card-source">
        <div class="mobile-table-toolbar">
            <span class="mobile-table-toolbar-title"><i class="fas fa-truck-ramp-box"></i> Scorecard nhập hàng theo nhà cung cấp</span>
            <button class="btn-export" data-wms-export-table="supplierInboundScorecardTable" data-wms-export-filename="supplier_inbound_scorecard"><i class="fas fa-file-excel"></i> Xuất Excel</button>
        </div>
        <table id="supplierInboundScorecardTable">
            <thead>
                <tr>
                    <th>Nhà cung cấp</th>
                    <th class="cell-right">Phiếu</th>
                    <th class="cell-right">Đúng hẹn</th>
                    <th class="cell-right">Giao đủ</th>
                    <th class="cell-right">Đạt kiểm phẩm</th>
                    <th class="cell-right">Độ chính xác hồ sơ/lô/HSD</th>
                    <th class="cell-right">SL nhận</th>
                    <th class="cell-right">SL lỗi/thiếu</th>
                    <th class="cell-right">Trung vị nhập kho</th>
                    <th class="cell-right">Điều chỉnh</th>
                    <th>Dữ liệu cần bổ sung</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model)
                {
                    <tr>
                        <td><div class="fw-700">@row.PartnerName</div><div class="td-code fs-xs">@row.PartnerCode</div></td>
                        <td class="td-number">@row.InboundVoucherCount</td>
                        <td class="td-number"><div class="fw-700">@FormatPercent(row.OnTimePercent)</div><div class="text-muted fs-xs">@row.OnTimeCount/@row.OnTimeSampleCount mẫu</div></td>
                        <td class="td-number"><div class="fw-700">@FormatPercent(row.InFullPercent)</div><div class="text-muted fs-xs">@row.InFullCount/@row.InFullSampleCount mẫu</div></td>
                        <td class="td-number"><div class="fw-700">@FormatPercent(row.QualityPassPercent)</div><div class="text-muted fs-xs">@row.QualityPassedCount/@row.QualitySampleCount mẫu</div></td>
                        <td class="td-number"><div class="fw-700">@FormatPercent(row.DocumentAccuracyPercent)</div><div class="text-muted fs-xs">@row.DocumentAccurateCount/@row.DocumentSampleCount mẫu</div></td>
                        <td class="td-number">@row.ReceivedBaseQty.ToString("N2")</td>
                        <td class="td-number">@row.DefectOrShortBaseQty.ToString("N2")</td>
                        <td class="td-number"><div class="fw-700">@FormatHours(row.MedianDockToStockHours)</div><div class="text-muted fs-xs">@row.DockToStockSampleCount mẫu</div></td>
                        <td class="td-number"><div>@row.AdjustmentTransactionCount giao dịch</div><div class="text-muted fs-xs">@row.AdjustmentAbsoluteBaseQty.ToString("N2") ĐVT gốc</div></td>
                        <td>
                            @foreach (var code in row.DataQualityCodes)
                            {
                                <span class="status-badge @DataQualityBadge(code) mb-1">@DataQualityLabel(code)</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
