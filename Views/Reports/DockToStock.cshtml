@{
    ViewData["Title"] = "Thời gian nhập kho";
    var days = (int)ViewBag.Days;
    var rows = (IReadOnlyList<WMS.ViewModels.DockToStockRow>)ViewBag.Rows;
    var warehouses = (List<WMS.Models.Warehouse>)ViewBag.Warehouses;
    decimal? medianDockToReceive = ViewBag.MedianDockToReceive;
    decimal? medianReceiveToStock = ViewBag.MedianReceiveToStock;
    decimal? medianTotal = ViewBag.MedianTotal;
    decimal? p90Total = ViewBag.P90Total;
    decimal? p95Total = ViewBag.P95Total;
}

@functions {
    private static (string Label, string Badge) SlaMeta(string sla) => sla switch
    {
        "good" => ("Tốt", "badge-success"),
        "warning" => ("Cảnh báo", "badge-warning"),
        "critical" => ("Nghiêm trọng", "badge-danger"),
        _ => ("Thiếu dữ liệu", "badge-secondary")
    };

    private static string FormatTime(DateTime? value) =>
        value.HasValue ? value.Value.ToString("dd/MM HH:mm") : "Thiếu";

    private static string FormatHours(decimal? value) =>
        value.HasValue ? $"{value.Value:N1} h" : "Chưa có";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Thời gian nhập kho</h1>
        <p class="page-subtitle">Đo từ giờ xe đến thực tế đến khi nhập kho hoàn tất. Phiếu thiếu mốc vận hành được tách khỏi mẫu KPI để không tạo thời gian giả.</p>
    </div>
    <div class="page-actions">
        <a asp-controller="Reports" asp-action="Analytics" class="btn btn-secondary"><i class="fas fa-chart-line"></i> Phân tích vận hành</a>
        <a asp-controller="Reports" asp-action="SpaceUtilization" class="btn btn-secondary"><i class="fas fa-cubes"></i> Hiệu suất kho</a>
    </div>
</div>

<div class="user-guide">
    <div class="user-guide-title"><i class="fas fa-stopwatch"></i> Ngưỡng theo dõi thời gian nhập kho</div>
    <div class="step-list">
        <span class="step-chip step-chip-success"><i class="fas fa-check-circle"></i> Không quá 4 giờ: Tốt</span>
        <span class="step-chip step-chip-warning"><i class="fas fa-exclamation-triangle"></i> Trên 4 đến 8 giờ: Cảnh báo</span>
        <span class="step-chip step-chip-danger"><i class="fas fa-times-circle"></i> Trên 8 giờ: Nghiêm trọng</span>
    </div>
</div>

<form method="get" class="filter-bar">
    <div class="form-group">
        <label class="form-label">Kho</label>
        <select class="form-control" name="warehouseId">
            <option value="">Tất cả</option>
            @foreach (var warehouse in warehouses)
            {
                <option value="@warehouse.WarehouseId" selected="@(ViewBag.WarehouseId != null && (int)ViewBag.WarehouseId == warehouse.WarehouseId)">@warehouse.WarehouseCode - @warehouse.WarehouseName</option>
            }
        </select>
    </div>
    <div class="form-group">
        <label class="form-label">Khoảng thời gian</label>
        <select class="form-control" name="days">
            <option value="7" selected="@(days == 7)">7 ngày</option>
            <option value="14" selected="@(days == 14)">14 ngày</option>
            <option value="30" selected="@(days == 30)">30 ngày</option>
            <option value="60" selected="@(days == 60)">60 ngày</option>
            <option value="90" selected="@(days == 90)">90 ngày</option>
        </select>
    </div>
    <div class="form-group">
        <label class="form-label">&nbsp;</label>
        <button class="btn btn-primary" type="submit"><i class="fas fa-filter"></i> Lọc</button>
    </div>
</form>

<div class="stats-grid">
    <div class="stat-card info"><div class="stat-value">@FormatHours(medianDockToReceive)</div><div class="stat-label">Trung vị đến cửa - nhận</div></div>
    <div class="stat-card accent"><div class="stat-value">@FormatHours(medianReceiveToStock)</div><div class="stat-label">Trung vị nhận - nhập kho</div></div>
    <div class="stat-card purple"><div class="stat-value">@FormatHours(medianTotal)</div><div class="stat-label">Trung vị tổng thời gian</div></div>
    <div class="stat-card warning"><div class="stat-value">@FormatHours(p90Total)</div><div class="stat-label">P90 tổng thời gian</div></div>
    <div class="stat-card danger"><div class="stat-value">@FormatHours(p95Total)</div><div class="stat-label">P95 tổng thời gian</div></div>
    <div class="stat-card success"><div class="stat-value">@ViewBag.SampleCount</div><div class="stat-label">Phiếu đủ mốc để tính</div></div>
    <div class="stat-card accent"><div class="stat-value">@ViewBag.MissingMilestoneCount</div><div class="stat-label">Phiếu thiếu/sai mốc</div></div>
</div>

@if (rows.Count == 0)
{
    <div class="table-container mt-3">
        <div class="empty-state">
            <div class="empty-icon"><i class="fas fa-stopwatch"></i></div>
            <div class="empty-text">Không có dữ liệu thời gian nhập kho</div>
            <div class="empty-sub">Chưa có phiếu nhập đã ghi sổ trong khoảng thời gian đã chọn.</div>
        </div>
    </div>
}
else
{
    <div class="mobile-table-card-list">
        @foreach (var row in rows)
        {
            var meta = SlaMeta(row.Sla);
            <article class="mobile-table-card">
                <div class="mobile-table-card-title">
                    <a asp-controller="Vouchers" asp-action="Details" asp-route-id="@row.VoucherId" class="td-code link-clean">@row.VoucherCode</a>
                    <span class="badge @meta.Badge">@meta.Label</span>
                </div>
                <div class="mobile-table-card-row"><span class="mobile-table-card-label">Kho</span><span class="mobile-table-card-value">@row.WarehouseName</span></div>
                <div class="mobile-table-card-row"><span class="mobile-table-card-label">Đối tác</span><span class="mobile-table-card-value">@row.PartnerName</span></div>
                <div class="mobile-table-card-row"><span class="mobile-table-card-label">Đến cửa</span><span class="mobile-table-card-value">@FormatTime(row.DockArrival)</span></div>
                <div class="mobile-table-card-row"><span class="mobile-table-card-label">Bắt đầu nhận</span><span class="mobile-table-card-value">@FormatTime(row.ReceiveStart)</span></div>
                <div class="mobile-table-card-row"><span class="mobile-table-card-label">Hoàn tất</span><span class="mobile-table-card-value">@FormatTime(row.Completed)</span></div>
                <div class="mobile-table-card-row"><span class="mobile-table-card-label">Đến cửa - nhận</span><span class="mobile-table-card-value">@FormatHours(row.DockToReceiveHours)</span></div>
                <div class="mobile-table-card-row"><span class="mobile-table-card-label">Nhận - nhập kho</span><span class="mobile-table-card-value">@FormatHours(row.ReceiveToStockHours)</span></div>
                <div class="mobile-table-card-row"><span class="mobile-table-card-label">Tổng</span><span class="mobile-table-card-value">@FormatHours(row.TotalHours)</span></div>
                @if (!row.HasCompleteMilestones)
                {
                    <div class="mobile-table-card-row"><span class="mobile-table-card-label">Dữ liệu cần bổ sung</span><span class="mobile-table-card-value text-warning">@row.MissingMilestones</span></div>
                }
            </article>
        }
    </div>

    <div class="table-container mt-3 mobile-table-card-source">
        <div class="mobile-table-toolbar">
            <span class="mobile-table-toolbar-title"><i class="fas fa-clock-rotate-left"></i> Chi tiết thời gian nhận hàng</span>
            <button class="btn-export" data-wms-export-table="dockToStockTable" data-wms-export-filename="dock_to_stock"><i class="fas fa-file-excel"></i> Xuất Excel</button>
        </div>
        <table id="dockToStockTable">
            <thead>
                <tr>
                    <th class="sortable">Mã phiếu</th>
                    <th>Kho</th>
                    <th class="sortable">Đối tác</th>
                    <th class="sortable">Đến cửa</th>
                    <th class="sortable">Bắt đầu nhận</th>
                    <th class="sortable">Hoàn tất</th>
                    <th class="cell-right sortable">Đến cửa - nhận</th>
                    <th class="cell-right sortable">Nhận - nhập kho</th>
                    <th class="cell-right sortable">Tổng</th>
                    <th>Dữ liệu cần bổ sung</th>
                    <th class="cell-center">Mức độ</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in rows)
                {
                    var meta = SlaMeta(row.Sla);
                    <tr>
                        <td><a asp-controller="Vouchers" asp-action="Details" asp-route-id="@row.VoucherId" class="td-code link-clean fs-body-sm">@row.VoucherCode</a></td>
                        <td>@row.WarehouseName</td>
                        <td>@row.PartnerName</td>
                        <td class="fs-xs">@FormatTime(row.DockArrival)</td>
                        <td class="fs-xs">@FormatTime(row.ReceiveStart)</td>
                        <td class="fs-xs">@FormatTime(row.Completed)</td>
                        <td class="td-number">@FormatHours(row.DockToReceiveHours)</td>
                        <td class="td-number">@FormatHours(row.ReceiveToStockHours)</td>
                        <td class="td-number fw-700">@FormatHours(row.TotalHours)</td>
                        <td class="fs-xs">@(row.HasCompleteMilestones ? "—" : row.MissingMilestones)</td>
                        <td class="cell-center"><span class="badge @meta.Badge">@meta.Label</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
