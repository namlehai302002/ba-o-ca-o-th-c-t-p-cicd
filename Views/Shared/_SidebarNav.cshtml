@{
    var currentRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    var isAdmin = WmsRoles.IsAdmin(currentRole);
    var isManager = WmsRoles.IsManager(currentRole);
    var isViewer = WmsRoles.IsViewerOnly(currentRole);
    var isAdminOrManager = WmsRoles.IsAdminOrManager(currentRole);
    var canOperate = WmsRoles.IsWarehouseOperator(currentRole);
    var canInbound = WmsRoles.IsInbound(currentRole);
    var canOutbound = WmsRoles.IsOutbound(currentRole);
    var canInventory = WmsRoles.IsInventory(currentRole);
    var canTransport = WmsRoles.IsTransport(currentRole);
    var canSeeReports = WmsRoles.IsReportViewer(currentRole);
    var canSeeOperationalReports = isAdminOrManager || WmsRoles.IsReportingSpecialist(currentRole);
    var canReadInventory = canInventory || isViewer;
    var canSeeFinancialReports = isAdmin || User.Claims.Any(c => c.Type == "perm" && c.Value == "report.view.financial");
    var canManageYardBilling = isAdminOrManager;
    var canManageThreePlBilling = isAdmin || User.Claims.Any(c => c.Type == "perm" && c.Value == "billing.3pl.manage");
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
    var act = ViewContext.RouteData.Values["action"]?.ToString();
    var voucherTypeQuery = Context.Request.Query["type"].FirstOrDefault();
    var stockStatusQuery = Context.Request.Query["stockStatus"].FirstOrDefault();
    var navContextQuery = Context.Request.Query["nav"].FirstOrDefault();
    var mapContextQuery = Context.Request.Query["map"].FirstOrDefault();
    var isCreateInbound = ctrl == "Vouchers" && act == "Create"
        && (voucherTypeQuery == "1" || string.Equals(voucherTypeQuery, "NhapKho", StringComparison.OrdinalIgnoreCase));
    var isCreateOutbound = ctrl == "Vouchers" && act == "Create"
        && (voucherTypeQuery == "2" || string.Equals(voucherTypeQuery, "XuatKho", StringComparison.OrdinalIgnoreCase));
    var isCreateAdjustment = ctrl == "Vouchers" && act == "Create"
        && (voucherTypeQuery == "5" || string.Equals(voucherTypeQuery, "DieuChinh", StringComparison.OrdinalIgnoreCase));
    var isStockMovement = ctrl == "Reports" && act == "StockMovement";
    var isInboundStockMovement = isStockMovement && string.Equals(navContextQuery, "inbound", StringComparison.OrdinalIgnoreCase);
    var isInventoryStockMovement = isStockMovement && !isInboundStockMovement;
    var isLowStockItems = ctrl == "Items" && act == "Index" && string.Equals(stockStatusQuery, "low", StringComparison.OrdinalIgnoreCase);
    var isMasterItems = ctrl == "Items" && act == "Index" && string.IsNullOrWhiteSpace(stockStatusQuery);
    var isMasterLocationMap = ctrl == "Warehouses" && act == "InventoryMap" && string.Equals(mapContextQuery, "master", StringComparison.OrdinalIgnoreCase);
    var isInventoryMap = ctrl == "Warehouses" && act == "InventoryMap" && !isMasterLocationMap;
    var isInventoryReportView = ctrl == "Reports" && act == "Inventory" && string.Equals(navContextQuery, "report", StringComparison.OrdinalIgnoreCase);
    var isInventoryCurrentView = ctrl == "Reports" && act == "Inventory" && !isInventoryReportView;
    var isTransportShipping = ctrl == "Operations" && act == "Shipping" && string.Equals(navContextQuery, "transport", StringComparison.OrdinalIgnoreCase);
    var isOutboundShipping = ctrl == "Operations" && act == "Shipping" && !isTransportShipping;
    var layoutPendingInboundApprovals = (int)(ViewData["LayoutPendingInboundApprovals"] ?? 0);
    var sampleDataAction = "\u0044emoData";
}

