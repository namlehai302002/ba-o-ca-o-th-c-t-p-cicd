<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WMS Pro</title>
    <meta name="description" content="Hệ thống quản lý kho nguyên vật liệu và thành phẩm" />
    <meta name="theme-color" content="#C74634" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="WMS Pro" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="~/images/logo.svg" asp-append-version="true" />
    <link rel="alternate icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/images/pwa-icon-192.png" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/vendor/fontawesome/css/all.min.css" asp-append-version="true" />
    <script src="~/vendor/chartjs/chart.umd.js" asp-append-version="true"></script>
    <script src="~/vendor/sweetalert2/sweetalert2.all.min.js" asp-append-version="true"></script>
    <script>
        (function () {
            var enterpriseDialogSequence = 0;

            function asOptions(messageOrOptions, fallbackIcon) {
                if (messageOrOptions && typeof messageOrOptions === 'object') return messageOrOptions;
                return { text: String(messageOrOptions || ''), icon: fallbackIcon || 'info' };
            }

            function fallbackDialog(options, mode) {
                return new Promise(function (resolve) {
                    var previouslyFocused = document.activeElement;
                    var dialogId = 'enterpriseDialog' + (++enterpriseDialogSequence);
                    var titleId = dialogId + 'Title';
                    var textId = dialogId + 'Text';
                    var overlay = document.createElement('div');
                    overlay.className = 'enterprise-dialog-overlay';
                    var box = document.createElement('div');
                    box.className = 'enterprise-dialog-box';
                    box.setAttribute('role', 'dialog');
                    box.setAttribute('aria-modal', 'true');
                    box.setAttribute('aria-labelledby', titleId);
                    box.setAttribute('aria-describedby', textId);
                    box.setAttribute('tabindex', '-1');
                    var inputHtml = mode === 'prompt'
                        ? '<input data-enterprise-dialog-input class="enterprise-dialog-input" type="text" aria-label="' + escapeHtml(options.title || 'Nội dung cần nhập') + '" placeholder="' + escapeHtml(options.inputPlaceholder || '') + '" />'
                        : '';
                    box.innerHTML =
                        '<div class="enterprise-dialog-title" id="' + titleId + '">' + escapeHtml(options.title || 'Thông báo hệ thống') + '</div>' +
                        '<div class="enterprise-dialog-text" id="' + textId + '">' + escapeHtml(options.text || '') + '</div>' +
                        inputHtml +
                        '<div class="enterprise-dialog-actions">' +
                        (mode !== 'notify' ? '<button type="button" data-enterprise-dialog-cancel class="enterprise-dialog-cancel">' + escapeHtml(options.cancelButtonText || 'Hủy') + '</button>' : '') +
                        '<button type="button" data-enterprise-dialog-ok class="enterprise-dialog-confirm">' + escapeHtml(options.confirmButtonText || 'Đồng ý') + '</button>' +
                        '</div>';
                    overlay.appendChild(box);
                    document.body.appendChild(overlay);

                    function close(value) {
                        document.removeEventListener('keydown', handleKeydown, true);
                        overlay.remove();
                        if (previouslyFocused && typeof previouslyFocused.focus === 'function') {
                            previouslyFocused.focus();
                        }
                        resolve(value);
                    }

                    function handleKeydown(event) {
                        if (event.key === 'Escape') {
                            event.preventDefault();
                            close(mode === 'prompt' ? null : false);
                            return;
                        }
                        if (event.key !== 'Tab') return;
                        var focusable = Array.from(box.querySelectorAll('button:not([disabled]), input:not([disabled])'));
                        if (focusable.length === 0) {
                            event.preventDefault();
                            box.focus();
                            return;
                        }
                        var first = focusable[0];
                        var last = focusable[focusable.length - 1];
                        if (event.shiftKey && document.activeElement === first) {
                            event.preventDefault();
                            last.focus();
                        } else if (!event.shiftKey && document.activeElement === last) {
                            event.preventDefault();
                            first.focus();
                        }
                    }

                    overlay.querySelector('[data-enterprise-dialog-ok]').addEventListener('click', function () {
                        if (mode === 'prompt') {
                            close(overlay.querySelector('[data-enterprise-dialog-input]').value || null);
                            return;
                        }
                        close(true);
                    });
                    overlay.querySelector('[data-enterprise-dialog-cancel]')?.addEventListener('click', function () {
                        close(mode === 'prompt' ? null : false);
                    });
                    overlay.addEventListener('click', function (event) {
                        if (event.target === overlay) close(mode === 'prompt' ? null : false);
                    });
                    document.addEventListener('keydown', handleKeydown, true);
                    var initialFocus = mode === 'prompt'
                        ? overlay.querySelector('[data-enterprise-dialog-input]')
                        : (options.focusCancel !== false
                            ? overlay.querySelector('[data-enterprise-dialog-cancel]')
                            : overlay.querySelector('[data-enterprise-dialog-ok]'));
                    (initialFocus || box).focus();
                });
            }

            function escapeHtml(value) {
                var div = document.createElement('div');
                div.textContent = value == null ? '' : String(value);
                return div.innerHTML;
            }

            window.enterpriseNotify = function (messageOrOptions, icon) {
                var options = asOptions(messageOrOptions, icon || 'info');
                if (window.Swal) {
                    return Swal.fire({
                        toast: options.toast !== false,
                        position: options.position || 'top-end',
                        icon: options.icon || 'info',
                        title: options.title || options.text || 'Thông báo hệ thống',
                        text: options.title ? options.text : undefined,
                        customClass: {
                            popup: 'enterprise-toast-popup',
                            title: 'enterprise-toast-title'
                        },
                        showConfirmButton: options.showConfirmButton === true,
                        timer: options.timer || 3600,
                        timerProgressBar: true
                    });
                }
                return fallbackDialog(options, 'notify');
            };

            window.enterpriseConfirm = function (messageOrOptions) {
                var options = asOptions(messageOrOptions, 'question');
                if (window.Swal) {
                    return Swal.fire({
                        title: options.title || 'Xác nhận thao tác',
                        html: options.html,
                        text: options.html ? undefined : (options.text || ''),
                        icon: options.icon || 'question',
                        showCancelButton: true,
                        confirmButtonText: options.confirmButtonText || 'Xác nhận',
                        cancelButtonText: options.cancelButtonText || 'Hủy',
                        confirmButtonColor: options.confirmButtonColor || '#2563eb',
                        focusCancel: options.focusCancel !== false
                    }).then(function (result) { return !!result.isConfirmed; });
                }
                return fallbackDialog(options, 'confirm');
            };

            window.enterprisePrompt = function (messageOrOptions) {
                var options = asOptions(messageOrOptions, 'question');
                if (window.Swal) {
                    return Swal.fire({
                        title: options.title || 'Nhập thông tin',
                        text: options.text || '',
                        input: options.input || 'text',
                        inputPlaceholder: options.inputPlaceholder || '',
                        inputValue: options.inputValue || '',
                        icon: options.icon || 'question',
                        showCancelButton: true,
                        confirmButtonText: options.confirmButtonText || 'Tiếp tục',
                        cancelButtonText: options.cancelButtonText || 'Hủy',
                        inputValidator: options.inputValidator
                    }).then(function (result) { return result.isConfirmed ? (result.value || '') : null; });
                }
                return fallbackDialog(options, 'prompt');
            };

            window.alert = function (message) {
                window.enterpriseNotify({ title: 'Thông báo hệ thống', text: String(message || ''), icon: 'info' });
            };
            window.confirm = function (message) {
                window.enterpriseNotify({ title: 'Cần xác nhận chuẩn enterprise', text: String(message || ''), icon: 'warning' });
                return false;
            };
            window.prompt = function (message) {
                window.enterpriseNotify({ title: 'Cần biểu mẫu nhập liệu chuẩn enterprise', text: String(message || ''), icon: 'warning' });
                return null;
            };

            document.addEventListener('submit', function (event) {
                var form = event.target.closest('form[data-enterprise-confirm]');
                if (!form || form.dataset.enterpriseConfirmed === 'true') return;
                event.preventDefault();
                window.enterpriseConfirm({
                    title: form.dataset.enterpriseConfirmTitle || 'Xác nhận thao tác',
                    text: form.dataset.enterpriseConfirm,
                    icon: form.dataset.enterpriseConfirmIcon || 'question',
                    confirmButtonText: form.dataset.enterpriseConfirmOk || 'Xác nhận',
                    cancelButtonText: form.dataset.enterpriseConfirmCancel || 'Hủy'
                }).then(function (ok) {
                    if (!ok) return;
                    form.dataset.enterpriseConfirmed = 'true';
                    form.requestSubmit();
                    setTimeout(function () { delete form.dataset.enterpriseConfirmed; }, 0);
                });
            }, true);
        })();
    </script>
</head>
@{
    var layoutControllerName = ViewContext.RouteData.Values["controller"]?.ToString();
    var layoutActionName = ViewContext.RouteData.Values["action"]?.ToString();
    var layoutIsAccountPage = layoutControllerName == "Account" && layoutActionName != "TrustedDevices";
    var layoutRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    var layoutCanOperate = !layoutIsAccountPage && WmsRoles.IsWarehouseOperator(layoutRole);
    var layoutCanCreateInbound = !layoutIsAccountPage
        && WmsRoles.IsInbound(layoutRole)
        && (WmsRoles.IsAdmin(layoutRole)
            || User.Claims.Any(c => c.Type == WMS.Authorization.PermissionClaimTypes.Permission
                && c.Value == WMS.Models.WmsPermissions.VoucherCreate));
}
<body class="app-shell @(layoutIsAccountPage ? "account-shell" : "")" data-wms-operational="@(layoutCanOperate ? "true" : "false")">
    @if (!layoutIsAccountPage)
    {
        var isAdmin = WmsRoles.IsAdmin(layoutRole);
        var isManager = WmsRoles.IsManager(layoutRole);
        var isAdminOrManager = WmsRoles.IsAdminOrManager(layoutRole);
        var canOperate = WmsRoles.IsWarehouseOperator(layoutRole);
        var canInbound = WmsRoles.IsInbound(layoutRole);
        var canOutbound = WmsRoles.IsOutbound(layoutRole);
        var canInventory = WmsRoles.IsInventory(layoutRole);
        var canSeeFinancialReports = isAdmin || User.Claims.Any(c => c.Type == "perm" && c.Value == "report.view.financial");
        var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
        var act = ViewContext.RouteData.Values["action"]?.ToString();
        var showMobileQuickDock = ctrl == "Operations" && (
            (canOperate && act == "NextTask")
            || (canInbound && act == "RfReceiving")
            || (canOutbound && act == "RfPicking")
            || (canInventory && (act == "RfMovement" || act == "LpnLookup" || act == "SerialLookup" || act == "PackageLookup")));
        var voucherTypeQuery = Context.Request.Query["type"].FirstOrDefault();
        var isCreateInbound = ctrl == "Vouchers" && act == "Create" && voucherTypeQuery == "1";
        var isCreateOutbound = ctrl == "Vouchers" && act == "Create" && voucherTypeQuery == "2";
        var layoutTitle = !string.IsNullOrWhiteSpace(ViewData["Title"]?.ToString()) ? ViewData["Title"]?.ToString() : "WMS Pro";
        var userInitial = User.Identity?.Name?.Length >= 1 ? User.Identity.Name.Substring(0, 1).ToUpper() : "?";
        var userFullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "Người dùng";
        var roleClaimTopbar = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "User";
        var roleDisplayTopbar = WmsRoles.Label(roleClaimTopbar);
        var layoutScopedWarehouseId = (int?)null;
        if (!isAdmin && int.TryParse(User.FindFirst("WarehouseId")?.Value, out var layoutWarehouseClaim))
        {
            layoutScopedWarehouseId = layoutWarehouseClaim;
        }
        var layoutOwnerPartnerIds = User.FindAll(WMS.Models.TenantClaimTypes.OwnerPartnerId)
            .Select(c => int.TryParse(c.Value, out var ownerPartnerId) ? ownerPartnerId : 0)
            .Where(ownerPartnerId => ownerPartnerId > 0)
            .Distinct()
            .ToList();
        var layoutPendingInboundApprovals = 0;
        if (isAdminOrManager)
        {
            try
            {
                var layoutDb = (WMS.Data.AppDbContext)Context.RequestServices.GetService(typeof(WMS.Data.AppDbContext))!;
                var pendingInboundQuery = layoutDb.Vouchers.Where(v => !v.IsCancelled
                    && (v.VoucherType == WMS.Models.VoucherTypeEnum.NhapKho || v.VoucherType == WMS.Models.VoucherTypeEnum.KhachTra || v.VoucherType == WMS.Models.VoucherTypeEnum.NhapThanhPham)
                    && v.InboundStatus == WMS.Models.InboundStatusEnum.PendingApproval);
                if (layoutScopedWarehouseId.HasValue)
                {
                    pendingInboundQuery = pendingInboundQuery.Where(v => v.WarehouseId == layoutScopedWarehouseId.Value);
                }
                if (layoutOwnerPartnerIds.Count > 0)
                {
                    pendingInboundQuery = pendingInboundQuery.Where(v => v.OwnerPartnerId.HasValue && layoutOwnerPartnerIds.Contains(v.OwnerPartnerId.Value));
                }
                layoutPendingInboundApprovals = await Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions.CountAsync(pendingInboundQuery);
            }
            catch (Exception ex)
            {
                layoutPendingInboundApprovals = 0;
                var layoutLoggerFactory = (Microsoft.Extensions.Logging.ILoggerFactory?)Context.RequestServices.GetService(typeof(Microsoft.Extensions.Logging.ILoggerFactory));
                var layoutLogger = layoutLoggerFactory?.CreateLogger("WMS.Layout.PendingInboundApprovals");
                if (layoutLogger != null)
                {
                    Microsoft.Extensions.Logging.LoggerExtensions.LogWarning(layoutLogger, ex, "Không tải được số phiếu nhập chờ duyệt cho topbar. Tiếp tục render trang với badge bằng 0.");
                }
            }
        }

        <header class="app-topbar" id="appTopbar">
            <div class="topbar-left">
                <button id="sidebarToggle" class="topbar-icon-btn" type="button" aria-label="Mở hoặc thu gọn menu">
                    <i class="fas fa-bars"></i>
                </button>
                <a class="topbar-brand" asp-controller="Home" asp-action="Index" aria-label="WMS Pro">
                    <img src="~/images/logo.svg" asp-append-version="true" alt="WMS Pro" class="topbar-brand-mark" />
                </a>
                <div class="topbar-screen-title">@layoutTitle</div>
            </div>
            <div class="topbar-search">
                <button class="topbar-search-trigger" type="button" data-wms-call="openQuickSearch" title="Tìm kiếm nhanh (Ctrl+K)">
                    <i class="fas fa-search"></i>
                    <span>Tìm mã phiếu, vật tư, mã vạch...</span>
                    <kbd>Ctrl+K</kbd>
                </button>
            </div>
            <div class="topbar-right">
                <button class="topbar-icon-btn" type="button" title="Màn hình yêu thích" data-wms-notify-title="Màn hình yêu thích" data-wms-notify-text="Các lối vào thường dùng đã được gom tại trang chính." data-wms-notify-icon="info">
                    <i class="fas fa-star"></i>
                </button>
                @if (isAdmin)
                {
                    <a class="topbar-icon-btn" asp-controller="Reports" asp-action="Alerts" title="Cảnh báo vận hành">
                        <i class="fas fa-bell"></i>
                    </a>
                }
                <a class="topbar-icon-btn" asp-controller="Help" asp-action="Index" title="Trợ giúp">
                    <i class="fas fa-circle-question"></i>
                </a>
                <div class="warehouse-context" title="Kho đang thao tác">
                    <i class="fas fa-warehouse"></i>
                    <span>Kho vận hành</span>
                </div>
                <details class="topbar-user">
                    <summary>
                        <span class="topbar-avatar">@userInitial</span>
                        <span class="topbar-user-text">
                            <strong>@userFullName</strong>
                            <small>@roleDisplayTopbar</small>
                        </span>
                        <i class="fas fa-chevron-down"></i>
                    </summary>
                    <div class="topbar-user-menu">
                        <a asp-controller="Account" asp-action="TrustedDevices"><i class="fas fa-shield-halved"></i> Thiết bị tin cậy</a>
                        <a asp-controller="Help" asp-action="Index"><i class="fas fa-book-open"></i> Hướng dẫn sử dụng</a>
                        <form method="post" asp-controller="Account" asp-action="Logout">
                            @Html.AntiForgeryToken()
                            <button type="submit"><i class="fas fa-sign-out-alt"></i> Đăng xuất</button>
                        </form>
                    </div>
                </details>
            </div>
        </header>

        <aside class="sidebar app-sidebar" id="sidebar">
            <a class="sidebar-brand" asp-controller="Home" asp-action="Index">
                <div class="brand-icon"><img src="~/images/logo.svg" asp-append-version="true" alt="Biểu trưng" /></div>
                <div class="brand-text">
                    <span class="brand-name">WMS Pro</span>
                    <span class="brand-sub">Nội bộ nhân viên kho</span>
                </div>
            </a>
            <div class="sidebar-tools">
                <button type="button" class="sidebar-pin-btn" id="sidebarPinToggle" title="Ghim hoặc thu gọn menu">
                    <i class="fas fa-thumbtack"></i>
                    <span>Ghim menu</span>
                </button>
                <label class="sidebar-search" for="sidebarSearchInput">
                    <i class="fas fa-search"></i>
                    <input id="sidebarSearchInput" type="search" autocomplete="off" placeholder="Tìm chức năng..." />
                </label>
            </div>
            @{ ViewData["LayoutPendingInboundApprovals"] = layoutPendingInboundApprovals; }
            <partial name="_SidebarNav" />
            <div class="sidebar-footer">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="user-info">
                        <div class="user-avatar">@(User.Identity.Name?.Length >= 1 ? User.Identity.Name.Substring(0, 1).ToUpper() : "?")</div>
                        <div class="user-details">
                            <div class="user-name">@(User.FindFirst("FullName")?.Value ?? User.Identity.Name)</div>
                            @{
                                var roleClaim = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "User";
                                var roleDisplay = WmsRoles.Label(roleClaim);
                            }
                            <div class="user-role">@roleDisplay</div>
                        </div>
                        <form method="post" asp-controller="Account" asp-action="Logout" class="sidebar-logout-form">
                            @Html.AntiForgeryToken()
                            <button type="submit" title="Đăng xuất" class="sidebar-logout-btn">
                                <i class="fas fa-sign-out-alt"></i>
                            </button>
                        </form>
                    </div>
                    <div class="sidebar-security-note">
                        <i class="fas fa-shield-check text-success"></i> Được bảo vệ bởi lớp bảo mật hệ thống kho
                    </div>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary sidebar-login-btn">
                        <i class="fas fa-sign-in-alt"></i> Đăng nhập
                    </a>
                }
            </div>
        </aside>
        <div class="sidebar-overlay" id="sidebarOverlay"></div>

        @* ═══ QUICK SEARCH OVERLAY (Cmd+K) ═══ *@
        <div class="qs-overlay" id="qsOverlay" aria-hidden="true">
            <div class="qs-modal" role="dialog" aria-modal="true" aria-label="Tìm kiếm nhanh">
                <div class="qs-header">
                    <i class="fas fa-search qs-icon" aria-hidden="true"></i>
                    <input type="text" id="qsInput" class="qs-input" aria-label="Tìm mã phiếu, vật tư hoặc mã vạch" placeholder="Tìm mã phiếu, vật tư, mã vạch... (Esc để đóng)" autocomplete="off" />
                    <kbd class="qs-kbd">ESC</kbd>
                </div>
                <div class="qs-results" id="qsResults">
                    <div class="qs-empty"><i class="fas fa-lightbulb"></i> Gõ để tìm kiếm nhanh. Dùng <kbd>Ctrl+K</kbd> để mở bất cứ lúc nào.</div>
                </div>
            </div>
        </div>

        <main class="main-content">
            <div class="content-shell">
            <div class="workspace-toolbar app-page-context">
                <div class="workspace-context">
                @* ═══ BREADCRUMB ═══ *@
                <nav class="breadcrumb" id="breadcrumb">
