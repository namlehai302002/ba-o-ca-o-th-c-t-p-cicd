                            {"Waves","Đợt gom đơn"},{"PickTasks","Nhiệm vụ lấy hàng"},{"Shipping","Đóng gói & giao hàng"},{"ShippingDispatch","Điều phối vận chuyển"},{"DeliveryReconciliation","Đối soát giao hàng"},{"CarrierConnectors","Bộ kết nối vận tải"},{"ShipmentLoads","Bảng chuyến xe"},{"ShipmentLoadDetails","Chi tiết chuyến xe"},
