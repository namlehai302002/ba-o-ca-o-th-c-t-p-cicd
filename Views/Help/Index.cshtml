    bool CanSeeHelpSection(string key)
    {
        if (isAdmin) return true;
        if (isManager) return !adminOnlyHelpSections.Contains(key);
        if (isLegacyStaff) return staffHelpSections.Contains(key);
        if (isInboundStaff) return inboundHelpSections.Contains(key);
        if (isOutboundStaff) return outboundHelpSections.Contains(key);
        if (isInventoryStaff) return inventoryHelpSections.Contains(key);
        if (isTransportStaff) return transportHelpSections.Contains(key);
        if (isReportViewer) return reportingHelpSections.Contains(key);
        return viewerHelpSections.Contains(key);
    }

    string RoleScopeText(string key)
    {
        if (isAdmin)
            return "Bạn đang ở quyền quản trị: xem toàn bộ hướng dẫn, cấu hình người dùng, phân quyền, danh mục và các luồng vận hành trọng yếu.";
        if (isManager)
        {
            if (adminOnlyHelpSections.Contains(key))
                return "Mục này chỉ dành cho quản trị viên hệ thống.";
            return "Bạn đang ở quyền quản lý kho: xem và xử lý các luồng vận hành, duyệt nghiệp vụ, theo dõi báo cáo, ngoại lệ và cấu hình vận hành được phân quyền.";
        }
        if (isReportViewer || isViewer)
            return $"Bạn đang ở quyền {currentRoleName}: chỉ đọc dữ liệu theo kho/chủ hàng được gán; không thực hiện thao tác làm đổi tồn kho.";
        if (isWarehouseOperator)
            return $"Bạn đang ở quyền {currentRoleName}: {currentRoleDescription} Chỉ thao tác trong kho, khu vực và chủ hàng được gán.";
        return $"Vai trò hiện tại là {currentRoleName}. Chỉ sử dụng các màn và hành động được hệ thống hiển thị theo quyền đã cấp.";
    }

    var quickLinks = new List<(string Title, string Url, string Icon)>
    {
        ("Trang chính", Url.Action("Index", "Home") ?? "#", "fa-chart-pie")
    };
